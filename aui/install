#AUR HELPER {{{
install_aur_helper() {
  print_title "AUR HELPER"
  print_info "Instalando paru en Phase 1 para que setup/post-install puedan usar AUR si hace falta."

  local opts=("paru (recomendado)" "Skip")
  PS3="$prompt1"
  select OPT in "${opts[@]}"; do
    case "$OPT" in
      "paru (recomendado)") AUR_HELPER="paru"; break ;;
      "Skip") AUR_HELPER=""; return ;;
      *) invalid_option ;;
    esac
  done

  arch_chroot "pacman -S --needed --noconfirm base-devel git sudo"

  arch_chroot "id -u aurbuild >/dev/null 2>&1 || useradd -m -s /bin/bash aurbuild"
  mkdir -p "${MOUNTPOINT}"/etc/sudoers.d
  cat > "${MOUNTPOINT}"/etc/sudoers.d/90-aurbuild <<'EOF'
aurbuild ALL=(ALL) NOPASSWD: /usr/bin/pacman
EOF
  chmod 0440 "${MOUNTPOINT}"/etc/sudoers.d/90-aurbuild

  arch_chroot "sudo -u aurbuild bash -lc 'set -e; cd /tmp; rm -rf paru; git clone https://aur.archlinux.org/paru.git; cd paru; makepkg -si --noconfirm'"
  local ret=$?

  rm -f "${MOUNTPOINT}"/etc/sudoers.d/90-aurbuild
  arch_chroot "userdel -r aurbuild >/dev/null 2>&1 || true"

  [[ $ret -ne 0 ]] && error_msg "Installing paru failed. Check network/AUR/build output above."
  print_success "paru instalado en el sistema nuevo."
  pause_function
}
#}}}
#SAFETY NET DEL INSTALL {{{
# Red de seguridad pre-reboot: backup header LUKS, snapshot /etc, RECOVERY.md.
# NO es hardening de seguridad (eso lo hace aui-fortress por separado).
# Es la red para que el primer boot sea recuperable si algo va mal.
safety_net() {
  print_title "RED DE SEGURIDAD DEL INSTALL"
  print_info "Generando red de seguridad pre-reboot: header LUKS, baseline de /etc, RECOVERY.md."

  mkdir -p "${MOUNTPOINT}"/var/lib/aui-x
  mkdir -p "${MOUNTPOINT}"/root

  local hostname_val backup_path luks_dev
  hostname_val=$(cat "${MOUNTPOINT}"/etc/hostname 2>/dev/null || echo "arch")

  # Backup LUKS header (staging temporal en /root del sistema nuevo)
  if [[ $LUKS -eq 1 ]] && [[ -n "$LUKS_DISK" ]]; then
    luks_dev="/dev/${LUKS_DISK}"
    backup_path="${MOUNTPOINT}/root/luks-header-${hostname_val}.bin"
    print_info "Backup del header LUKS de ${luks_dev}"
    if cryptsetup luksHeaderBackup "$luks_dev" --header-backup-file "$backup_path"; then
      chmod 400 "$backup_path"
      print_success "Header LUKS staged en /root/luks-header-${hostname_val}.bin"
      print_danger "ADVERTENCIA: este archivo NO sirve si el disco muere."
      print_danger "Muévelo HOY a dos medios externos cifrados distintos y bórralo de /root tras verificar checksums."
    else
      print_warning "luksHeaderBackup falló; revisa manualmente tras reboot."
    fi
  else
    print_info "LUKS no detectado; saltando backup de header."
  fi

  # Snapshot baseline de /etc (referencia para comparación post-corrupción)
  print_info "Generando baseline de /etc..."
  arch_chroot "tar --zstd -cf /var/lib/aui-x/etc-baseline.tar.zst -C / etc 2>/dev/null" || \
    print_warning "Snapshot de /etc falló (no fatal)."

  # RECOVERY.md con procedimientos
  cat > "${MOUNTPOINT}"/root/RECOVERY.md <<'RECOVERY_EOF'
# Recovery — aui-x base install

## Si el sistema no bootea con kernel-zen

En el menú del bootloader selecciona la entrada `linux-lts`. Es el kernel de fallback
instalado SIEMPRE como red de seguridad.

## Si aui-fortress está instalado y bloquea el boot

1. Boot desde live USB de Arch.
2. Desbloquea LUKS con la passphrase del slot 0 (siempre intacta):
       cryptsetup open /dev/<device> cryptroot
3. Monta el sistema:
       mount /dev/mapper/cryptroot /mnt && arch-chroot /mnt
4. Desactiva fortress:
       aui-fortress rollback --all
5. Reboot.

## Si pierdes el token FIDO2 o el USB de presence

Usa la passphrase del slot 0 (la que pusiste durante el install). Está SIEMPRE en slot 0;
ninguna operación de fortress la toca.

## Si pierdes la passphrase del slot 0

Necesitas el backup del header LUKS (luks-header-<hostname>.bin) que generó este install:

    cryptsetup luksHeaderRestore /dev/<device> --header-backup-file luks-header-<hostname>.bin

Luego usa la passphrase original de cuando se creó el header.

Si NO tienes el backup del header → datos perdidos. Por eso debe vivir en dos USB cifrados
externos, no en /root.

## Comandos útiles

- journalctl -b                                 logs del último boot
- bootctl list                                  entradas del bootloader systemd-boot
- cryptsetup luksDump /dev/<device>             estado de slots LUKS
- lsblk -f                                      filesystems y UUIDs
- ls /var/lib/aui-x/etc-baseline.tar.zst        snapshot de /etc al terminar el install
RECOVERY_EOF
  chmod 600 "${MOUNTPOINT}"/root/RECOVERY.md

  # Verificación de los items
  print_info "Checklist de red de seguridad:"
  printf "  %-30s %s\n" "linux-lts instalado:" \
    "$(arch_chroot 'pacman -Q linux-lts' >/dev/null 2>&1 && echo YES || echo NO)"
  printf "  %-30s %s\n" "LUKS header staged:" \
    "$([[ -n "$backup_path" && -f "$backup_path" ]] && echo YES || echo SKIP)"
  printf "  %-30s %s\n" "/etc baseline:" \
    "$([[ -f "${MOUNTPOINT}/var/lib/aui-x/etc-baseline.tar.zst" ]] && echo YES || echo NO)"
  printf "  %-30s %s\n" "RECOVERY.md:" \
    "$([[ -f "${MOUNTPOINT}/root/RECOVERY.md" ]] && echo YES || echo NO)"
}
#}}}
#FINISH {{{
finish() {
  print_title "INSTALL COMPLETED"

  # Red de seguridad antes del reboot final (no es hardening; es recuperabilidad)
  safety_net

  # Copy del repo al sistema nuevo (referencia + setup post-boot)
  print_warning "\nA copy of this repository will be placed in /root/aui-x on your new system"
  mkdir -p "${MOUNTPOINT}"/root/aui-x
  cp -a "${PROJECT_ROOT}/." "${MOUNTPOINT}"/root/aui-x/
  print_warning "Si estás en VirtualBox/VM, desmonta la ISO o pon el disco instalado primero en el orden de boot antes de reiniciar."
  read_input_text "Reboot system"
  if [[ $OPTION == y ]]; then
    umount_partitions
    reboot
  fi
  exit 0
}
#}}}

