#DEFAULT EDITOR {{{
select_editor() {
  print_title "DEFAULT EDITOR"
  editors_list=("emacs" "nano" "vi" "vim" "neovim" "zile")
  PS3="$prompt1"
  echo -e "Select editor\n"
  select EDITOR in "${editors_list[@]}"; do
    if contains_element "$EDITOR" "${editors_list[@]}"; then
      package_install "$EDITOR"
      break
    else
      invalid_option
    fi
  done
}
#}}}
#MIRRORLIST {{{
configure_mirrorlist() {
  local countries_code=("AU" "AT" "BD" "BY" "BE" "BA" "BR" "BG" "CA" "CL" "CN" "CO" "HR" "CZ" "DK" "EC" "FI" "FR" "GE" "DE" "GR" "HK" "HU" "IS" "IN" "ID" "IR" "IE" "IL" "IT" "JP" "KZ" "KE" "LV" "LT" "LU" "NL" "NC" "NZ" "MK" "NO" "PY" "PH" "PL" "PT" "RO" "RU" "RS" "SG" "SK" "SI" "ZA" "KR" "ES" "SE" "CH" "TW" "TH" "TR" "UA" "GB" "US" "VN")
  local countries_name=("Australia" "Austria" "Bangladesh" "Belarus" "Belgium" "Bosnia and Herzegovina" "Brazil" "Bulgaria" "Canada" "Chile" "China" "Colombia" "Croatia" "Czech Republic" "Denmark" "Ecuador" "Finland" "France" "Georgia" "Germany" "Greece" "Hong Kong" "Hungary" "Iceland" "India" "Indonesia" "Iran" "Ireland" "Israel" "Italy" "Japan" "Kazakhstan" "Kenya" "Latvia" "Lithuania" "Luxembourg" "Netherlands" "New Caledonia" "New Zealand" "North Macedonia" "Norway" "Paraguay" "Philippines" "Poland" "Portugal" "Romania" "Russia" "Serbia" "Singapore" "Slovakia" "Slovenia" "South Africa" "South Korea" "Spain" "Sweden" "Switzerland" "Taiwan" "Thailand" "Turkey" "Ukraine" "United Kingdom" "United States" "Viet Nam")
  country_list() {
    #`reflector --list-countries | sed 's/[0-9]//g' | sed 's/^/"/g' | sed 's/,.*//g' | sed 's/ *$//g'  | sed 's/$/"/g' | sed -e :a -e '$!N; s/\n/ /; ta'`
    PS3="$prompt1"
    echo "Select your country:"
    select country_name in "${countries_name[@]}"; do
      if contains_element "$country_name" "${countries_name[@]}"; then
        country_code=${countries_code[$((REPLY - 1))]}
        break
      else
        invalid_option
      fi
    done
  }
  print_title "MIRRORLIST - https://wiki.archlinux.org/index.php/Mirrors"
  print_info "Usando reflector para obtener los mirrors más rápidos y recientes (reemplaza curl+sed+rankmirrors legacy)."
  OPTION=n
  while [[ $OPTION != y ]]; do
    country_list
    read_input_text "Confirm country: $country_name"
  done

  # reflector ya está en el live ISO de Arch; si no, lo instalamos
  if ! command -v reflector >/dev/null 2>&1; then
    pacman -Sy --noconfirm --needed reflector
  fi

  # Backup del mirrorlist original
  [[ ! -f /etc/pacman.d/mirrorlist.orig ]] && cp /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.orig

  # Genera mirrorlist: HTTPS, recientes (<12h), top 20 por velocidad
  reflector \
    --country "${country_code}" \
    --protocol https \
    --age 12 \
    --latest 20 \
    --sort rate \
    --save /etc/pacman.d/mirrorlist

  chmod +r /etc/pacman.d/mirrorlist
  $EDITOR /etc/pacman.d/mirrorlist
}
#}}}
#UMOUNT PARTITIONS {{{
umount_partitions() {
  # findmnt anclado al MOUNTPOINT real (evita matches falsos como /mnt-old, /mnt-backup).
  # -R recursivo, -n sin header, -o TARGET sólo paths, ordenamos por profundidad inversa
  # para desmontar primero los hijos.
  local mp_list
  mapfile -t mp_list < <(findmnt -R -n -o TARGET "${MOUNTPOINT}" 2>/dev/null | tac)
  swapoff -a 2>/dev/null || true
  local mp
  for mp in "${mp_list[@]}"; do
    umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null || true
  done
  vgchange -an lvm >/dev/null 2>&1 || true
  # Cierra cualquier mapper LUKS abierto (cryptroot canónico; 'crypt' legacy por compat).
  cryptsetup close cryptroot >/dev/null 2>&1 || true
  cryptsetup close crypt >/dev/null 2>&1 || true
}
#}}}
#SELECT DEVICE {{{
select_device() {
  devices_list=($(lsblk -d | awk '{print "/dev/" $1}' | grep 'sd\|hd\|vd\|nvme\|mmcblk'))
  PS3="$prompt1"
  echo -e "Attached Devices:\n"
  lsblk -lnp -I 2,3,8,9,22,34,56,57,58,65,66,67,68,69,70,71,72,91,128,129,130,131,132,133,134,135,259 | awk '{print $1,$4,$6,$7}' | column -t
  echo -e "\n"
  echo -e "Select device to partition:\n"
  select device in "${devices_list[@]}"; do
    if contains_element "${device}" "${devices_list[@]}"; then
      break
    else
      invalid_option
    fi
  done
  BOOT_MOUNTPOINT=$device
}
#}}}
#CREATE PARTITION SCHEME {{{
create_partition_scheme() {
  LUKS=0
  LVM=0
  print_title "https://wiki.archlinux.org/index.php/Partitioning"
  print_info "Partitioning a hard drive allows one to logically divide the available space into sections that can be accessed independently of one another."
  print_info "Default del proyecto: cifrado LUKS desde el particionado inicial."
  print_warning "Sin LUKS no podrás usar luego fido2-unlock/keyfile-usb de fortress para root."
  print_warning "Maintain Current does not create LUKS; úsalo sólo si ya preparaste el cifrado manualmente."
  partition_layouts=("LVM+LUKS (default, recommended)" "Default (NO encryption)" "LVM (NO encryption)" "Maintain Current")
  PS3="$prompt1"
  echo -e "Select partition scheme:"
  select OPT in "${partition_layouts[@]}"; do
    partition_layout=$OPT
    case "$OPT" in
      "LVM+LUKS (default, recommended)")
        create_partition
        setup_luks || continue
        setup_lvm
        ;;
      "Default (NO encryption)")
        print_danger "Seleccionaste instalación SIN cifrado. Fortress no convertirá root/home a LUKS después."
        read_input_text "Confirmar instalación SIN cifrado"
        [[ $OPTION != y ]] && continue
        create_partition
        ;;
      "LVM (NO encryption)")
        print_danger "Seleccionaste LVM SIN cifrado. Fortress no convertirá root/home a LUKS después."
        read_input_text "Confirmar instalación SIN cifrado"
        [[ $OPTION != y ]] && continue
        create_partition
        setup_lvm
        ;;
      "Maintain Current")
        print_warning "Maintain Current asume que ya montaste/abriste cualquier LUKS existente manualmente."
        modprobe dm-mod
        vgscan &>/dev/null
        vgchange -ay &>/dev/null
        ;;
      *)
        invalid_option
        ;;
    esac
    [[ -n $OPT ]] && break
  done
}
#}}}
#SETUP PARTITION{{{
create_partition() {
  umount_partitions
  apps_list=("cfdisk" "cgdisk" "fdisk" "gdisk" "parted")
  PS3="$prompt1"
  echo -e "Select partition program:"
  select OPT in "${apps_list[@]}"; do
    if contains_element "$OPT" "${apps_list[@]}"; then
      select_device
      case $OPT in
      parted)
        parted -a opt "${device}"
        ;;
      *)
        $OPT "${device}"
        ;;
      esac
      break
    else
      invalid_option
    fi
  done
}
#}}}
#SETUP LUKS {{{
setup_luks() {
  print_title "LUKS - https://wiki.archlinux.org/index.php/LUKS"
  print_info "The Linux Unified Key Setup or LUKS is a disk-encryption specification created by Clemens Fruhwirth and originally intended for Linux."
  print_danger "\tDo not use this for boot partitions"
  # lsblk -lnpo NAME,TYPE: una línea por dispositivo con path absoluto y type;
  # filtramos TYPE=="part" (excluye disk, lvm, crypt, etc.) → sólo particiones físicas.
  mapfile -t block_list < <(lsblk -lnpo NAME,TYPE | awk '$2=="part"{print $1}')
  block_list+=("Cancel")
  PS3="$prompt1"
  echo -e "Select partition:"
  select OPT in "${block_list[@]}"; do
    if contains_element "$OPT" "${block_list[@]}"; then
      print_danger "Esto destruirá irreversiblemente los datos y firmas existentes en ${OPT}."
      printf "%s" "Escribe CIFRAR para confirmar LUKS2 en ${OPT}: "
      read -r luks_confirm
      [[ "$luks_confirm" == "CIFRAR" ]] || {
        print_warning "LUKS cancelado; no se continúa sin cifrado."
        return 1
      }
      wipefs -a "$OPT" || error_msg "wipefs falló en ${OPT}; no se continúa sin cifrado."
      # cryptsetup flags 2026:
      #   --use-urandom            evita bloqueo en live ISO sin RNG hardware (urandom es eq. cripto)
      #   --pbkdf argon2id         explícito (default desde cryptsetup 2.4 pero no asumir)
      #   --pbkdf-memory 524288    tope 512MiB → evita OOM al unlock en sistemas low-RAM
      #   --pbkdf-parallel 4       paraleliza derivación; reduce iter-time real sin perder coste
      cryptsetup --batch-mode --type luks2 \
        --cipher aes-xts-plain64 --key-size 512 --hash sha512 \
        --pbkdf argon2id --pbkdf-memory 524288 --pbkdf-parallel 4 --iter-time 5000 \
        --use-urandom --verify-passphrase \
        luksFormat "$OPT" \
        || error_msg "luksFormat falló; no se continúa sin cifrado."
      local open_args=(open --type luks)
      [[ $TRIM -eq 1 ]] && open_args+=(--allow-discards)
      # Nombre canónico 'cryptroot' usado consistentemente en setup_lvm, fstab generado,
      # y rd.luks.name= del cmdline. NO usar 'crypt' (legacy, rompía LUKS-sin-LVM).
      cryptsetup "${open_args[@]}" "$OPT" cryptroot \
        || error_msg "No se pudo abrir el contenedor LUKS; no se continúa sin cifrado."
      LUKS=1
      LUKS_DISK=$(echo "${OPT}" | sed 's/\/dev\///')
      break
    elif [[ $OPT == "Cancel" ]]; then
      print_warning "LUKS cancelado; vuelve a elegir particionado o confirma un modo sin cifrado explícito."
      return 1
    else
      invalid_option
    fi
  done
}
#}}}
#SETUP LVM {{{
setup_lvm() {
  print_title "LVM - https://wiki.archlinux.org/index.php/LVM"
  print_info "LVM is a logical volume manager for the Linux kernel; it manages disk drives and similar mass-storage devices. "
  print_info "Layout recomendado: LV root grande para pacstrap/KDE y LV home con el espacio restante."
  if [[ $LUKS -eq 1 ]]; then
    pvcreate /dev/mapper/cryptroot || error_msg "pvcreate falló sobre /dev/mapper/cryptroot"
    vgcreate lvm /dev/mapper/cryptroot || error_msg "vgcreate lvm falló"
  else
    mapfile -t block_list < <(lsblk -lnpo NAME,TYPE | awk '$2=="part"{print $1}')
    PS3="$prompt1"
    echo -e "Select partition:"
    select OPT in "${block_list[@]}"; do
      if contains_element "$OPT" "${block_list[@]}"; then
        pvcreate "$OPT" || error_msg "pvcreate falló sobre $OPT"
        vgcreate lvm "$OPT" || error_msg "vgcreate lvm falló"
        break
      else
        invalid_option
      fi
    done
  fi
  local lvm_modes=("Guided root+home (recommended)" "Manual")
  PS3="$prompt1"
  print_info "Guiado crea LV root para / y LV home para /home. En el siguiente paso se usará /dev/mapper/lvm-root como root, no la partición física cifrada."
  echo -e "Select LVM layout:\n"
  select LVM_MODE in "${lvm_modes[@]}"; do
    case "$LVM_MODE" in
      "Guided root+home (recommended)")
        # Sin swap LV: ZRAM cubre el caso, sin hibernación soportada.
        local root_size
        print_info "Tamaño de root (/). Mínimo 30G para Arch+KDE/GNOME con cache pacman."
        print_info "Recomendado para desktop con juegos/IDEs/contenedores: 60G o más."
        print_info "Puedes escribir sólo el número (asume GB): '30' equivale a '30G'."
        read_size "Root LV size" "60G" 30 root_size
        lvcreate -L "$root_size" lvm -n root \
          || error_msg "No se pudo crear LV root de $root_size. Usa un disco más grande o menor tamaño."

        lvcreate -l 100%FREE lvm -n home || print_warning "No quedó espacio libre para LV home; puedes continuar sólo con root."
        LVM=1
        return
        ;;
      "Manual")
        break
        ;;
      *)
        invalid_option
        ;;
    esac
  done

  print_warning "Manual: el último LV toma 100% del espacio restante. Crea primero un LV llamado root."
  printf "%s" "Enter number of LVs [ex: 2 for root+home]: "
  read -r number_partitions
  i=1
  while [[ $i -le $number_partitions ]]; do
    printf "%s" "Enter $iª LV name [required first LV: root; ex: root, home, data]: "
    read -r partition_name
    if [[ $i -eq 1 && "$partition_name" != "root" ]]; then
      error_msg "El primer LV debe llamarse root para evitar instalaciones con / demasiado pequeño o mal montado."
    fi
    if [[ $i -eq $number_partitions ]]; then
      lvcreate -l 100%FREE lvm -n "${partition_name}"
    else
      # Mínimo razonable según el rol del LV
      local lv_min=1
      [[ "$partition_name" == "root" ]] && lv_min=30
      read_size "Tamaño del ${i}º LV (${partition_name})" "30G" "$lv_min" partition_size
      lvcreate -L "${partition_size}" lvm -n "${partition_name}"
    fi
    i=$((i + 1))
  done
  LVM=1
}
#}}}
#SELECT|FORMAT PARTITIONS {{{
format_partitions() {
  print_title "https://wiki.archlinux.org/index.php/File_Systems"
  print_info "This step will select and format the selected partition where archlinux will be installed"
  print_danger "\tAll data on the ROOT and SWAP partition will be LOST."
  [[ $LVM -eq 1 ]] && print_info "Modo LVM detectado: root/home se eligen desde /dev/mapper/lvm-*. Las particiones físicas sólo se muestran cuando corresponden, como la ESP para /boot."
  i=0

  # lsblk -lnpo NAME,TYPE: una línea por device, paths absolutos, sin tree-prefix.
  # Particiones físicas TYPE=part → /dev/sda1, /dev/nvme0n1p1, ...
  # LVs TYPE=lvm → /dev/mapper/lvm-root, /dev/mapper/lvm-home, ...
  # Excluimos disk, crypt, etc. para evitar formatear backing devices.
  mapfile -t partitions_list < <(lsblk -lnpo NAME,TYPE | awk '$2=="part" || $2=="lvm" {print $1}')

  if [[ ${#partitions_list[@]} -eq 0 ]]; then
    error_msg "No se detectaron particiones ni LVs. Vuelve al paso de particionado."
  fi

  role_partitions=()

  # partitions based on boot system
  # NOTA: swap eliminado a propósito. ZRAM cubre 100% del caso en 2026 (cfg en
  # configure_zen_tuning + zram-generator). Hibernación a disco no es soportada
  # por este instalador; quien la necesite la añade post-install manualmente.
  if [[ $UEFI -eq 1 ]]; then
    partition_name=("root" "EFI" "another")
  else
    partition_name=("root" "another")
  fi

  select_filesystem() {
    filesystems_list=("btrfs" "ext2" "ext3" "ext4" "f2fs" "jfs" "nilfs2" "ntfs" "reiserfs" "vfat" "xfs")
    PS3="$prompt1"
    echo -e "Select filesystem:\n"
    select filesystem in "${filesystems_list[@]}"; do
      if contains_element "${filesystem}" "${filesystems_list[@]}"; then
        break
      else
        invalid_option
      fi
    done
  }

  is_luks_backing_partition() {
    [[ $LUKS -eq 1 && "$1" == "/dev/${LUKS_DISK}" ]]
  }

  has_lsblk_children() {
    [[ "$(lsblk -ln "$1" 2>/dev/null | wc -l)" -gt 1 ]]
  }

  is_lvm_lv() {
    [[ "$1" == /dev/mapper/lvm-* ]]
  }

  is_physical_leaf_partition() {
    [[ "$1" != /dev/mapper/* ]] && ! is_luks_backing_partition "$1" && ! has_lsblk_children "$1"
  }

  build_partition_candidates() {
    local role="$1"
    local partition_candidate
    role_partitions=()
    for partition_candidate in "${partitions_list[@]}"; do
      case "$role" in
        root)
          if [[ $LVM -eq 1 ]]; then
            [[ "$partition_candidate" == "/dev/mapper/lvm-root" ]] && role_partitions+=("$partition_candidate")
          elif ! is_luks_backing_partition "$partition_candidate"; then
            role_partitions+=("$partition_candidate")
          fi
          ;;
        EFI)
          is_physical_leaf_partition "$partition_candidate" && role_partitions+=("$partition_candidate")
          ;;
        another)
          if [[ $LVM -eq 1 ]]; then
            is_lvm_lv "$partition_candidate" &&
              [[ "$partition_candidate" != "/dev/mapper/lvm-root" ]] &&
              role_partitions+=("$partition_candidate")
          elif ! is_luks_backing_partition "$partition_candidate"; then
            role_partitions+=("$partition_candidate")
          fi
          ;;
      esac
    done
  }

  print_partition_hint() {
    case "$1" in
      root)
        [[ $LVM -eq 1 ]] && print_info "Root (/): elige /dev/mapper/lvm-root, el LV creado para el sistema base."
        ;;
      EFI)
        print_info "EFI: elige la ESP sin cifrar (normalmente la partición pequeña FAT32). AUI-X la montará en /boot para systemd-boot."
        ;;
      another)
        [[ $LVM -eq 1 ]] && print_info "Extra: elige /dev/mapper/lvm-home para montarlo como /home."
        ;;
    esac
  }

  disable_partition() {
    local selected_partition="$1"
    local remaining_partitions=()
    local current_partition
    for current_partition in "${partitions_list[@]}"; do
      [[ "$current_partition" != "$selected_partition" ]] && remaining_partitions+=("$current_partition")
    done
    partitions_list=("${remaining_partitions[@]}")
    #increase i
    [[ ${partition_name[i]} != another ]] && i=$((i + 1))
  }

  # Btrfs subvolume layout para root: @, @home, @var_log, @snapshots.
  # Habilita rollback con snapper/grub-btrfs y aisla /var/log de snapshots de raíz.
  # Opciones de mount: compress=zstd (transparente, gana ~30-50% espacio en logs/configs),
  #                    noatime (menos writes), space_cache=v2 (más rápido).
  # discard=async sólo si TRIM=1 (NVMe/SSD); async no penaliza latencia.
  _btrfs_setup_root() {
    local dev="$1" mnt="$2"
    local mount_opts="noatime,compress=zstd,space_cache=v2"
    [[ $TRIM -eq 1 ]] && mount_opts+=",discard=async"

    print_info "Btrfs detectado para /: creando layout de subvolúmenes (@, @home, @var_log, @snapshots)."

    # Mount temporal en raíz del FS para crear subvols
    mount -t btrfs "$dev" "$mnt" || error_msg "mount inicial btrfs falló sobre $dev"
    btrfs subvolume create "$mnt/@"          || error_msg "btrfs subvolume create @ falló"
    btrfs subvolume create "$mnt/@home"      || error_msg "btrfs subvolume create @home falló"
    btrfs subvolume create "$mnt/@var_log"   || error_msg "btrfs subvolume create @var_log falló"
    btrfs subvolume create "$mnt/@snapshots" || error_msg "btrfs subvolume create @snapshots falló"
    umount "$mnt"

    # Remount con subvol=@ + opciones tuneadas
    mount -t btrfs -o "subvol=@,${mount_opts}" "$dev" "$mnt" \
      || error_msg "remount btrfs subvol=@ falló"

    # Crear paths y montar subvols hijos
    mkdir -p "$mnt/home" "$mnt/var/log" "$mnt/.snapshots"
    mount -t btrfs -o "subvol=@home,${mount_opts}"      "$dev" "$mnt/home"
    mount -t btrfs -o "subvol=@var_log,${mount_opts}"   "$dev" "$mnt/var/log"
    mount -t btrfs -o "subvol=@snapshots,${mount_opts}" "$dev" "$mnt/.snapshots"

    print_success "Btrfs subvols listos: @=/  @home=/home  @var_log=/var/log  @snapshots=/.snapshots"
  }

  format_partition() {
    read_input_text "Confirm format $1 partition"
    if [[ $OPTION == y ]]; then
      [[ -z $3 ]] && select_filesystem || filesystem=$3
      mkfs."${filesystem}" "$1" \
        $([[ ${filesystem} == xfs || ${filesystem} == btrfs || ${filesystem} == reiserfs ]] && echo "-f") \
        $([[ ${filesystem} == vfat ]] && echo "-F32") \
        $([[ $TRIM -eq 1 && ${filesystem} == ext4 ]] && echo "-E discard")
      fsck "$1"
      mkdir -p "$2"
      # Btrfs como root → layout de subvolúmenes; otros FS o mountpoints → mount plano
      if [[ "${filesystem}" == "btrfs" && "$2" == "${MOUNTPOINT}" ]]; then
        _btrfs_setup_root "$1" "$2"
      else
        mount -t "${filesystem}" "$1" "$2"
      fi
      disable_partition "$1"
    fi
  }

  check_mountpoint() {
    if mount | grep "$2"; then
      echo "Successfully mounted"
      disable_partition "$1"
    else
      echo "WARNING: Not Successfully mounted"
    fi
  }

  set_efi_partition() {
    EFI_MOUNTPOINT="/boot"
    print_info "UEFI estándar: ESP montada en /boot para systemd-boot."
  }

  # NOTA: swap eliminado del flujo. ZRAM cubre el caso (cfg en configure_zen_tuning).
  # Hibernación a disco no soportada por este instalador; añadirla post-install.
  while true; do
    PS3="$prompt1"
    build_partition_candidates "${partition_name[i]}"
    if [[ ${#role_partitions[@]} -eq 0 ]]; then
      if [[ ${partition_name[i]} == another ]]; then
        print_info "No quedan particiones/LVs seguros para montar como extra."
        break
      fi
      error_msg "No hay candidatos seguros para ${partition_name[i]}. Revisa el particionado/LVM antes de continuar."
    fi
    print_partition_hint "${partition_name[i]}"
    echo -e "Select ${BYellow}${partition_name[i]}${Reset} partition:\n"
    select partition in "${role_partitions[@]}"; do
      if contains_element "${partition}" "${partitions_list[@]}"; then
        case ${partition_name[i]} in
        root)
          ROOT_PART=$(echo "${partition}" | sed 's/\/dev\/mapper\///' | sed 's/\/dev\///')
          ROOT_MOUNTPOINT=${partition}
          format_partition "${partition}" "${MOUNTPOINT}"
          ;;
        EFI)
          set_efi_partition
          read_input_text "Format ${partition} partition"
          if [[ $OPTION == y ]]; then
            format_partition "${partition}" "${MOUNTPOINT}${EFI_MOUNTPOINT}" vfat
          else
            mkdir -p "${MOUNTPOINT}${EFI_MOUNTPOINT}"
            mount -t vfat "${partition}" "${MOUNTPOINT}${EFI_MOUNTPOINT}"
            check_mountpoint "${partition}" "${MOUNTPOINT}${EFI_MOUNTPOINT}"
          fi
          ;;
        another)
          if [[ "$partition" == "/dev/mapper/lvm-home" ]]; then
            printf "%s" "Mountpoint [default: /home]: "
          else
            printf "%s" "Mountpoint [ex: /home]: "
          fi
          read -r directory
          [[ -z "$directory" && "$partition" == "/dev/mapper/lvm-home" ]] && directory="/home"
          [[ $directory == "/boot" ]] && BOOT_MOUNTPOINT=$(echo "${partition}" | sed 's/[0-9]//')
          select_filesystem
          read_input_text "Format ${partition} partition"
          if [[ $OPTION == y ]]; then
            format_partition "${partition}" "${MOUNTPOINT}${directory}" "${filesystem}"
          else
            read_input_text "Confirm fs=""${filesystem}"" part=""${partition}"" dir=""${directory}"""
            if [[ $OPTION == y ]]; then
              mkdir -p "${MOUNTPOINT}${directory}"
              mount -t "${filesystem}" "${partition}" "${MOUNTPOINT}""${directory}"
              check_mountpoint "${partition}" "${MOUNTPOINT}${directory}"
            fi
          fi
          ;;
        esac
        break
      else
        invalid_option
      fi
    done
    # ¿quedan particiones libres y más roles que procesar?
    if [[ ${#partitions_list[@]} -eq 0 ]]; then
      break
    elif [[ ${partition_name[i]} == another ]]; then
      read_input_text "Configure more partitions"
      [[ $OPTION != y ]] && break
    fi
  done
  pause_function
}
#}}}
#ZEN PERFORMANCE/SECURITY BASELINE {{{
# Escribe configs declarativas en el sistema instalado. Idempotente (sobrescribe).
# Objetivo: aprovechar linux-zen (BBR3, EEVDF/BORE, PREEMPT_DYNAMIC, PSI) sin
# comprometer la postura por defecto del kernel en mitigaciones de CPU.
configure_zen_tuning() {
  print_info "Aplicando baseline de tuning para linux-zen (sysctl, udev, modprobe, zram)."

  mkdir -p "${MOUNTPOINT}/etc/sysctl.d" \
           "${MOUNTPOINT}/etc/udev/rules.d" \
           "${MOUNTPOINT}/etc/modprobe.d" \
           "${MOUNTPOINT}/etc/systemd" \
           "${MOUNTPOINT}/etc/systemd/resolved.conf.d"

  # Red: BBR (zen trae BBR3) + fair queueing + hardening baseline + IPv6 privacy
  cat > "${MOUNTPOINT}/etc/sysctl.d/99-zen-net.conf" <<'EOF'
# --- Performance ---
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_mtu_probing = 1
net.core.netdev_max_backlog = 16384
net.core.somaxconn = 8192

# --- IPv4 hardening (postura senior responsable) ---
net.ipv4.tcp_rfc1337 = 1
net.ipv4.tcp_syncookies = 1
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv4.conf.all.log_martians = 1

# --- IPv6 privacy (RFC4941) + hardening ---
# use_tempaddr=2: prefiere direcciones temporales (rotan) sobre EUI-64 (basada en MAC).
# Crítico para laptops en redes públicas (café/aeropuerto/conferencia).
net.ipv6.conf.all.use_tempaddr = 2
net.ipv6.conf.default.use_tempaddr = 2
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0
net.ipv6.conf.all.accept_source_route = 0
net.ipv6.conf.default.accept_source_route = 0
EOF

  # VM/FS: tuning zram-only (sin swap en disco como caso default).
  # swappiness=180: con zram, "swap" es comprimir en RAM → es barato, hazlo agresivo.
  # page-cluster=0: lectura single-page; random-access a zram es rápido, no agrupar.
  # Valores alineados con defaults de Fedora Workstation (probados en producción).
  cat > "${MOUNTPOINT}/etc/sysctl.d/99-zen-vm.conf" <<'EOF'
vm.swappiness = 180
vm.page-cluster = 0
vm.watermark_boost_factor = 0
vm.watermark_scale_factor = 125
vm.vfs_cache_pressure = 50
vm.dirty_bytes = 268435456
vm.dirty_background_bytes = 67108864
fs.inotify.max_user_watches = 524288
fs.inotify.max_user_instances = 8192
kernel.split_lock_mitigate = 0
EOF

  # I/O schedulers por tipo de dispositivo (multi-queue aware)
  cat > "${MOUNTPOINT}/etc/udev/rules.d/60-ioschedulers.rules" <<'EOF'
# NVMe: dejar al hardware (multi-queue nativo)
ACTION=="add|change", KERNEL=="nvme[0-9]n[0-9]", ATTR{queue/scheduler}="none"
# SSD SATA / MMC: deadline multi-queue
ACTION=="add|change", KERNEL=="sd[a-z]|mmcblk[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline"
# HDD rotacional: BFQ (fairness por proceso)
ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
EOF

  # Module tweaks: silenciar PC speaker, audio sin pops.
  # Nota: nvme_core suspend latency NO va aquí (módulo built-in en kernels Arch);
  #       vive en el cmdline del bootloader como nvme_core.default_ps_max_latency_us=5500.
  cat > "${MOUNTPOINT}/etc/modprobe.d/zen-tuning.conf" <<'EOF'
blacklist pcspkr
blacklist snd_pcsp
options snd_hda_intel power_save=1 power_save_controller=Y
EOF

  # ZRAM swap (zstd, mitad de RAM con tope 8G): preferible a swapfile/swap-LV
  # para no exponer claves de sesión a disco. Coexiste con swap físico si el
  # usuario lo configuró (zram con prio 100 se usa primero).
  cat > "${MOUNTPOINT}/etc/systemd/zram-generator.conf" <<'EOF'
[zram0]
zram-size = min(ram / 2, 8192)
compression-algorithm = zstd
swap-priority = 100
fs-type = swap
EOF

  # systemd-resolved: DNSSEC y DoT oportunista, resolvers públicos como fallback
  cat > "${MOUNTPOINT}/etc/systemd/resolved.conf.d/10-aui-x.conf" <<'EOF'
[Resolve]
DNSSEC=allow-downgrade
DNSOverTLS=opportunistic
Cache=yes
FallbackDNS=1.1.1.1 9.9.9.9 2606:4700:4700::1111 2620:fe::fe
EOF

  # nftables: default-drop input, allow loopback + established/related + ICMP esenciales.
  # Estanco para desktop/laptop: cualquier servicio que se levante post-install
  # (CUPS, mDNS, KDE Connect, etc.) queda contenido salvo que se abra explícitamente.
  # Para abrir un puerto: editar /etc/nftables.conf, añadir regla en chain input,
  # luego: systemctl reload nftables
  cat > "${MOUNTPOINT}/etc/nftables.conf" <<'EOF'
#!/usr/bin/nft -f
# aui-x baseline firewall: default-drop input, allow output.
# https://wiki.archlinux.org/title/Nftables

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        # loopback
        iif lo accept
        iif != lo ip daddr 127.0.0.0/8 drop
        iif != lo ip6 daddr ::1 drop

        # estado de conexión: aceptar respuestas a tráfico saliente
        ct state established,related accept
        ct state invalid drop

        # ICMP esencial (necesario para PMTUD y diagnóstico de red)
        ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } accept
        ip6 nexthdr icmpv6 icmpv6 type {
            destination-unreachable, packet-too-big, time-exceeded, parameter-problem,
            echo-request, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert,
            mld-listener-query, mld-listener-report, mld-listener-reduction
        } accept

        # DHCPv6 client (necesario para IPv6 vía DHCP)
        udp dport 546 ct state new accept

        # SSH: COMENTADO por defecto. Descomenta si necesitas SSH inbound:
        # tcp dport 22 ct state new limit rate 5/minute accept

        # log + drop por defecto (descomenta para debug)
        # log prefix "[nft drop] " counter drop

        counter drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
EOF
  chmod 0644 "${MOUNTPOINT}/etc/nftables.conf"
}
#}}}
#INSTALL BASE SYSTEM {{{
# AUI-X pin: linux-zen (primary, BORE+BBR3+PREEMPT_DYNAMIC) + linux-lts (real fallback).
# linux plain queda fuera a propósito: rebasea al mismo ritmo que zen, no protege ante
# regresiones upstream. linux-hardened queda fuera por incompatibilidades recurrentes
# con stacks GPU propietarios y módulos DKMS.
install_base_system() {
  print_title "INSTALL BASE SYSTEM"
  print_info "Refreshing PGP keyring"

  # NTP antes de tocar firmas: evita rechazo de paquetes por reloj desincronizado en VMs/live
  timedatectl set-ntp true 2>/dev/null || true

  pacman -Sy --noconfirm archlinux-keyring

  KERNEL_PRIMARY="linux-zen"
  print_info "Kernels: linux-zen (primario, performance) + linux-lts (fallback recovery)."
  local kernels=("linux-zen" "linux-zen-headers" "linux-lts" "linux-lts-headers")

  # Microcode sólo en x86_64 (no existe para aarch64/otras)
  local ucode_pkgs=()
  [[ "$ARCHI" == "x86_64" ]] && ucode_pkgs=("intel-ucode" "amd-ucode")

  print_info "Installing base con paquetes explícitos (paquete 'base', no grupo legacy)"

  # pacstrap -K usa keyring fresco; estándar moderno
  pacstrap -K "${MOUNTPOINT}" \
    base base-devel \
    "${kernels[@]}" \
    linux-firmware "${ucode_pkgs[@]}" \
    cryptsetup lvm2 \
    networkmanager iwd \
    pipewire pipewire-pulse pipewire-alsa pipewire-jack wireplumber \
    btrfs-progs dosfstools e2fsprogs xfsprogs f2fs-tools \
    vim nano man-db man-pages \
    git sudo \
    reflector pacman-contrib \
    zram-generator \
    nftables \
    iputils inetutils \
    parted efibootmgr

  [[ $? -ne 0 ]] && error_msg "Installing base system to ${MOUNTPOINT} failed. Check error messages above."

  # Servicios base habilitados para primer boot
  arch_chroot "systemctl enable NetworkManager.service"
  arch_chroot "systemctl enable systemd-resolved.service"
  arch_chroot "systemctl enable systemd-timesyncd.service"
  arch_chroot "systemctl enable fstrim.timer"
  arch_chroot "systemctl enable systemd-oomd.service"
  arch_chroot "systemctl enable paccache.timer"
  arch_chroot "systemctl enable reflector.timer" 2>/dev/null || true
  arch_chroot "systemctl enable nftables.service"

  # Zen performance/security baseline (sysctl, udev, modprobe, zram, resolved)
  configure_zen_tuning

  # NetworkManager: backend iwd (WiFi moderno) + DNS via systemd-resolved
  mkdir -p "${MOUNTPOINT}"/etc/NetworkManager/conf.d
  cat > "${MOUNTPOINT}"/etc/NetworkManager/conf.d/dns.conf <<'EOF'
[main]
dns=systemd-resolved
rc-manager=symlink
EOF
  cat > "${MOUNTPOINT}"/etc/NetworkManager/conf.d/wifi-backend.conf <<'EOF'
[device]
wifi.backend=iwd
EOF
  ln -sf /run/systemd/resolve/stub-resolv.conf "${MOUNTPOINT}"/etc/resolv.conf

  # Accesibilidad opcional
  if is_package_installed "espeakup"; then
    pacstrap -K "${MOUNTPOINT}" alsa-utils espeakup brltty
    arch_chroot "systemctl enable espeakup.service"
  fi
}
#}}}
#CONFIGURE KEYMAP {{{
configure_keymap() {
  #ADD KEYMAP TO THE NEW SETUP
  echo "KEYMAP=$KEYMAP" >"${MOUNTPOINT}"/etc/vconsole.conf
}
#}}}
#CONFIGURE FSTAB {{{
configure_fstab() {
  print_title "FSTAB - https://wiki.archlinux.org/index.php/Fstab"
  print_info "The /etc/fstab file contains static filesystem information. It defines how storage devices and partitions are to be mounted and integrated into the overall system. It is read by the mount command to determine which options to use when mounting a specific partition or partition."
  if [[ ! -f ${MOUNTPOINT}/etc/fstab.aui ]]; then
    cp "${MOUNTPOINT}"/etc/fstab "${MOUNTPOINT}"/etc/fstab.aui
  else
    cp "${MOUNTPOINT}"/etc/fstab.aui "${MOUNTPOINT}"/etc/fstab
  fi
  if [[ $UEFI -eq 1 ]]; then
    fstab_list=("DEV" "PARTUUID" "LABEL")
  else
    fstab_list=("DEV" "UUID" "LABEL")
  fi

  PS3="$prompt1"
  echo -e "Configure fstab based on:"
  select OPT in "${fstab_list[@]}"; do
    case "$REPLY" in
    1) genfstab -p "${MOUNTPOINT}" >>"${MOUNTPOINT}"/etc/fstab ;;
    2)
      if [[ $UEFI -eq 1 ]]; then
        genfstab -t PARTUUID -p "${MOUNTPOINT}" >>"${MOUNTPOINT}"/etc/fstab
      else
        genfstab -U -p "${MOUNTPOINT}" >>"${MOUNTPOINT}"/etc/fstab
      fi
      ;;
    3) genfstab -L -p "${MOUNTPOINT}" >>"${MOUNTPOINT}"/etc/fstab ;;
    *) invalid_option ;;
    esac
    [[ -n $OPT ]] && break
  done
  fstab=$OPT
  echo "Review your fstab"
  [[ -f ${MOUNTPOINT}/swapfile ]] && sed -i "s/\\${MOUNTPOINT}//" "${MOUNTPOINT}"/etc/fstab
  pause_function
  $EDITOR "${MOUNTPOINT}"/etc/fstab
}
#}}}
#CONFIGURE HOSTNAME {{{
configure_hostname() {
  print_title "HOSTNAME - https://wiki.archlinux.org/index.php/HOSTNAME"
  print_info "Hostname RFC1123: minúsculas/dígitos/guion, no empieza ni termina en guion, máx 63 chars."
  # Re-prompt hasta que el input pase la validación. Evita escribir basura en /etc/hostname
  # y bloquea cualquier carácter que rompería el sed posterior (/, ', ;, etc.).
  while true; do
    printf "%s" "Hostname [ej: arch-laptop]: "
    read -r host_name
    if [[ "$host_name" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
      break
    fi
    print_warning "Hostname inválido: '$host_name'. Usa minúsculas/dígitos/guion, 1-63 chars, sin guion al inicio o final."
  done

  echo "$host_name" >"${MOUNTPOINT}"/etc/hostname
  if [[ ! -f ${MOUNTPOINT}/etc/hosts.aui ]]; then
    cp "${MOUNTPOINT}"/etc/hosts "${MOUNTPOINT}"/etc/hosts.aui
  else
    cp "${MOUNTPOINT}"/etc/hosts.aui "${MOUNTPOINT}"/etc/hosts
  fi
  # host_name validado: sólo [a-z0-9-] → seguro en sed sin escapar
  arch_chroot "sed -i '/127.0.0.1/s/\$/ ${host_name}/' /etc/hosts"
  arch_chroot "sed -i '/::1/s/\$/ ${host_name}/' /etc/hosts"
}
#}}}
#CONFIGURE TIMEZONE {{{
configure_timezone() {
  print_title "TIMEZONE - https://wiki.archlinux.org/index.php/Timezone"
  print_info "In an operating system the time (clock) is determined by four parts: Time value, Time standard, Time Zone, and DST (Daylight Saving Time if applicable)."
  OPTION=n
  while [[ $OPTION != y ]]; do
    settimezone
    read_input_text "Confirm timezone (${ZONE}/${SUBZONE})"
  done
  arch_chroot "ln -sf /usr/share/zoneinfo/${ZONE}/${SUBZONE} /etc/localtime"
  arch_chroot "sed -i '/#NTP=/d' /etc/systemd/timesyncd.conf"
  arch_chroot "sed -i 's/#Fallback//' /etc/systemd/timesyncd.conf"
  arch_chroot "echo \"FallbackNTP=0.pool.ntp.org 1.pool.ntp.org 0.fr.pool.ntp.org\" >> /etc/systemd/timesyncd.conf"
  arch_chroot "systemctl enable systemd-timesyncd.service"
}
#}}}
#CONFIGURE HARDWARECLOCK {{{
configure_hardwareclock() {
  print_title "HARDWARE CLOCK TIME - https://wiki.archlinux.org/index.php/Internationalization"
  print_info "This is set in /etc/adjtime. Set the hardware clock mode uniformly between your operating systems on the same machine. Otherwise, they will overwrite the time and cause clock shifts (which can cause time drift correction to be miscalibrated)."
  hwclock_list=('UTC' 'Localtime')
  PS3="$prompt1"
  select OPT in "${hwclock_list[@]}"; do
    case "$REPLY" in
    1)
      arch_chroot "hwclock --systohc --utc"
      ;;
    2)
      arch_chroot "hwclock --systohc --localtime"
      ;;
    *) invalid_option ;;
    esac
    [[ -n $OPT ]] && break
  done
  hwclock=$OPT
}
#}}}
#CONFIGURE LOCALE {{{
configure_locale() {
  print_title "LOCALE - https://wiki.archlinux.org/index.php/Locale"
  print_info "Locales are used in Linux to define which language the user uses. As the locales define the character sets being used as well, setting up the correct locale is especially important if the language contains non-ASCII characters."
  OPTION=n
  while [[ $OPTION != y ]]; do
    setlocale
    read_input_text "Confirm locale ($LOCALE)"
  done
  echo 'LANG="'"$LOCALE_UTF8"'"' >"${MOUNTPOINT}"/etc/locale.conf
  arch_chroot "sed -i 's/#\('${LOCALE_UTF8}'\)/\1/' /etc/locale.gen"
  arch_chroot "locale-gen"
}
#}}}
#CONFIGURE MKINITCPIO {{{
configure_mkinitcpio() {
  print_title "MKINITCPIO - https://wiki.archlinux.org/index.php/Mkinitcpio"
  print_info "Configurando initramfs con hooks systemd (sd-encrypt + sd-lvm2). Más robusto y compatible con FIDO2/TPM en fortress."

  # Hooks systemd-based (reemplaza udev/encrypt/lvm2 legacy)
  # Orden importante: base systemd autodetect microcode modconf kms keyboard sd-vconsole block [sd-encrypt] [sd-lvm2] filesystems fsck
  local hooks="base systemd autodetect microcode modconf kms keyboard sd-vconsole block"
  [[ $LUKS -eq 1 ]] && hooks="$hooks sd-encrypt"
  [[ $LVM -eq 1 ]] && hooks="$hooks sd-lvm2"
  hooks="$hooks filesystems fsck"

  sed -i "s/^HOOKS=.*/HOOKS=($hooks)/" "${MOUNTPOINT}"/etc/mkinitcpio.conf

  # zstd paralelo: initramfs más chico y descompresión usando todos los cores
  sed -i 's/^#\?COMPRESSION=.*/COMPRESSION="zstd"/' "${MOUNTPOINT}"/etc/mkinitcpio.conf
  if grep -q '^#\?COMPRESSION_OPTIONS=' "${MOUNTPOINT}"/etc/mkinitcpio.conf; then
    sed -i 's/^#\?COMPRESSION_OPTIONS=.*/COMPRESSION_OPTIONS=(-19 -T0)/' "${MOUNTPOINT}"/etc/mkinitcpio.conf
  else
    echo 'COMPRESSION_OPTIONS=(-19 -T0)' >> "${MOUNTPOINT}"/etc/mkinitcpio.conf
  fi

  print_info "mkinitcpio.conf actualizado (HOOKS=$hooks, COMPRESSION=zstd -19 -T0). Saltando editor interactivo; revisa con: vim ${MOUNTPOINT}/etc/mkinitcpio.conf"

  # -P regenera para TODOS los presets instalados (zen + linux-lts recovery)
  arch_chroot "mkinitcpio -P"
}
#}}}
#INSTALL BOOTLOADER {{{
install_bootloader() {
  print_title "BOOTLOADER - https://wiki.archlinux.org/index.php/Bootloader"
  print_info "AUI-X usa UEFI + systemd-boot. No hay ruta BIOS/legacy."
  [[ $UEFI -eq 1 ]] || error_msg "UEFI no detectado; no se instala bootloader legacy."
  bootloader="systemd-boot"
  print_success "Bootloader seleccionado: systemd-boot"
}
#}}}
#CONFIGURE BOOTLOADER {{{
# Para sd-encrypt hooks, los kernel params son:
#   rd.luks.name=<luks-uuid>=<mapper-name>   (preferido, robusto)
#   root=/dev/mapper/<mapper-name>
#   rd.luks.options=discard                  (si TRIM)
# NO usar 'cryptdevice=' (eso es del hook 'encrypt' legacy, NO sd-encrypt).
_kernel_cmdline() {
  # Construye los parámetros de kernel acorde a sd-encrypt + sd-lvm2.
  # Mitigations queda en default del kernel (auto): explícito nada → postura responsable.
  # Tuning añadido (zen-aware):
  #   amd_pstate=active                          driver moderno en AMD Zen2+ (no-op en Intel)
  #   split_lock_detect=off                      compat con Wine/anti-cheat
  #   nowatchdog                                 drop kernel watchdog (latencia + batería)
  #   quiet loglevel=3                           boot limpio; journalctl conserva todo
  #   nvme_core.default_ps_max_latency_us=5500   evita cuelgues NVMe suspend (Samsung 980/990,
  #                                              WD SN850). Debe ir en cmdline porque nvme_core
  #                                              es built-in en kernels Arch (modprobe.d se ignora).
  # Nota: nvidia_drm.modeset NO se añade aquí; lo escribe setup en /etc/modprobe.d/
  # cuando se instala el driver, evitando flags fantasma sin GPU NVIDIA.
  local root_spec="${ROOT_MOUNTPOINT}"
  local cmdline

  if [[ -z "$root_spec" ]]; then
    error_msg "ROOT_MOUNTPOINT vacío; revisa que el paso de particionado montó / correctamente."
  fi

  if [[ $LUKS -eq 1 ]]; then
    local luks_uuid
    luks_uuid=$(blkid -s UUID -o value "/dev/${LUKS_DISK}" 2>/dev/null)
    if [[ -n "$luks_uuid" ]]; then
      cmdline="rd.luks.name=${luks_uuid}=cryptroot root=${root_spec} rw"
    else
      cmdline="root=${root_spec} rw"
    fi
    [[ $TRIM -eq 1 ]] && cmdline="rd.luks.options=discard ${cmdline}"
  else
    cmdline="root=${root_spec} rw"
  fi

  cmdline="${cmdline} amd_pstate=active split_lock_detect=off nowatchdog"
  cmdline="${cmdline} nvme_core.default_ps_max_latency_us=5500"
  cmdline="${cmdline} quiet loglevel=3"
  echo "$cmdline"
}

configure_bootloader() {
  case $bootloader in
  systemd-boot)
    print_title "SYSTEMD-BOOT - https://wiki.archlinux.org/title/Systemd-boot"
    print_info "Instalando systemd-boot con entradas duales: kernel primario + linux-lts (recovery)."
    [[ "$EFI_MOUNTPOINT" == "/boot" ]] || error_msg "systemd-boot requiere ESP montada en /boot."

    # Pre-check ESP: necesitamos ~256MB libres para zen+lts (vmlinuz ~12MB c/u),
    # initramfs zstd-19 (~60MB c/u), microcode (~10MB), systemd-boot binary (~2MB).
    # ESPs de 100MB se llenan al regenerar initramfs después → boot roto silencioso.
    local esp_free_mb
    esp_free_mb=$(df -BM --output=avail "${MOUNTPOINT}${EFI_MOUNTPOINT}" 2>/dev/null | tail -1 | tr -dc '0-9')
    if [[ -n "$esp_free_mb" && "$esp_free_mb" -lt 256 ]]; then
      print_danger "ESP en ${EFI_MOUNTPOINT} sólo tiene ${esp_free_mb}MB libres."
      print_danger "Se recomiendan ≥256MB para zen + linux-lts + initramfs + microcode."
      print_danger "Con esta ESP, regeneraciones futuras de initramfs pueden fallar y dejar el sistema sin boot."
      read_input_text "Continuar a tu propio riesgo?"
      [[ $OPTION != y ]] && error_msg "Aborted by user — repartition ESP con ≥512MB."
    fi

    arch_chroot "bootctl --esp-path=${EFI_MOUNTPOINT} install" \
      || error_msg "bootctl install falló; el sistema no quedaría booteable."

    local cmdline kernels k entry_path primary_entry_written
    cmdline=$(_kernel_cmdline)
    primary_entry_written=0

    # Detectar kernels instalados
    mapfile -t kernels < <(arch-chroot "${MOUNTPOINT}" bash -c 'ls /boot/vmlinuz-* 2>/dev/null | sed "s|/boot/vmlinuz-||"')

    # Detectar microcodes instalados → emitir sólo las líneas initrd que existen
    # (evita "Failed to read initrd" en cada boot por archivos fantasma).
    local ucode_lines=""
    [[ -f "${MOUNTPOINT}${EFI_MOUNTPOINT}/intel-ucode.img" ]] && ucode_lines+="initrd   /intel-ucode.img"$'\n'
    [[ -f "${MOUNTPOINT}${EFI_MOUNTPOINT}/amd-ucode.img"   ]] && ucode_lines+="initrd   /amd-ucode.img"$'\n'

    # loader.conf con timeout para acceder al menú
    mkdir -p "${MOUNTPOINT}${EFI_MOUNTPOINT}/loader/entries"
    cat > "${MOUNTPOINT}${EFI_MOUNTPOINT}/loader/loader.conf" <<EOF
default  arch.conf
timeout  3
console-mode max
editor   no
EOF

    # Entry primario (kernel zen u otro seleccionado)
    for k in "${kernels[@]}"; do
      [[ "$k" == "$KERNEL_PRIMARY" ]] || continue
      entry_path="${MOUNTPOINT}${EFI_MOUNTPOINT}/loader/entries/arch.conf"
      cat > "$entry_path" <<EOF
title    Arch Linux (${k})
linux    /vmlinuz-${k}
${ucode_lines}initrd   /initramfs-${k}.img
options  ${cmdline}
EOF
      primary_entry_written=1
    done
    [[ $primary_entry_written -ne 1 ]] && error_msg "No se generó arch.conf para ${KERNEL_PRIMARY}; revisa que ${KERNEL_PRIMARY} quedó instalado en /boot."

    # Entry de RESCUE para linux-lts (recovery, red de seguridad)
    if arch_chroot "pacman -Q linux-lts" >/dev/null 2>&1; then
      entry_path="${MOUNTPOINT}${EFI_MOUNTPOINT}/loader/entries/arch-lts.conf"
      cat > "$entry_path" <<EOF
title    Arch Linux (linux-lts) — RECOVERY
linux    /vmlinuz-linux-lts
${ucode_lines}initrd   /initramfs-linux-lts.img
options  ${cmdline}
EOF
    fi

    # Entry adicional de rescue mode (single user) sobre LTS
    entry_path="${MOUNTPOINT}${EFI_MOUNTPOINT}/loader/entries/rescue.conf"
    cat > "$entry_path" <<EOF
title    Arch Linux RESCUE (single user, LTS)
linux    /vmlinuz-linux-lts
${ucode_lines}initrd   /initramfs-linux-lts.img
options  ${cmdline} systemd.unit=rescue.target
EOF

    print_info "Permitir revisar los archivos del bootloader:"
    pause_function
    $EDITOR "${MOUNTPOINT}${EFI_MOUNTPOINT}/loader/loader.conf"
    $EDITOR "${MOUNTPOINT}${EFI_MOUNTPOINT}/loader/entries/arch.conf"
    ;;
  esac
  pause_function
}
#}}}
#ROOT PASSWORD {{{
root_password() {
  print_title "ROOT PASSWORD"
  print_warning "Enter your new root password"
  arch_chroot "passwd"
  pause_function
}
#}}}
#AUR HELPER {{{
install_aur_helper() {
  print_title "AUR HELPER"
  print_info "Instalando paru en Phase 1 para que setup/post-install puedan usar AUR si hace falta."

  local opts=("paru (recomendado)" "Skip")
  PS3="$prompt1"
  select OPT in "${opts[@]}"; do
    case "$OPT" in
      "paru (recomendado)") AUR_HELPER="paru"; break ;;
      "Skip") AUR_HELPER=""; return ;;
      *) invalid_option ;;
    esac
  done

  arch_chroot "pacman -S --needed --noconfirm base-devel git sudo"

  arch_chroot "id -u aurbuild >/dev/null 2>&1 || useradd -m -s /bin/bash aurbuild"
  mkdir -p "${MOUNTPOINT}"/etc/sudoers.d
  cat > "${MOUNTPOINT}"/etc/sudoers.d/90-aurbuild <<'EOF'
aurbuild ALL=(ALL) NOPASSWD: /usr/bin/pacman
EOF
  chmod 0440 "${MOUNTPOINT}"/etc/sudoers.d/90-aurbuild

  arch_chroot "sudo -u aurbuild bash -lc 'set -e; cd /tmp; rm -rf paru; git clone https://aur.archlinux.org/paru.git; cd paru; makepkg -si --noconfirm'"
  local ret=$?

  rm -f "${MOUNTPOINT}"/etc/sudoers.d/90-aurbuild
  arch_chroot "userdel -r aurbuild >/dev/null 2>&1 || true"

  [[ $ret -ne 0 ]] && error_msg "Installing paru failed. Check network/AUR/build output above."
  print_success "paru instalado en el sistema nuevo."
  pause_function
}
#}}}
#SAFETY NET DEL INSTALL {{{
# Red de seguridad pre-reboot: backup header LUKS, snapshot /etc, RECOVERY.md.
# NO es hardening de seguridad (eso lo hace aui-fortress por separado).
# Es la red para que el primer boot sea recuperable si algo va mal.
safety_net() {
  print_title "RED DE SEGURIDAD DEL INSTALL"
  print_info "Generando red de seguridad pre-reboot: header LUKS, baseline de /etc, RECOVERY.md."

  mkdir -p "${MOUNTPOINT}"/var/lib/aui-x
  mkdir -p "${MOUNTPOINT}"/root

  local hostname_val backup_path luks_dev
  hostname_val=$(cat "${MOUNTPOINT}"/etc/hostname 2>/dev/null || echo "arch")

  # Backup LUKS header (staging temporal en /root del sistema nuevo)
  if [[ $LUKS -eq 1 ]] && [[ -n "$LUKS_DISK" ]]; then
    luks_dev="/dev/${LUKS_DISK}"
    backup_path="${MOUNTPOINT}/root/luks-header-${hostname_val}.bin"
    print_info "Backup del header LUKS de ${luks_dev}"
    if cryptsetup luksHeaderBackup "$luks_dev" --header-backup-file "$backup_path"; then
      chmod 400 "$backup_path"
      print_success "Header LUKS staged en /root/luks-header-${hostname_val}.bin"
      print_danger "ADVERTENCIA: este archivo NO sirve si el disco muere."
      print_danger "Muévelo HOY a dos medios externos cifrados distintos y bórralo de /root tras verificar checksums."
    else
      print_warning "luksHeaderBackup falló; revisa manualmente tras reboot."
    fi
  else
    print_info "LUKS no detectado; saltando backup de header."
  fi

  # Snapshot baseline de /etc (referencia para comparación post-corrupción)
  print_info "Generando baseline de /etc..."
  arch_chroot "tar --zstd -cf /var/lib/aui-x/etc-baseline.tar.zst -C / etc 2>/dev/null" || \
    print_warning "Snapshot de /etc falló (no fatal)."

  # RECOVERY.md con procedimientos — bloques condicionales según layout real
  local luks_dev_hint="/dev/${LUKS_DISK:-<device>}"

  cat > "${MOUNTPOINT}"/root/RECOVERY.md <<RECOVERY_HEADER_EOF
# Recovery — aui-x base install

Layout detectado en este install:  LUKS=${LUKS}  LVM=${LVM}  LUKS_DEVICE=${luks_dev_hint}

## Si el sistema no bootea con kernel-zen

En el menú del bootloader selecciona la entrada \`linux-lts\`. Es el kernel de fallback
instalado SIEMPRE como red de seguridad.

## Procedimiento de chroot desde live USB
RECOVERY_HEADER_EOF

  if [[ $LUKS -eq 1 && $LVM -eq 1 ]]; then
    cat >> "${MOUNTPOINT}"/root/RECOVERY.md <<RECOVERY_LVMLUKS_EOF

Layout **LVM sobre LUKS** (default del proyecto):

1. Boot desde live USB de Arch.
2. Desbloquea el contenedor LUKS (passphrase del slot 0 — intacta tras fortress):
       cryptsetup open ${luks_dev_hint} cryptroot
3. Activa el volume group y monta el LV root:
       vgchange -ay lvm
       mount /dev/mapper/lvm-root /mnt
       # Si existe LV home separado:
       mount /dev/mapper/lvm-home /mnt/home 2>/dev/null || true
       # ESP (ajusta la partición):
       mount /dev/<esp-partition> /mnt/boot
4. Chroot:
       arch-chroot /mnt
RECOVERY_LVMLUKS_EOF
  elif [[ $LUKS -eq 1 ]]; then
    cat >> "${MOUNTPOINT}"/root/RECOVERY.md <<RECOVERY_LUKS_EOF

Layout **LUKS sin LVM**:

1. Boot desde live USB de Arch.
2. Desbloquea el contenedor LUKS (passphrase del slot 0 — intacta tras fortress):
       cryptsetup open ${luks_dev_hint} cryptroot
3. Monta root y ESP:
       mount /dev/mapper/cryptroot /mnt
       mount /dev/<esp-partition> /mnt/boot
4. Chroot:
       arch-chroot /mnt
RECOVERY_LUKS_EOF
  else
    cat >> "${MOUNTPOINT}"/root/RECOVERY.md <<'RECOVERY_PLAIN_EOF'

Layout **sin cifrado**:

1. Boot desde live USB de Arch.
2. Identifica root con `lsblk -f` (busca el FS donde está /etc).
3. Monta root y ESP:
       mount /dev/<root-partition> /mnt
       mount /dev/<esp-partition> /mnt/boot
4. Chroot:
       arch-chroot /mnt
RECOVERY_PLAIN_EOF
  fi

  cat >> "${MOUNTPOINT}"/root/RECOVERY.md <<'RECOVERY_COMMON_EOF'

## Si aui-fortress está instalado y bloquea el boot

Tras hacer chroot (pasos arriba), desactiva fortress:

    aui-fortress rollback --all

Sal del chroot y reinicia.

## Si pierdes el token FIDO2 o el USB de presence

Usa la passphrase del slot 0 (la que pusiste durante el install). Está SIEMPRE en slot 0;
ninguna operación de fortress la toca.

## Si pierdes la passphrase del slot 0

Necesitas el backup del header LUKS (luks-header-<hostname>.bin) que generó este install:

    cryptsetup luksHeaderRestore /dev/<device> --header-backup-file luks-header-<hostname>.bin

Luego usa la passphrase original de cuando se creó el header.

Si NO tienes el backup del header → datos perdidos. Por eso debe vivir en dos USB cifrados
externos, no en /root.

## Comandos útiles

- journalctl -b                                 logs del último boot
- bootctl list                                  entradas del bootloader systemd-boot
- cryptsetup luksDump /dev/<device>             estado de slots LUKS
- lsblk -f                                      filesystems y UUIDs
- vgs ; lvs                                     VGs y LVs activos
- ls /var/lib/aui-x/etc-baseline.tar.zst        snapshot de /etc al terminar el install
RECOVERY_COMMON_EOF
  chmod 600 "${MOUNTPOINT}"/root/RECOVERY.md

  # Verificación de los items — incluye checks LOAD-BEARING (sin estos no boota)
  print_info "Checklist de red de seguridad:"

  local boot_efi="${MOUNTPOINT}${EFI_MOUNTPOINT:-/boot}"
  local sb_binary="${boot_efi}/EFI/systemd/systemd-bootx64.efi"
  local entries_count
  entries_count=$(ls "${boot_efi}/loader/entries/"*.conf 2>/dev/null | wc -l)
  local kernel_present=NO
  [[ -f "${boot_efi}/vmlinuz-${KERNEL_PRIMARY:-linux-zen}" ]] && kernel_present=YES

  # LOAD-BEARING (sistema no boota sin esto)
  printf "  %-30s %s\n" "[BOOT] systemd-boot binary:" \
    "$([[ -f "$sb_binary" ]] && echo YES || echo "${BRed}NO — sistema NO booteará${Reset}")"
  printf "  %-30s %s\n" "[BOOT] loader entries:" \
    "$([[ "$entries_count" -gt 0 ]] && echo "YES ($entries_count)" || echo "${BRed}NO — sin entradas${Reset}")"
  printf "  %-30s %s\n" "[BOOT] kernel en ESP:" \
    "$kernel_present"
  printf "  %-30s %s\n" "[BOOT] root password set:" \
    "$(arch_chroot 'passwd -S root 2>/dev/null | grep -qE " P | NP " && echo YES || echo NO' 2>/dev/null || echo UNKNOWN)"

  # RECOVERY (puedes recuperar si algo falla)
  printf "  %-30s %s\n" "linux-lts instalado:" \
    "$(arch_chroot 'pacman -Q linux-lts' >/dev/null 2>&1 && echo YES || echo NO)"
  printf "  %-30s %s\n" "LUKS header staged:" \
    "$([[ -n "$backup_path" && -f "$backup_path" ]] && echo YES || echo SKIP)"
  printf "  %-30s %s\n" "/etc baseline:" \
    "$([[ -f "${MOUNTPOINT}/var/lib/aui-x/etc-baseline.tar.zst" ]] && echo YES || echo NO)"
  printf "  %-30s %s\n" "RECOVERY.md:" \
    "$([[ -f "${MOUNTPOINT}/root/RECOVERY.md" ]] && echo YES || echo NO)"

  # TUNING (no load-bearing, sólo confirma que se aplicó)
  printf "  %-30s %s\n" "ZRAM (auto al boot):" \
    "$([[ -f "${MOUNTPOINT}/etc/systemd/zram-generator.conf" ]] \
        && arch_chroot 'pacman -Q zram-generator' >/dev/null 2>&1 \
        && echo "YES (zstd, priority 100)" || echo NO)"
  printf "  %-30s %s\n" "Swap en disco:" \
    "none (ZRAM-only by design)"

  # Si algún [BOOT] falla, gritamos
  if [[ ! -f "$sb_binary" ]] || [[ "$entries_count" -eq 0 ]] || [[ "$kernel_present" != "YES" ]]; then
    print_danger ""
    print_danger "PELIGRO: el bootloader/ESP no quedó completo. Si reinicias ahora, NO booteará."
    print_danger "Vuelve al paso 12 (Install Bootloader) antes de continuar."
    print_danger ""
  fi
}
#}}}
#FINISH {{{
# Validación dura pre-reboot: si falta cualquier paso crítico el sistema no boota.
# Bug histórico: el usuario pulsaba 'd) Done' sin haber hecho 12) Bootloader o
# 13) Root Password y reiniciaba a una live ISO sin sistema instalable.
validate_critical_steps() {
  local missing=()
  [[ ${checklist[4]:-0}  -eq 1 ]] || missing+=("4)  Partition Scheme")
  [[ ${checklist[5]:-0}  -eq 1 ]] || missing+=("5)  Install Base System")
  [[ ${checklist[6]:-0}  -eq 1 ]] || missing+=("6)  Configure Fstab")
  [[ ${checklist[7]:-0}  -eq 1 ]] || missing+=("7)  Configure Hostname")
  [[ ${checklist[8]:-0}  -eq 1 ]] || missing+=("8)  Configure Timezone")
  [[ ${checklist[10]:-0} -eq 1 ]] || missing+=("10) Configure Locale")
  [[ ${checklist[11]:-0} -eq 1 ]] || missing+=("11) Configure Mkinitcpio")
  [[ ${checklist[12]:-0} -eq 1 ]] || missing+=("12) Install Bootloader")
  [[ ${checklist[13]:-0} -eq 1 ]] || missing+=("13) Root Password")

  if [[ ${#missing[@]} -gt 0 ]]; then
    print_danger "NO PUEDES REINICIAR: faltan pasos críticos sin los cuales el sistema no booteará."
    for m in "${missing[@]}"; do
      print_warning "  • $m"
    done
    print_warning "Vuelve al menú y completa estos pasos. Sin bootloader o sin root password el reboot manda a la live ISO."
    pause_function
    return 1
  fi
  return 0
}

finish() {
  print_title "INSTALL COMPLETED"

  # GUARD: bloquea reboot si faltan pasos críticos (caso típico de "rebooté y volví a la ISO")
  validate_critical_steps || return

  # Red de seguridad antes del reboot final (no es hardening; es recuperabilidad)
  safety_net

  # Copy del repo al sistema nuevo (referencia + setup post-boot)
  print_warning "\nA copy of this repository will be placed in /root/aui-x on your new system"
  mkdir -p "${MOUNTPOINT}"/root/aui-x
  cp -a "${PROJECT_ROOT}/." "${MOUNTPOINT}"/root/aui-x/
  print_warning "Si estás en VirtualBox/VM, desmonta la ISO o pon el disco instalado primero en el orden de boot antes de reiniciar."
  read_input_text "Reboot system"
  if [[ $OPTION == y ]]; then
    umount_partitions
    reboot
  fi
  exit 0
}
#}}}

