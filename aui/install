#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [[ -f "$SCRIPT_DIR/lib" ]]; then
  source "$SCRIPT_DIR/lib"
else
  echo "missing file: $SCRIPT_DIR/lib"
  exit 1
fi

install_live_deps() {
  local live_deps=()
  command -v nano      &>/dev/null || live_deps+=(nano)
  command -v reflector &>/dev/null || live_deps+=(reflector)

  if [[ ${#live_deps[@]} -gt 0 ]]; then
    pacman -Sy --noconfirm --needed "${live_deps[@]}" || {
      echo "FATAL: could not install live tools: ${live_deps[*]}" >&2
      exit 1
    }
  fi

  EDITOR="nano"
}

# Estado global de la instalación
declare -A state
state[checklist_1]=0
state[checklist_2]=0
state[checklist_3]=0
state[checklist_4]=0
state[checklist_5]=0
state[checklist_6]=0
state[checklist_7]=0
state[checklist_8]=0
state[checklist_9]=0
state[checklist_10]=0
state[checklist_11]=0
state[checklist_12]=0
state[keymap]=""
state[partition_layout]=""   # "luks" o "plain"
state[filesystem]=""
state[luks]=0                # si el root está cifrado
state[lvm]=0
state[luks_disk]=""          # dispositivo físico del root LUKS
state[luks_targets]=""       # particiones físicas cifradas
state[luks_mappers]=""       # nombres de mappers LUKS, alineados con luks_targets
state[root_luks_mapper]=""   # mapper LUKS usado para root
state[root_device]=""        # ruta final del dispositivo root (ej. /dev/mapper/cryptroot o /dev/sda2)
state[luks_devices]=""       # lista separada por espacios de mapeos creados (para referencia)
state[extra_mounts]=""       # particiones extra montadas durante el particionado
state[hostname]=""
state[timezone]=""
state[hwclock]=""
state[locale]=""
state[aur_helper]=""
state[fstab_type]=""
state[esp]=""

MOUNTPOINT="/mnt"

clear_luks_state() {
  state[luks]=0
  state[luks_disk]=""
  state[luks_targets]=""
  state[luks_mappers]=""
  state[root_luks_mapper]=""
  state[luks_devices]=""
}

# -------------------------------------------------------------------
# UI: Selección de teclado
# -------------------------------------------------------------------
select_keymap() {
  print_title "KEYMAP"
  PS3="$prompt1"
  print_info "Console keymap (editable post-install in /etc/vconsole.conf)."
  select KEYMAP in us la-latin1 es br-abnt2 pt-latin1 uk de-latin1 fr-latin1 it dvorak; do
    [[ -n "$KEYMAP" ]] && { loadkeys "$KEYMAP" && break; } || invalid_option
  done
  state[keymap]="$KEYMAP"
}

# -------------------------------------------------------------------
# UI: Configuración de mirrors
# -------------------------------------------------------------------
configure_mirrorlist() {
  print_title "MIRRORLIST"
  [[ -f /etc/pacman.d/mirrorlist ]] && cp /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak
  reflector --protocol https --latest 20 --fastest 10 --sort rate --save /etc/pacman.d/mirrorlist ||
    print_warning "reflector failed — using current mirrorlist"
  print_success "Mirrorlist generated."
}

# -------------------------------------------------------------------
# UI: Selección de dispositivo
# -------------------------------------------------------------------
select_device() {
  mapfile -t devices_list < <(lsblk -d | awk '{print "/dev/" $1}' | grep -E 'sd|hd|vd|nvme|mmcblk')
  if [[ ${#devices_list[@]} -eq 0 ]]; then
    print_error "No disks detected."
    return 1
  fi
  devices_list+=("Back")
  PS3="$prompt1"
  echo -e "Attached devices:\n"
  lsblk -lnp -I 2,3,8,9,22,34,56,57,58,65,66,67,68,69,70,71,72,91,128,129,130,131,132,133,134,135,259 | awk '{print $1,$4,$6,$7}' | column -t
  echo -e "\nSelect device to partition (or 'Back' to abort):\n"
  select device in "${devices_list[@]}"; do
    [[ "$device" == "Back" ]] && return 1
    [[ -n "$device" ]] && break
    invalid_option
  done
  state[device]="$device"
}

# -------------------------------------------------------------------
# NUEVO: Selección de encriptación (post-cfdisk)
# -------------------------------------------------------------------
select_encryption_targets() {
  print_title "ENCRYPTION TARGETS"
  mapfile -t all_parts < <(lsblk -lnpo NAME,TYPE | awk '$2=="part"{print $1}')
  local encryptable=()
  for part in "${all_parts[@]}"; do
    is_efi_system_partition "$part" && continue
    encryptable+=("$part")
  done

  if [[ ${#encryptable[@]} -eq 0 ]]; then
    print_info "No encryptable partitions found."
    state[partition_layout]="plain"
    clear_luks_state
    return 0
  fi

  print_info "Mark which partitions to encrypt (e.g., 1 3). Unmarked remain plain."
  PS3="$prompt1"
  echo "Available partitions:"
  for i in "${!encryptable[@]}"; do
    echo "  $((i+1))) ${encryptable[i]}"
  done
  echo "  a) Encrypt ALL"
  echo "  n) None (skip encryption)"
  echo "  b) Back"
  read -rp "Your choice: " choice
  case "$choice" in
    a)
      state[partition_layout]="luks"
      state[luks_targets]="${encryptable[*]}"
      ;;
    n)
      state[partition_layout]="plain"
      clear_luks_state
      ;;
    b)
      return 1
      ;;
    *)
      local indices
      IFS=' ' read -ra indices <<< "$choice"
      local selected=()
      for idx in "${indices[@]}"; do
        if [[ "$idx" =~ ^[0-9]+$ ]] && (( idx >= 1 && idx <= ${#encryptable[@]} )); then
          selected+=("${encryptable[idx-1]}")
        fi
      done
      if [[ ${#selected[@]} -eq 0 ]]; then
        print_warning "No valid partitions selected."
        return 1
      fi
      state[partition_layout]="luks"
      state[luks_targets]="${selected[*]}"
      ;;
  esac

  # Si hay targets, ejecutar LUKS format en cada uno
  if [[ "${state[partition_layout]}" == "luks" && -n "${state[luks_targets]}" ]]; then
    local -a targets
    IFS=' ' read -ra targets <<< "${state[luks_targets]}"
    local mapper_list=()
    local mapper_names=()
    for part in "${targets[@]}"; do
      local mapper_name mapper_path
      mapper_name="crypt_$(basename "$part" | tr -c '[:alnum:]' '_')"
      mapper_name="${mapper_name%_}"
      print_info "Formatting LUKS on $part (mapper: $mapper_name)"
      mapper_path=$(luks_format "$part" "$TRIM" "$mapper_name") || {
        print_error "LUKS format failed for $part"
        return 1
      }
      mapper_list+=("$mapper_path")
      mapper_names+=("$mapper_name")
    done
    state[luks_devices]="${mapper_list[*]}"
    state[luks_mappers]="${mapper_names[*]}"
    # El primer dispositivo se asume como posible root, pero se elegirá luego
    state[luks]=1
  else
    clear_luks_state
  fi
}

# -------------------------------------------------------------------
# UI: Selección de root (entre dispositivos disponibles)
# -------------------------------------------------------------------
choose_root_device() {
  local -a candidates
  if [[ ${state[luks]} -eq 1 ]]; then
    IFS=' ' read -ra candidates <<< "${state[luks_devices]}"
  else
    mapfile -t all_parts < <(lsblk -lnpo NAME,TYPE | awk '$2=="part"{print $1}')
    for part in "${all_parts[@]}"; do
      is_efi_system_partition "$part" && continue
      candidates+=("$part")
    done
  fi

  if [[ ${#candidates[@]} -eq 0 ]]; then
    print_error "No root candidates found."
    return 1
  fi

  candidates+=("Cancel")
  PS3="$prompt1"
  echo "Select root device:"
  select root_dev in "${candidates[@]}"; do
    [[ "$root_dev" == "Cancel" ]] && return 1
    [[ -n "$root_dev" ]] && break
    invalid_option
  done

  # Si el root está cifrado, guardar también el disco físico subyacente para el cmdline
  if [[ ${state[luks]} -eq 1 ]]; then
    local -a luks_targets luks_devices luks_mappers
    local i
    IFS=' ' read -ra luks_targets <<< "${state[luks_targets]}"
    IFS=' ' read -ra luks_devices <<< "${state[luks_devices]}"
    IFS=' ' read -ra luks_mappers <<< "${state[luks_mappers]}"

    state[root_device]="$root_dev"
    state[luks_disk]=""
    state[root_luks_mapper]=""
    for i in "${!luks_devices[@]}"; do
      if [[ "${luks_devices[i]}" == "$root_dev" ]]; then
        state[luks_disk]="${luks_targets[i]}"
        state[root_luks_mapper]="${luks_mappers[i]}"
        break
      fi
    done
    if [[ -z "${state[luks_disk]}" || -z "${state[root_luks_mapper]}" ]]; then
      print_error "Could not map encrypted root $root_dev back to its LUKS partition."
      return 1
    fi
  else
    state[root_device]="$root_dev"
    state[luks_disk]=""
    state[root_luks_mapper]=""
  fi
}

# -------------------------------------------------------------------
# Paso 2: Particionado completo (orquestador)
# -------------------------------------------------------------------
step_partitioning() {
  umount_partitions
  clear_luks_state
  state[lvm]=0
  state[root_device]=""
  state[filesystem]=""
  state[esp]=""
  state[extra_mounts]=""

  select_device || return 1

  print_info "Launching cfdisk on ${state[device]}"
  partition_disk_cfdisk "${state[device]}" || {
    print_error "Partition editor failed or was cancelled."
    return 1
  }

  select_encryption_targets || return 1

  choose_root_device || return 1

  # Preguntar si quiere LVM sobre el root (solo si es LUKS y el usuario quiere)
  if [[ ${state[luks]} -eq 1 ]]; then
    read_input_text "Use LVM on top of the encrypted root?"
    if [[ $OPTION == y ]]; then
      local vg_name="lvm"
      local lv_name="root"
      local new_root
      new_root=$(setup_lvm "${state[root_device]}" "$vg_name" "$lv_name") || {
        print_error "LVM setup failed"
        return 1
      }
      state[root_device]="$new_root"
      state[lvm]=1
    fi
  fi

  choose_filesystem || return 1

  print_info "Formatting and mounting root"
  format_and_mount_root "${state[root_device]}" "${state[filesystem]}" "$MOUNTPOINT" "$TRIM" || {
    print_error "Root format/mount failed"
    return 1
  }

  # Montar EFI
  local esp_part
  mapfile -t esp_parts < <(lsblk -lnpo NAME,TYPE | awk '$2=="part"{print $1}')
  local esp_candidates=()
  for part in "${esp_parts[@]}"; do
    is_efi_system_partition "$part" && esp_candidates+=("$part")
  done
  if [[ ${#esp_candidates[@]} -eq 0 ]]; then
    print_error "No EFI system partition found. Create one (FAT32, type EF00) in cfdisk."
    return 1
  fi
  esp_candidates+=("Cancel")
  PS3="$prompt1"
  echo "Select EFI system partition:"
  select esp in "${esp_candidates[@]}"; do
    [[ "$esp" == "Cancel" ]] && return 1
    [[ -n "$esp" ]] && break
    invalid_option
  done
  read_input_text "Format $esp as FAT32?"
  if [[ $OPTION == y ]]; then
    mkfs.vfat -F32 "$esp" || { print_error "mkfs.vfat failed"; return 1; }
  fi
  mkdir -p "$MOUNTPOINT/boot"
  mount_vfat "$esp" "$MOUNTPOINT/boot" || { print_error "ESP mount failed"; return 1; }
  state[esp]="$esp"

  mount_extra_partitions || return 1
}

choose_extra_filesystem() {
  local fss=("ext4" "btrfs" "vfat" "Back")
  PS3="$prompt1"
  select fs in "${fss[@]}"; do
    [[ "$fs" == "Back" ]] && return 1
    [[ -n "$fs" ]] && { extra_fs="$fs"; return 0; }
    invalid_option
  done
}

mount_extra_partitions() {
  local candidates part mount_dir target format_choice extra_fs

  while true; do
    mapfile -t candidates < <(list_extra_candidates "$MOUNTPOINT" "${state[root_device]}" "${state[esp]}" "${state[luks_disk]}" "${state[luks_targets]}")
    if [[ ${#candidates[@]} -eq 0 ]]; then
      print_info "No extra partitions available to mount."
      return 0
    fi

    read_input_text "Mount another existing partition/disk now?"
    [[ $OPTION == y ]] || return 0

    candidates+=("Cancel")
    PS3="$prompt1"
    echo "Select extra partition:"
    select part in "${candidates[@]}"; do
      [[ "$part" == "Cancel" ]] && return 0
      [[ -n "$part" ]] && break
      invalid_option
    done

    while true; do
      read -rp "Mount point inside the new system [e.g. /home, /home/media, /data]: " mount_dir
      if [[ "$mount_dir" == /* && "$mount_dir" != "/" && "$mount_dir" != "/boot" && "$mount_dir" != "/boot/efi" ]]; then
        break
      fi
      print_warning "Use an absolute mount point below /, but not /, /boot, or /boot/efi."
    done

    target="$MOUNTPOINT$mount_dir"
    if findmnt -n "$target" &>/dev/null; then
      read_input_text "$mount_dir is already mounted by the root layout. Replace that mount?"
      [[ $OPTION == y ]] || continue
      umount "$target" || { print_error "Could not unmount $target"; return 1; }
    fi

    read_input_text "Format $part before mounting? This erases data."
    format_choice="$OPTION"
    if [[ "$format_choice" == y ]]; then
      choose_extra_filesystem || continue
      format_and_mount_extra "$part" "$extra_fs" "$target" "$TRIM" || {
        print_error "Could not format and mount $part on $mount_dir"
        return 1
      }
    else
      mount_extra "$part" "$target" || {
        print_error "Could not mount $part on $mount_dir"
        return 1
      }
    fi

    state[extra_mounts]="${state[extra_mounts]}${part}:${mount_dir} "
    print_success "$part mounted on $mount_dir"
  done
}

# -------------------------------------------------------------------
# UI: Elegir sistema de archivos
# -------------------------------------------------------------------
choose_filesystem() {
  local fss=("btrfs" "ext4" "Back")
  PS3="$prompt1"
  print_info "btrfs (recommended): snapshots, zstd compress."
  print_info "ext4: conservative, no snapshots."
  select fs in "${fss[@]}"; do
    [[ "$fs" == "Back" ]] && return 1
    [[ -n "$fs" ]] && { state[filesystem]="$fs"; return 0; }
    invalid_option
  done
}

# -------------------------------------------------------------------
# Paso 3: Instalación base
# -------------------------------------------------------------------
step_base_install() {
  print_title "INSTALL BASE SYSTEM"
  timedatectl set-ntp true 2>/dev/null || true
  pacman -Sy --noconfirm archlinux-keyring

  print_info "pacstrap..."
  pacstrap -K "$MOUNTPOINT" base base-devel linux-zen linux-zen-headers linux-lts linux-lts-headers \
    linux-firmware intel-ucode amd-ucode cryptsetup lvm2 networkmanager iwd \
    pipewire pipewire-pulse pipewire-alsa pipewire-jack wireplumber \
    btrfs-progs dosfstools e2fsprogs vim nano man-db man-pages git sudo \
    reflector pacman-contrib zram-generator nftables iputils inetutils parted efibootmgr || {
    print_error "pacstrap failed"; return 1
  }

  arch_chroot systemctl enable NetworkManager.service
  arch_chroot systemctl enable systemd-resolved.service
  arch_chroot systemctl enable systemd-timesyncd.service
  arch_chroot systemctl enable fstrim.timer
  arch_chroot systemctl enable systemd-oomd.service
  arch_chroot systemctl enable paccache.timer
  arch_chroot systemctl enable reflector.timer 2>/dev/null || true
  arch_chroot systemctl enable nftables.service

  write_zen_tuning "$MOUNTPOINT"
  ln -sf /run/systemd/resolve/stub-resolv.conf "$MOUNTPOINT"/etc/resolv.conf
  configure_keymap
}

configure_keymap() {
  echo "KEYMAP=${state[keymap]}" > "$MOUNTPOINT/etc/vconsole.conf"
}

# -------------------------------------------------------------------
# Pasos siguientes (sin cambios relevantes)
# -------------------------------------------------------------------
step_fstab() {
  print_title "FSTAB"
  if [[ -f "$MOUNTPOINT/etc/fstab.aui" ]]; then
    cp "$MOUNTPOINT"/etc/fstab.aui "$MOUNTPOINT"/etc/fstab
  else
    mkdir -p "$MOUNTPOINT/etc"
    : > "$MOUNTPOINT"/etc/fstab
    cp "$MOUNTPOINT"/etc/fstab "$MOUNTPOINT"/etc/fstab.aui
  fi
  print_info "Generating fstab with PARTUUID (UEFI)"
  genfstab -t PARTUUID -p "$MOUNTPOINT" >> "$MOUNTPOINT"/etc/fstab || {
    print_error "genfstab failed"; return 1
  }
  state[fstab_type]="PARTUUID"
  print_success "/etc/fstab generated"
}

step_hostname() {
  print_title "HOSTNAME"
  while true; do
    read -rp "Hostname [e.g. arch-laptop]: " host
    [[ "$host" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] && break
    print_warning "Invalid hostname"
  done
  echo "$host" > "$MOUNTPOINT"/etc/hostname
  if [[ ! -f "$MOUNTPOINT/etc/hosts.aui" ]]; then
    cp "$MOUNTPOINT"/etc/hosts "$MOUNTPOINT"/etc/hosts.aui
  else
    cp "$MOUNTPOINT"/etc/hosts.aui "$MOUNTPOINT"/etc/hosts
  fi
  arch_chroot sed -i "/127.0.0.1/s/\$/ $host/" /etc/hosts
  arch_chroot sed -i "/::1/s/\$/ $host/" /etc/hosts
  state[hostname]="$host"
}

step_timezone() {
  print_title "TIMEZONE"
  OPTION=n
  while [[ $OPTION != y ]]; do
    settimezone
    read_input_text "Confirm timezone (${ZONE}/${SUBZONE})"
  done
  arch_chroot ln -sf "/usr/share/zoneinfo/${ZONE}/${SUBZONE}" /etc/localtime
  arch_chroot sed -i '/#NTP=/d' /etc/systemd/timesyncd.conf
  arch_chroot sed -i 's/#Fallback//' /etc/systemd/timesyncd.conf
  arch_chroot "echo \"FallbackNTP=0.pool.ntp.org 1.pool.ntp.org 0.fr.pool.ntp.org\" >> /etc/systemd/timesyncd.conf"
  arch_chroot systemctl enable systemd-timesyncd.service
}

step_hardwareclock() {
  print_title "HARDWARE CLOCK"
  local opts=("UTC" "Localtime")
  PS3="$prompt1"
  select OPT in "${opts[@]}"; do
    case "$REPLY" in
      1) arch_chroot hwclock --systohc --utc; state[hwclock]="UTC" ;;
      2) arch_chroot hwclock --systohc --localtime; state[hwclock]="Localtime" ;;
      *) invalid_option ;;
    esac
    [[ -n "$OPT" ]] && break
  done
}

step_locale() {
  print_title "LOCALE"
  OPTION=n
  while [[ $OPTION != y ]]; do
    setlocale
    read_input_text "Confirm locale ($LOCALE)"
  done
  echo "LANG=\"$LOCALE_UTF8\"" > "$MOUNTPOINT"/etc/locale.conf
  arch_chroot sed -i "s/#\\(${LOCALE_UTF8}\\)/\\1/" /etc/locale.gen
  arch_chroot locale-gen
}

step_mkinitcpio() {
  print_title "MKINITCPIO"
  if [[ ! -f "$MOUNTPOINT/etc/mkinitcpio.conf" ]]; then
    print_error "mkinitcpio.conf missing"; return 1
  fi
  local hooks="base systemd autodetect microcode modconf kms keyboard sd-vconsole block"
  [[ ${state[luks]} -eq 1 ]] && hooks="$hooks sd-encrypt"
  [[ ${state[lvm]} -eq 1 ]] && hooks="$hooks lvm2"
  hooks="$hooks filesystems fsck"
  sed -i "s/^HOOKS=.*/HOOKS=($hooks)/" "$MOUNTPOINT"/etc/mkinitcpio.conf
  sed -i 's/^#\?COMPRESSION=.*/COMPRESSION="zstd"/' "$MOUNTPOINT"/etc/mkinitcpio.conf
  sed -i 's/^#\?COMPRESSION_OPTIONS=.*/COMPRESSION_OPTIONS=(-19 -T0)/' "$MOUNTPOINT"/etc/mkinitcpio.conf
  arch_chroot mkinitcpio -P || { print_error "mkinitcpio failed"; return 1; }
}

step_bootloader() {
  print_title "SYSTEMD-BOOT"
  if [[ "$UEFI" -ne 1 ]]; then
    print_error "Only UEFI is supported"; return 1
  fi

  local esp_mount="$MOUNTPOINT/boot"
  local esp_dev esp_free_mb esp_parttype
  esp_dev=$(findmnt -no SOURCE "$esp_mount" 2>/dev/null || true)
  if [[ -z "$esp_dev" ]]; then
    print_error "ESP is not mounted at /boot. Mount the EFI System Partition at $esp_mount."
    return 1
  fi

  if [[ -n "${state[esp]}" && "$esp_dev" != "${state[esp]}" ]]; then
    print_warning "Mounted ESP ($esp_dev) differs from selected ESP (${state[esp]}). Using mounted ESP."
    state[esp]="$esp_dev"
  fi

  esp_free_mb=$(df -BM --output=avail "$esp_mount" 2>/dev/null | tail -1 | tr -dc '0-9')
  if [[ -n "$esp_free_mb" && "$esp_free_mb" -lt 256 ]]; then
    print_danger "ESP at /boot has only ${esp_free_mb}MB free."
    print_danger "Recommended: 256MB+ for zen + linux-lts + initramfs + microcode."
    read_input_text "Continue at your own risk?"
    [[ $OPTION == y ]] || return 1
  fi

  esp_parttype=$(lsblk -no PARTTYPE "$esp_dev" 2>/dev/null | head -1 | tr '[:upper:]' '[:lower:]')
  if [[ "$esp_parttype" != "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" && "$esp_parttype" != "0xef" ]]; then
    print_error "$esp_dev is not marked as an EFI System Partition. Firmware may boot back to the live ISO."
    print_warning "In cfdisk, set the ESP type to EFI System, write changes, then mount it at /boot."
    return 1
  fi

  arch_chroot bootctl --esp-path=/boot install --graceful || { print_error "bootctl failed"; return 1; }

  local cmdline="root=${state[root_device]} rw"
  [[ "${state[filesystem]}" == "btrfs" ]] && cmdline="$cmdline rootflags=subvol=@"
  if [[ ${state[luks]} -eq 1 ]]; then
    local luks_uuid
    luks_uuid=$(blkid -s UUID -o value "${state[luks_disk]}" 2>/dev/null)
    if [[ -z "$luks_uuid" ]]; then
      print_error "Could not read LUKS UUID from ${state[luks_disk]}."
      return 1
    fi
    if [[ -z "${state[root_luks_mapper]}" ]]; then
      print_error "Missing root LUKS mapper name."
      return 1
    fi
    cmdline="rd.luks.name=${luks_uuid}=${state[root_luks_mapper]} $cmdline"
    [[ $TRIM -eq 1 ]] && cmdline="rd.luks.options=discard $cmdline"
  fi
  [[ ${state[lvm]} -eq 1 ]] && cmdline="$cmdline rd.lvm.vg=lvm rd.lvm.lv=lvm/root"
  cmdline="$cmdline amd_pstate=active split_lock_detect=off nowatchdog nvme_core.default_ps_max_latency_us=5500 quiet loglevel=3"

  local ucode=""
  [[ -f "$MOUNTPOINT/boot/intel-ucode.img" ]] && ucode+="initrd   /intel-ucode.img"$'\n'
  [[ -f "$MOUNTPOINT/boot/amd-ucode.img"   ]] && ucode+="initrd   /amd-ucode.img"$'\n'

  generate_loader_entries "$MOUNTPOINT" "/boot" "linux-zen" "$cmdline" "$ucode"

  local sb_bin="$MOUNTPOINT/boot/EFI/systemd/systemd-bootx64.efi"
  local fallback="$MOUNTPOINT/boot/EFI/BOOT/BOOTX64.EFI"
  if [[ ! -f "$sb_bin" ]]; then
    print_error "systemd-boot EFI binary missing after bootctl: $sb_bin"
    return 1
  fi
  mkdir -p "$(dirname "$fallback")"
  if [[ ! -f "$fallback" ]] || ! cmp -s "$sb_bin" "$fallback"; then
    cp "$sb_bin" "$fallback" || { print_error "Could not write fallback EFI"; return 1; }
  fi

  local arch_entry="$MOUNTPOINT/boot/loader/entries/arch.conf"
  [[ -f "$arch_entry" ]] || { print_error "Missing systemd-boot entry: $arch_entry"; return 1; }
  grep -Fq "root=${state[root_device]}" "$arch_entry" || {
    print_error "Boot entry does not point to root ${state[root_device]}."
    return 1
  }
  if [[ ${state[luks]} -eq 1 ]]; then
    grep -Eq "rd[.]luks[.]name=[^ ]+=${state[root_luks_mapper]}( |$)" "$arch_entry" || {
      print_error "Boot entry is missing the root LUKS mapping ${state[root_luks_mapper]}."
      return 1
    }
  fi
  if [[ ${state[lvm]} -eq 1 ]]; then
    grep -Fq "rd.lvm.lv=lvm/root" "$arch_entry" || {
      print_error "Boot entry is missing the LVM root activation."
      return 1
    }
  fi

  configure_efi_nvram "$esp_dev"
  print_success "Bootloader configured"
}

configure_efi_nvram() {
  local esp_dev="$1"
  local disk part_num bm_out bootnum current_order new_order entry

  if [[ ! -d /sys/firmware/efi/efivars ]]; then
    print_warning "efivarfs not available; boot will rely on /EFI/BOOT/BOOTX64.EFI fallback."
    return 0
  fi

  disk=$(lsblk -no PKNAME "$esp_dev" 2>/dev/null | head -1)
  part_num=$(lsblk -no PARTN "$esp_dev" 2>/dev/null | head -1)
  if [[ -z "$disk" || -z "$part_num" ]]; then
    print_warning "Could not resolve disk/partition for $esp_dev; fallback BOOTX64.EFI is present."
    return 0
  fi

  arch_chroot "efibootmgr --create --disk /dev/${disk} --part ${part_num} --label 'Linux Boot Manager' --loader '\\EFI\\systemd\\systemd-bootx64.efi'" \
    || print_warning "efibootmgr could not create/update NVRAM entry; fallback BOOTX64.EFI is present."

  bm_out=$(arch_chroot "efibootmgr -v 2>/dev/null" 2>/dev/null || true)
  bootnum=$(awk '
    BEGIN { IGNORECASE=1 }
    /Linux Boot Manager/ && /EFI\\systemd\\systemd-bootx64\.efi/ {
      sub(/^Boot/, "", $1)
      sub(/\*.*/, "", $1)
      boot=$1
    }
    END { print boot }
  ' <<< "$bm_out")

  if [[ -z "$bootnum" ]]; then
    print_warning "NVRAM entry is not visible in efibootmgr; fallback BOOTX64.EFI is present."
    return 0
  fi

  arch_chroot "efibootmgr --bootnext ${bootnum}" \
    || print_warning "Could not set BootNext=${bootnum}; firmware should still see fallback BOOTX64.EFI."

  current_order=$(awk -F': ' '/^BootOrder:/ {print $2; exit}' <<< "$bm_out")
  if [[ -n "$current_order" && "$current_order" != "$bootnum"* ]]; then
    new_order="$bootnum"
    for entry in ${current_order//,/ }; do
      [[ "$entry" == "$bootnum" ]] && continue
      new_order="${new_order},${entry}"
    done
    arch_chroot "efibootmgr --bootorder ${new_order}" \
      || print_warning "Could not move Linux Boot Manager first in BootOrder."
  fi

  print_success "NVRAM entry checked: Boot${bootnum} (Linux Boot Manager)"
}

step_root_password() {
  print_title "ROOT PASSWORD"
  arch_chroot passwd || { print_error "password failed"; return 1; }
}

step_aur_helper() {
  print_title "AUR HELPER"
  local opts=("paru (recommended)" "Skip")
  PS3="$prompt1"
  select OPT in "${opts[@]}"; do
    case "$OPT" in
      "paru (recommended)") state[aur_helper]="paru"; break ;;
      "Skip") state[aur_helper]=""; return 0 ;;
      *) invalid_option ;;
    esac
  done

  arch_chroot pacman -S --needed --noconfirm base-devel git sudo
  arch_chroot "id -u aurbuild &>/dev/null || useradd -m -s /bin/bash aurbuild"
  cat > "$MOUNTPOINT"/etc/sudoers.d/90-aurbuild <<'EOF'
aurbuild ALL=(ALL) NOPASSWD: /usr/bin/pacman
EOF
  chmod 0440 "$MOUNTPOINT"/etc/sudoers.d/90-aurbuild
  arch_chroot "sudo -u aurbuild bash -lc 'cd /tmp; rm -rf paru; git clone https://aur.archlinux.org/paru.git; cd paru; makepkg -si --noconfirm'"
  rm -f "$MOUNTPOINT"/etc/sudoers.d/90-aurbuild
  arch_chroot "userdel -r aurbuild &>/dev/null"
  print_success "paru installed"
}

# -------------------------------------------------------------------
# Finalización y seguridad
# -------------------------------------------------------------------
validate_critical_steps() {
  local missing=()
  [[ ${state[checklist_1]} -eq 1 ]] || missing+=("1) Initial Setup")
  [[ ${state[checklist_2]} -eq 1 ]] || missing+=("2) Partition Scheme")
  [[ ${state[checklist_3]} -eq 1 ]] || missing+=("3) Install Base System")
  [[ ${state[checklist_4]} -eq 1 ]] || missing+=("4) Configure Fstab")
  [[ ${state[checklist_5]} -eq 1 ]] || missing+=("5) Configure Hostname")
  [[ ${state[checklist_6]} -eq 1 ]] || missing+=("6) Configure Timezone")
  [[ ${state[checklist_8]} -eq 1 ]] || missing+=("8) Configure Locale")
  [[ ${state[checklist_9]} -eq 1 ]] || missing+=("9) Configure Mkinitcpio")
  [[ ${state[checklist_10]} -eq 1 ]] || missing+=("10) Install Bootloader")
  [[ ${state[checklist_11]} -eq 1 ]] || missing+=("11) Root Password")
  if [[ ${#missing[@]} -gt 0 ]]; then
    print_danger "CANNOT REBOOT: critical steps missing:"
    for m in "${missing[@]}"; do print_warning "  $m"; done
    pause_function
    return 1
  fi
}

safety_net() {
  print_title "INSTALL SAFETY NET"
  mkdir -p "$MOUNTPOINT"/var/lib/aui-x "$MOUNTPOINT"/root
  local hostname_val="${state[hostname]:-arch}"
  if [[ ${state[luks]} -eq 1 && -n "${state[luks_disk]}" ]]; then
    local backup="$MOUNTPOINT/root/luks-header-${hostname_val}.bin"
    print_info "Backing up LUKS header"
    cryptsetup luksHeaderBackup "${state[luks_disk]}" --header-backup-file "$backup" || print_warning "LUKS header backup failed"
    chmod 400 "$backup"
  fi
  print_info "Creating /etc baseline"
  arch_chroot tar --zstd -cf /var/lib/aui-x/etc-baseline.tar.zst -C / etc || print_warning "baseline failed"

  cat > "$MOUNTPOINT"/root/RECOVERY.md <<EOF
# Recovery - aui-x install

LUKS=${state[luks]} LVM=${state[lvm]} LUKS_DISK=${state[luks_disk]:-NONE}
ROOT_LUKS_MAPPER=${state[root_luks_mapper]:-cryptroot}
Root: ${state[root_device]}
Extra mounts: ${state[extra_mounts]:-none}

## Chroot (live USB)
cryptsetup open ${state[luks_disk]:-<device>} ${state[root_luks_mapper]:-cryptroot}
vgchange -ay
mount ${state[root_device]} /mnt
mount /dev/<esp> /mnt/boot
arch-chroot /mnt

## If fortress blocks boot: aui-fortress rollback --all
EOF
  chmod 600 "$MOUNTPOINT"/root/RECOVERY.md
}

finish() {
  print_title "INSTALL COMPLETED"
  validate_critical_steps || return
  safety_net
  print_warning "Copy of AUI-X placed in /root/aui-x"
  mkdir -p "$MOUNTPOINT"/root/aui-x
  cp -a "$PROJECT_ROOT/." "$MOUNTPOINT"/root/aui-x/
  read_input_text "Reboot system"
  if [[ $OPTION == y ]]; then
    umount_partitions
    reboot
  fi
  exit 0
}

# -------------------------------------------------------------------
# Menú principal
# -------------------------------------------------------------------
initial_setup() {
  select_keymap && configure_mirrorlist
}

umount_partitions() {
  mapfile -t mp < <(findmnt -R -n -o TARGET "$MOUNTPOINT" 2>/dev/null | tac)
  swapoff -a 2>/dev/null || true
  for m in "${mp[@]}"; do
    umount "$m" 2>/dev/null || umount -l "$m" 2>/dev/null || true
  done
  vgchange -an lvm 2>/dev/null || true
  for mapper in ${state[luks_mappers]:-}; do
    cryptsetup close "$mapper" 2>/dev/null || true
  done
  cryptsetup close cryptroot 2>/dev/null || true
}

run_step() {
  local num="$1" desc="$2"
  shift 2
  if "$@"; then
    state["checklist_$num"]=1
    print_success "Step $num ($desc) completed."
  else
    print_error "Step $num ($desc) failed."
  fi
  pause_function
}

main() {
install_live_deps
check_root
check_archlinux
check_boot_system
check_connection
check_trim
pacman -Sy

PS3="$prompt1"
prompt1="> "

while true; do
  print_title "ARCHLINUX ULTIMATE INSTALL"
  echo " 1) $(mainmenu_item "${state[checklist_1]}" "Initial Setup (keymap + mirrors)" "${state[keymap]}")"
  echo " 2) $(mainmenu_item "${state[checklist_2]}" "Partition Scheme" "${state[partition_layout]} ${state[filesystem]} ${state[extra_mounts]}")"
  echo " 3) $(mainmenu_item "${state[checklist_3]}" "Install Base System")"
  echo " 4) $(mainmenu_item "${state[checklist_4]}" "Configure Fstab" "${state[fstab_type]}")"
  echo " 5) $(mainmenu_item "${state[checklist_5]}" "Configure Hostname" "${state[hostname]}")"
  echo " 6) $(mainmenu_item "${state[checklist_6]}" "Configure Timezone" "${ZONE}/${SUBZONE}")"
  echo " 7) $(mainmenu_item "${state[checklist_7]}" "Configure Hardware Clock" "${state[hwclock]}")"
  echo " 8) $(mainmenu_item "${state[checklist_8]}" "Configure Locale" "${LOCALE}")"
  echo " 9) $(mainmenu_item "${state[checklist_9]}" "Configure Mkinitcpio")"
  echo "10) $(mainmenu_item "${state[checklist_10]}" "Install Bootloader")"
  echo "11) $(mainmenu_item "${state[checklist_11]}" "Root Password")"
  echo "12) $(mainmenu_item "${state[checklist_12]}" "AUR helper" "${state[aur_helper]}")"
  echo ""
  echo " d) Done"
  echo ""
  read_input_options
  for OPT in "${OPTIONS[@]}"; do
    case "$OPT" in
      1)  run_step 1  "Initial Setup"          initial_setup ;;
      2)  run_step 2  "Partition Scheme"       step_partitioning ;;
      3)  run_step 3  "Install Base System"    step_base_install ;;
      4)  run_step 4  "Configure Fstab"        step_fstab ;;
      5)  run_step 5  "Configure Hostname"     step_hostname ;;
      6)  run_step 6  "Configure Timezone"     step_timezone ;;
      7)  run_step 7  "Configure Hardware Clock" step_hardwareclock ;;
      8)  run_step 8  "Configure Locale"       step_locale ;;
      9)  run_step 9  "Configure Mkinitcpio"   step_mkinitcpio ;;
      10) run_step 10 "Install Bootloader"     step_bootloader ;;
      11) run_step 11 "Root Password"          step_root_password ;;
      12) run_step 12 "AUR Helper"             step_aur_helper ;;
      "d") finish ;;
      *)   invalid_option ;;
    esac
  done
done

}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
