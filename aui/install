  echo "14) $(mainmenu_item "${checklist[14]}" "AUR helper" "${AUR_HELPER:-}")"
  echo ""
  echo " d) Done"
  echo ""
  read_input_options
  for OPT in "${OPTIONS[@]}"; do
    case "$OPT" in
    1)
      select_keymap
