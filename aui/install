  arch_chroot "sed -i 's/#\('${LOCALE_UTF8}'\)/\1/' /etc/locale.gen"
  arch_chroot "locale-gen"
}
#}}}
#CONFIGURE MKINITCPIO {{{
configure_mkinitcpio() {
  print_title "MKINITCPIO - https://wiki.archlinux.org/index.php/Mkinitcpio"

  if [[ ! -f "${MOUNTPOINT}/etc/mkinitcpio.conf" ]]; then
    print_error "${MOUNTPOINT}/etc/mkinitcpio.conf missing."
    print_warning "This step depends on step 3 (Install Base System). Run it first."
    return 1
  fi
  if ! arch_chroot "command -v mkinitcpio >/dev/null 2>&1"; then
    print_error "mkinitcpio binary missing in ${MOUNTPOINT}. Pacstrap incomplete?"
    return 1
  fi

  print_info "Configuring initramfs: sd-encrypt (systemd LUKS) + lvm2 (legacy udev, more reliable)."

  # sd-lvm2 has recurring bugs (2024-2026) where VG doesn't activate post-LUKS-unlock
  # ("Timed out waiting for /dev/mapper/<vg>-<lv>"). Legacy lvm2 uses udev rules that
  # fire on every new block device — activation guaranteed. sd-encrypt + lvm2 is
  # officially supported per Arch wiki.
  local hooks="base systemd autodetect microcode modconf kms keyboard sd-vconsole block"
  [[ $LUKS -eq 1 ]] && hooks="$hooks sd-encrypt"
  [[ $LVM -eq 1 ]] && hooks="$hooks lvm2"
  hooks="$hooks filesystems fsck"

  sed -i "s/^HOOKS=.*/HOOKS=($hooks)/" "${MOUNTPOINT}"/etc/mkinitcpio.conf

  if [[ $LUKS -eq 1 ]] && ! grep -qE '^HOOKS=.*\bsd-encrypt\b' "${MOUNTPOINT}/etc/mkinitcpio.conf"; then
    print_error "Hook 'sd-encrypt' not in mkinitcpio.conf after sed."
    return 1
  fi
  if [[ $LVM -eq 1 ]] && ! grep -qE '^HOOKS=.*\blvm2\b' "${MOUNTPOINT}/etc/mkinitcpio.conf"; then
    print_error "Hook 'lvm2' not in mkinitcpio.conf after sed."
    return 1
  fi

  # zstd -19 -T0: smallest initramfs, parallel decompression.
  sed -i 's/^#\?COMPRESSION=.*/COMPRESSION="zstd"/' "${MOUNTPOINT}"/etc/mkinitcpio.conf
  if grep -q '^#\?COMPRESSION_OPTIONS=' "${MOUNTPOINT}"/etc/mkinitcpio.conf; then
    sed -i 's/^#\?COMPRESSION_OPTIONS=.*/COMPRESSION_OPTIONS=(-19 -T0)/' "${MOUNTPOINT}"/etc/mkinitcpio.conf
  else
    echo 'COMPRESSION_OPTIONS=(-19 -T0)' >> "${MOUNTPOINT}"/etc/mkinitcpio.conf
  fi

  print_info "mkinitcpio.conf updated (HOOKS=$hooks, COMPRESSION=zstd -19 -T0)."
  print_info "Regenerating initramfs for all presets (zen + linux-lts)..."

  if arch_chroot "mkinitcpio -P"; then
    local missing=0
    for k in "$KERNEL_PRIMARY" "linux-lts"; do
      [[ -f "${MOUNTPOINT}/boot/initramfs-${k}.img" ]] || { print_warning "Missing /boot/initramfs-${k}.img"; missing=1; }
    done
    if [[ $missing -eq 1 ]]; then
      print_error "mkinitcpio -P finished but some initramfs not generated."
      return 1
    fi
    print_success "initramfs regenerated: $(ls "${MOUNTPOINT}/boot/initramfs-"*.img 2>/dev/null | wc -l) images."
    return 0
  else
    print_error "mkinitcpio -P failed. Check output above (missing modules, broken hooks, etc.)."
    return 1
  fi
}
#}}}
#INSTALL BOOTLOADER {{{
install_bootloader() {
  print_title "BOOTLOADER - https://wiki.archlinux.org/index.php/Bootloader"
  require_base_installed "Install Bootloader" || return 1
  print_info "AUI-X uses UEFI + systemd-boot. No BIOS/legacy path."
  if [[ $UEFI -ne 1 ]]; then
    print_error "UEFI not detected. AUI-X does not support BIOS/legacy."
    print_warning "Re-boot the live USB in UEFI mode from the firmware boot menu."
    return 1
  fi
  bootloader="systemd-boot"
  print_success "Bootloader: systemd-boot"
}
#}}}
#CONFIGURE BOOTLOADER {{{
# sd-encrypt cmdline params:
#   rd.luks.name=<luks-uuid>=<mapper-name>   (preferred)
#   root=/dev/mapper/<mapper-name>
#   rd.luks.options=discard                  (if TRIM)
# Do NOT use 'cryptdevice=' (legacy 'encrypt' hook, not sd-encrypt).
_kernel_cmdline() {
  # Build kernel cmdline for sd-encrypt + lvm2 (legacy udev).
  # Mitigations left at kernel default (auto). Tuning added:
  #   amd_pstate=active                          modern P-state on AMD Zen2+ (no-op on Intel)
  #   split_lock_detect=off                      Wine/anti-cheat compat
  #   nowatchdog                                 drop kernel watchdog (latency + battery)
  #   quiet loglevel=3                           clean boot; journalctl keeps everything
  #   nvme_core.default_ps_max_latency_us=5500   avoid NVMe suspend hang (Samsung 980/990,
  #                                              WD SN850). Must be in cmdline because
  #                                              nvme_core is built-in (modprobe.d ignored).
  # Note: nvidia_drm.modeset NOT added here — setup writes it to /etc/modprobe.d/
  # when the driver is installed, avoiding ghost flags without an NVIDIA GPU.
  local root_spec="${ROOT_MOUNTPOINT}"
  local cmdline

  if [[ -z "$root_spec" ]]; then
    print_error "ROOT_MOUNTPOINT empty; check that partitioning mounted / correctly."
    return 1
  fi

  if [[ $LUKS -eq 1 ]]; then
    local luks_uuid
    luks_uuid=$(blkid -s UUID -o value "/dev/${LUKS_DISK}" 2>/dev/null)
    if [[ -n "$luks_uuid" ]]; then
      cmdline="rd.luks.name=${luks_uuid}=cryptroot root=${root_spec} rw"
    else
      cmdline="root=${root_spec} rw"
    fi
    [[ $TRIM -eq 1 ]] && cmdline="rd.luks.options=discard ${cmdline}"
  else
    cmdline="root=${root_spec} rw"
  fi

  # LVM belt-and-suspenders (lvm2 legacy hook doesn't need these but harmless).
  if [[ $LVM -eq 1 ]]; then
    cmdline="${cmdline} rd.lvm.vg=lvm rd.lvm.lv=lvm/root"
  fi

  cmdline="${cmdline} amd_pstate=active split_lock_detect=off nowatchdog"
  cmdline="${cmdline} nvme_core.default_ps_max_latency_us=5500"
  cmdline="${cmdline} quiet loglevel=3"
  echo "$cmdline"
}

configure_bootloader() {
  case $bootloader in
  systemd-boot)
    print_title "SYSTEMD-BOOT - https://wiki.archlinux.org/title/Systemd-boot"
    print_info "Installing systemd-boot with dual entries: primary kernel + linux-lts (recovery)."
    if [[ "$EFI_MOUNTPOINT" != "/boot" ]]; then
      print_error "systemd-boot requires ESP mounted at /boot (current: ${EFI_MOUNTPOINT})."
      return 1
    fi

    # ESP size pre-check: ~256MB needed for zen+lts vmlinuz/initramfs/microcode/systemd-boot.
    # 100MB ESPs fill up on initramfs regen later → silent boot break.
    local esp_free_mb
    esp_free_mb=$(df -BM --output=avail "${MOUNTPOINT}${EFI_MOUNTPOINT}" 2>/dev/null | tail -1 | tr -dc '0-9')
    if [[ -n "$esp_free_mb" && "$esp_free_mb" -lt 256 ]]; then
      print_danger "ESP at ${EFI_MOUNTPOINT} has only ${esp_free_mb}MB free."
      print_danger "Recommended: 256MB+ for zen + linux-lts + initramfs + microcode."
      read_input_text "Continue at your own risk?"
      if [[ $OPTION != y ]]; then
        print_warning "Small ESP rejected. Repartition with 512MB+ ESP."
        return 1
      fi
    fi

    # ESP partition type pre-check: UEFI only enumerates "EFI System" (GPT EF00).
    local esp_dev esp_parttype
    esp_dev=$(findmnt -no SOURCE "${MOUNTPOINT}${EFI_MOUNTPOINT}" 2>/dev/null)
    if [[ -n "$esp_dev" ]]; then
      esp_parttype=$(lsblk -no PARTTYPE "$esp_dev" 2>/dev/null | head -1)
      if [[ "$esp_parttype" != "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" ]]; then
        print_danger "${esp_dev} is NOT type 'EFI System Partition' (GPT EF00). UEFI won't see it."
        print_danger "Current type: ${esp_parttype:-<unknown>}"
        print_warning "Attempting fix with sfdisk (GPT only)..."
        local disk part_num
        disk=$(lsblk -no PKNAME "$esp_dev" 2>/dev/null | head -1)
        part_num=$(echo "$esp_dev" | grep -oE '[0-9]+$')
        if [[ -n "$disk" && -n "$part_num" ]]; then
          sfdisk --part-type "/dev/$disk" "$part_num" c12a7328-f81f-11d2-ba4b-00a0c93ec93b 2>/dev/null \
            && print_success "Type fixed to EFI System on ${esp_dev}" \
            || print_danger "sfdisk failed. Fix manually: gdisk /dev/${disk} -> t -> ${part_num} -> ef00"
        fi
      fi
    fi

    arch_chroot "bootctl --esp-path=${EFI_MOUNTPOINT} install --graceful" \
      || { print_error "bootctl install failed. Check ESP mount and UEFI mode."; return 1; }

    # Check 1: systemd-boot binary copied?
    local sb_bin="${MOUNTPOINT}${EFI_MOUNTPOINT}/EFI/systemd/systemd-bootx64.efi"
    if [[ ! -f "$sb_bin" ]]; then
      print_error "systemd-bootx64.efi NOT copied to ESP. bootctl failed silently."
      return 1
    fi

    # Check 2 (CRITICAL): force /EFI/BOOT/BOOTX64.EFI fallback. Any UEFI firmware
    # runs this when no NVRAM entry exists. Without it, VirtualBox/QEMU/buggy NVRAM
    # firmwares never boot. Idempotent.
    local fallback_dir="${MOUNTPOINT}${EFI_MOUNTPOINT}/EFI/BOOT"
    local fallback_bin="${fallback_dir}/BOOTX64.EFI"
    mkdir -p "$fallback_dir"
    if [[ ! -f "$fallback_bin" ]] || ! cmp -s "$sb_bin" "$fallback_bin"; then
      cp "$sb_bin" "$fallback_bin" \
        || { print_error "Cannot write fallback ${fallback_bin}. ESP full or read-only?"; return 1; }
      print_success "Fallback /EFI/BOOT/BOOTX64.EFI written (rescue for unstable NVRAM/VMs)."
    fi

    # Check 3: NVRAM "Linux Boot Manager" entry exists? If not, create with efibootmgr.
    if [[ -d /sys/firmware/efi/efivars ]]; then
      local bm_out
      bm_out=$(arch_chroot "efibootmgr 2>/dev/null" 2>/dev/null || true)
      if ! echo "$bm_out" | grep -qiE "linux boot manager|systemd-boot"; then
        print_warning "No NVRAM entry for systemd-boot. Creating manually..."
        local disk part_num
        disk=$(lsblk -no PKNAME "$esp_dev" 2>/dev/null | head -1)
        part_num=$(echo "$esp_dev" | grep -oE '[0-9]+$')
        if [[ -n "$disk" && -n "$part_num" ]]; then
          arch_chroot "efibootmgr --create --disk /dev/${disk} --part ${part_num} --label 'Linux Boot Manager' --loader '\\EFI\\systemd\\systemd-bootx64.efi'" \
            && print_success "NVRAM entry created." \
            || print_warning "efibootmgr could not create NVRAM entry. System boots via BOOTX64.EFI fallback."
        fi
      fi
    fi

    local cmdline kernels k entry_path primary_entry_written
    cmdline=$(_kernel_cmdline) || return 1
    primary_entry_written=0

    mapfile -t kernels < <(arch-chroot "${MOUNTPOINT}" bash -c 'ls /boot/vmlinuz-* 2>/dev/null | sed "s|/boot/vmlinuz-||"')

    # Emit only initrd lines for microcodes that exist (avoids "Failed to read initrd" warnings).
    local ucode_lines=""
    [[ -f "${MOUNTPOINT}${EFI_MOUNTPOINT}/intel-ucode.img" ]] && ucode_lines+="initrd   /intel-ucode.img"$'\n'
    [[ -f "${MOUNTPOINT}${EFI_MOUNTPOINT}/amd-ucode.img"   ]] && ucode_lines+="initrd   /amd-ucode.img"$'\n'

    mkdir -p "${MOUNTPOINT}${EFI_MOUNTPOINT}/loader/entries"
    cat > "${MOUNTPOINT}${EFI_MOUNTPOINT}/loader/loader.conf" <<EOF
default  arch.conf
timeout  3
console-mode max
editor   no
EOF

    for k in "${kernels[@]}"; do
      [[ "$k" == "$KERNEL_PRIMARY" ]] || continue
      entry_path="${MOUNTPOINT}${EFI_MOUNTPOINT}/loader/entries/arch.conf"
      cat > "$entry_path" <<EOF
title    Arch Linux (${k})
linux    /vmlinuz-${k}
${ucode_lines}initrd   /initramfs-${k}.img
options  ${cmdline}
EOF
      primary_entry_written=1
    done
    if [[ $primary_entry_written -ne 1 ]]; then
      print_error "arch.conf not generated for ${KERNEL_PRIMARY}. Does /boot/vmlinuz-${KERNEL_PRIMARY} exist?"
      print_warning "Run step 3 (Install Base System) — kernel not in /boot."
      return 1
    fi

    if arch_chroot "pacman -Q linux-lts" >/dev/null 2>&1; then
      entry_path="${MOUNTPOINT}${EFI_MOUNTPOINT}/loader/entries/arch-lts.conf"
      cat > "$entry_path" <<EOF
title    Arch Linux (linux-lts) — RECOVERY
linux    /vmlinuz-linux-lts
${ucode_lines}initrd   /initramfs-linux-lts.img
options  ${cmdline}
EOF
    fi

    entry_path="${MOUNTPOINT}${EFI_MOUNTPOINT}/loader/entries/rescue.conf"
    cat > "$entry_path" <<EOF
title    Arch Linux RESCUE (single user, LTS)
linux    /vmlinuz-linux-lts
${ucode_lines}initrd   /initramfs-linux-lts.img
options  ${cmdline} systemd.unit=rescue.target
EOF

    local arch_conf="${MOUNTPOINT}${EFI_MOUNTPOINT}/loader/entries/arch.conf"
    if [[ $LUKS -eq 1 ]] && ! grep -q "rd.luks.name=" "$arch_conf"; then
      print_error "arch.conf missing rd.luks.name= — system won't open LUKS at boot."
      return 1
    fi
    if [[ $LVM -eq 1 ]] && ! grep -qE 'rd\.lvm\.(vg|lv)=' "$arch_conf"; then
      print_error "arch.conf missing rd.lvm.vg/lv — VG won't activate -> emergency mode."
      return 1
    fi
    if ! grep -q "^options " "$arch_conf"; then
      print_error "arch.conf missing 'options' line — kernel boots without parameters."
      return 1
    fi

    print_success "Bootloader installed and verified. Cmdline: $(grep '^options' "$arch_conf" | cut -c1-100)..."
    ;;
  esac
}
#}}}
#ROOT PASSWORD {{{
root_password() {
  print_title "ROOT PASSWORD"
  require_base_installed "Root Password" || return 1
  print_warning "Enter your new root password"
  arch_chroot "passwd" || { print_error "passwd failed."; return 1; }
  pause_function
}
#}}}
#AUR HELPER {{{
install_aur_helper() {
  print_title "AUR HELPER"
  require_base_installed "AUR Helper" || return 1
  print_info "Install paru in Phase 1 so setup/post-install can use AUR."

  local opts=("paru (recommended)" "Skip")
  PS3="$prompt1"
  select OPT in "${opts[@]}"; do
    case "$OPT" in
      "paru (recommended)") AUR_HELPER="paru"; break ;;
      "Skip") AUR_HELPER=""; return ;;
      *) invalid_option ;;
    esac
  done

  arch_chroot "pacman -S --needed --noconfirm base-devel git sudo"

  arch_chroot "id -u aurbuild >/dev/null 2>&1 || useradd -m -s /bin/bash aurbuild"
  mkdir -p "${MOUNTPOINT}"/etc/sudoers.d
  cat > "${MOUNTPOINT}"/etc/sudoers.d/90-aurbuild <<'EOF'
aurbuild ALL=(ALL) NOPASSWD: /usr/bin/pacman
EOF
  chmod 0440 "${MOUNTPOINT}"/etc/sudoers.d/90-aurbuild

  arch_chroot "sudo -u aurbuild bash -lc 'set -e; cd /tmp; rm -rf paru; git clone https://aur.archlinux.org/paru.git; cd paru; makepkg -si --noconfirm'"
  local ret=$?

  rm -f "${MOUNTPOINT}"/etc/sudoers.d/90-aurbuild
  arch_chroot "userdel -r aurbuild >/dev/null 2>&1 || true"

  if [[ $ret -ne 0 ]]; then
    print_error "paru build failed. Check network/AUR/build logs above."
    print_info "AUR helper is optional — you can continue and install it post-reboot."
    return 1
  fi
  print_success "paru installed."
  pause_function
}
#}}}
#SAFETY NET DEL INSTALL {{{
# Recovery safety net pre-reboot: LUKS header backup, /etc snapshot, RECOVERY.md.
# Not security hardening (fortress does that). Makes first boot recoverable if things break.
safety_net() {
  print_title "INSTALL SAFETY NET"
  print_info "Generating LUKS header backup, /etc baseline, and RECOVERY.md."

  mkdir -p "${MOUNTPOINT}"/var/lib/aui-x
  mkdir -p "${MOUNTPOINT}"/root

  local hostname_val backup_path luks_dev
  hostname_val=$(cat "${MOUNTPOINT}"/etc/hostname 2>/dev/null || echo "arch")

  if [[ $LUKS -eq 1 ]] && [[ -n "$LUKS_DISK" ]]; then
    luks_dev="/dev/${LUKS_DISK}"
    backup_path="${MOUNTPOINT}/root/luks-header-${hostname_val}.bin"
    print_info "Backing up LUKS header from ${luks_dev}"
    if cryptsetup luksHeaderBackup "$luks_dev" --header-backup-file "$backup_path"; then
      chmod 400 "$backup_path"
      print_success "LUKS header staged at /root/luks-header-${hostname_val}.bin"
      print_danger "WARNING: this file is useless if the disk dies."
      print_danger "Move it TODAY to two separate encrypted external media, then delete from /root."
    else
      print_warning "luksHeaderBackup failed; check manually after reboot."
    fi
  else
    print_info "No LUKS; skipping header backup."
  fi

  print_info "Generating /etc baseline..."
  arch_chroot "tar --zstd -cf /var/lib/aui-x/etc-baseline.tar.zst -C / etc 2>/dev/null" || \
    print_warning "/etc snapshot failed (non-fatal)."

  local luks_dev_hint="/dev/${LUKS_DISK:-<device>}"

  cat > "${MOUNTPOINT}"/root/RECOVERY.md <<RECOVERY_HEADER_EOF
# Recovery — aui-x base install

Layout detected: LUKS=${LUKS} LVM=${LVM} LUKS_DEVICE=${luks_dev_hint}

## If the system does not boot with linux-zen

In the bootloader menu select the \`linux-lts\` entry. Fallback kernel always installed.

## Chroot procedure from live USB
RECOVERY_HEADER_EOF

  if [[ $LUKS -eq 1 && $LVM -eq 1 ]]; then
    cat >> "${MOUNTPOINT}"/root/RECOVERY.md <<RECOVERY_LVMLUKS_EOF

Layout: **LVM on LUKS** (project default):

1. Boot from Arch live USB.
2. Unlock LUKS (slot-0 passphrase — untouched by fortress):
       cryptsetup open ${luks_dev_hint} cryptroot
3. Activate VG and mount root LV:
       vgchange -ay lvm
       mount /dev/mapper/lvm-root /mnt
       mount /dev/mapper/lvm-home /mnt/home 2>/dev/null || true
       mount /dev/<esp-partition> /mnt/boot
4. Chroot:
       arch-chroot /mnt
RECOVERY_LVMLUKS_EOF
  elif [[ $LUKS -eq 1 ]]; then
    cat >> "${MOUNTPOINT}"/root/RECOVERY.md <<RECOVERY_LUKS_EOF

Layout: **LUKS without LVM**:

1. Boot from Arch live USB.
2. Unlock LUKS:
       cryptsetup open ${luks_dev_hint} cryptroot
3. Mount root and ESP:
       mount /dev/mapper/cryptroot /mnt
       mount /dev/<esp-partition> /mnt/boot
4. Chroot:
       arch-chroot /mnt
RECOVERY_LUKS_EOF
  else
    cat >> "${MOUNTPOINT}"/root/RECOVERY.md <<'RECOVERY_PLAIN_EOF'

Layout: **unencrypted**:

1. Boot from Arch live USB.
2. Identify root with `lsblk -f`.
3. Mount root and ESP:
       mount /dev/<root-partition> /mnt
       mount /dev/<esp-partition> /mnt/boot
4. Chroot:
       arch-chroot /mnt
RECOVERY_PLAIN_EOF
  fi

  cat >> "${MOUNTPOINT}"/root/RECOVERY.md <<'RECOVERY_COMMON_EOF'

## If aui-fortress is installed and blocks boot

After chroot (above), disable fortress:

    aui-fortress rollback --all

Exit chroot and reboot.

## If you lose the FIDO2 token or presence USB

Use the slot-0 passphrase (the one set during install). Always in slot 0; fortress never touches it.

## If you lose the slot-0 passphrase

Restore from the LUKS header backup (luks-header-<hostname>.bin):

    cryptsetup luksHeaderRestore /dev/<device> --header-backup-file luks-header-<hostname>.bin

Then use the original passphrase from when the header was created.

Without the header backup -> data lost. It must live on two separate encrypted USBs, not /root.

## Useful commands

- journalctl -b                                 last-boot logs
- bootctl list                                  systemd-boot entries
- cryptsetup luksDump /dev/<device>             LUKS slot status
- lsblk -f                                      filesystems and UUIDs
- vgs ; lvs                                     active VGs and LVs
- ls /var/lib/aui-x/etc-baseline.tar.zst        /etc snapshot from install end
RECOVERY_COMMON_EOF
  chmod 600 "${MOUNTPOINT}"/root/RECOVERY.md

  # Recovery artifacts only (boot integrity is verified inline in each step).
  print_info "Recovery artifacts (not in main menu):"
  printf "  %-25s %s\n" "linux-lts installed:" \
    "$(arch_chroot 'pacman -Q linux-lts' >/dev/null 2>&1 && echo YES || echo NO)"
  printf "  %-25s %s\n" "LUKS header staged:" \
    "$([[ -n "$backup_path" && -f "$backup_path" ]] && echo YES || echo SKIP)"
  printf "  %-25s %s\n" "/etc baseline:" \
    "$([[ -f "${MOUNTPOINT}/var/lib/aui-x/etc-baseline.tar.zst" ]] && echo YES || echo NO)"
  printf "  %-25s %s\n" "RECOVERY.md:" \
    "$([[ -f "${MOUNTPOINT}/root/RECOVERY.md" ]] && echo YES || echo NO)"
}
#}}}
#FINISH {{{
# Pre-reboot hard validation. Historical bug: user pressed 'd) Done' without doing
# step 10 (Bootloader) or step 11 (Root Password) -> rebooted into live ISO.
validate_critical_steps() {
  local missing=()
  [[ ${checklist[1]:-0}  -eq 1 ]] || missing+=("1)  Initial Setup")
  [[ ${checklist[2]:-0}  -eq 1 ]] || missing+=("2)  Partition Scheme")
  [[ ${checklist[3]:-0}  -eq 1 ]] || missing+=("3)  Install Base System")
  [[ ${checklist[4]:-0}  -eq 1 ]] || missing+=("4)  Configure Fstab")
  [[ ${checklist[5]:-0}  -eq 1 ]] || missing+=("5)  Configure Hostname")
  [[ ${checklist[6]:-0}  -eq 1 ]] || missing+=("6)  Configure Timezone")
  [[ ${checklist[8]:-0}  -eq 1 ]] || missing+=("8)  Configure Locale")
  [[ ${checklist[9]:-0}  -eq 1 ]] || missing+=("9)  Configure Mkinitcpio")
  [[ ${checklist[10]:-0} -eq 1 ]] || missing+=("10) Install Bootloader")
  [[ ${checklist[11]:-0} -eq 1 ]] || missing+=("11) Root Password")

  if [[ ${#missing[@]} -gt 0 ]]; then
    print_danger "CANNOT REBOOT: critical steps missing. System will not boot."
    for m in "${missing[@]}"; do
      print_warning "  - $m"
    done
    print_warning "Complete these steps from the menu before continuing."
    pause_function
    return 1
  fi
  return 0
}

finish() {
  print_title "INSTALL COMPLETED"

  validate_critical_steps || return

  safety_net

  print_warning "\nA copy of this repository will be placed in /root/aui-x on your new system"
  mkdir -p "${MOUNTPOINT}"/root/aui-x
  cp -a "${PROJECT_ROOT}/." "${MOUNTPOINT}"/root/aui-x/
  print_warning "If on VirtualBox/VM: unmount the ISO or set the disk first in boot order before rebooting."
  read_input_text "Reboot system"
  if [[ $OPTION == y ]]; then
    umount_partitions
    reboot
  fi
  exit 0
}
#}}}

initial_setup() {
  print_title "INITIAL SETUP - keymap + editor + mirrors"
  select_keymap &&
    configure_live_editor &&
    configure_mirrorlist
}

# Uniform success/fail line + pause, so user reads before menu redraws.
run_step() {
  local num="$1" name="$2"
  shift 2
  if "$@"; then
    checklist[$num]=1
    print_success "Step ${num} (${name}) completed."
  else
    local rc=$?
    print_error "Step ${num} (${name}) NOT completed (exit code ${rc})."
    print_warning "Check messages above. You can retry this step from the menu."
  fi
  pause_function
}

# Composite-step wrappers: chain with && so early failure propagates exit code.
_do_partitioning() { umount_partitions; create_partition_scheme && format_partitions; }
_do_base_install() { install_base_system && configure_keymap; }
_do_bootloader()   { install_bootloader && configure_bootloader; }

pause_function
check_boot_system
check_connection
check_trim
pacman -Sy
while true; do
  print_title "ARCHLINUX ULTIMATE INSTALL - https://github.com/helmuthdu/aui"
  echo " 1) $(mainmenu_item "${checklist[1]}" "Initial Setup (keymap + editor + mirrors)" "${KEYMAP:+$KEYMAP, }${EDITOR:+$EDITOR, }${country_code:+$country_code}")"
  echo " 2) $(mainmenu_item "${checklist[2]}" "Partition Scheme" "${partition_layout}: ${partition}(${filesystem}) [swap=zram]")"
  echo " 3) $(mainmenu_item "${checklist[3]}" "Install Base System")"
  echo " 4) $(mainmenu_item "${checklist[4]}" "Configure Fstab" "${fstab}")"
  echo " 5) $(mainmenu_item "${checklist[5]}" "Configure Hostname" "${host_name}")"
  echo " 6) $(mainmenu_item "${checklist[6]}" "Configure Timezone" "${ZONE}/${SUBZONE}")"
  echo " 7) $(mainmenu_item "${checklist[7]}" "Configure Hardware Clock" "${hwclock}")"
  echo " 8) $(mainmenu_item "${checklist[8]}" "Configure Locale" "${LOCALE}")"
  echo " 9) $(mainmenu_item "${checklist[9]}" "Configure Mkinitcpio")"
  echo "10) $(mainmenu_item "${checklist[10]}" "Install Bootloader" "${bootloader}")"
  echo "11) $(mainmenu_item "${checklist[11]}" "Root Password")"
  echo "12) $(mainmenu_item "${checklist[12]}" "AUR helper" "${AUR_HELPER:-}")"
  echo ""
  echo " d) Done"
  echo ""
  read_input_options
  for OPT in "${OPTIONS[@]}"; do
    case "$OPT" in
    1)  run_step 1  "Initial Setup"          initial_setup ;;
    2)  run_step 2  "Partition Scheme"       _do_partitioning ;;
    3)  run_step 3  "Install Base System"    _do_base_install ;;
    4)  run_step 4  "Configure Fstab"        configure_fstab ;;
    5)  run_step 5  "Configure Hostname"     configure_hostname ;;
    6)  run_step 6  "Configure Timezone"     configure_timezone ;;
    7)  run_step 7  "Configure Hardware Clock" configure_hardwareclock ;;
    8)  run_step 8  "Configure Locale"       configure_locale ;;
    9)  run_step 9  "Configure Mkinitcpio"   configure_mkinitcpio ;;
    10) run_step 10 "Install Bootloader"     _do_bootloader ;;
    11) run_step 11 "Root Password"          root_password ;;
    12) run_step 12 "AUR Helper"             install_aur_helper ;;
    "d") finish ;;
    *)   invalid_option ;;
    esac
  done
done
#}}}
