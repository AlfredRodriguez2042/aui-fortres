#!/bin/bash


SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
if [[ -f "$SCRIPT_DIR/lib" ]]; then
  source "$SCRIPT_DIR/lib"
else
  echo "missing file: $SCRIPT_DIR/lib"
  exit 1
fi

#ARCHLINUX INSTALL SCRIPTS MODE {{{
#SELECT KEYMAP {{{
select_keymap() {
  print_title "KEYMAP - https://wiki.archlinux.org/index.php/KEYMAP"
  keymap_list=("ANSI-dvorak" "amiga-de" "amiga-us" "applkey" "atari-de" "atari-se" "atari-uk-falcon" "atari-us" "azerty" "backspace" "bashkir" "be-latin1" "bg-cp1251" "bg-cp855" "bg_bds-cp1251" "bg_bds-utf8" "bg_pho-cp1251" "bg_pho-utf8" "br-abnt" "br-abnt2" "br-latin1-abnt2" "br-latin1-us" "by" "by-cp1251" "bywin-cp1251" "cf" "colemak" "croat" "ctrl" "cz" "cz-cp1250" "cz-lat2" "cz-lat2-prog" "cz-qwertz" "cz-us-qwertz" "de" "de-latin1" "de-latin1-nodeadkeys" "de-mobii" "de_CH-latin1" "de_alt_UTF-8" "defkeymap" "defkeymap_V1.0" "dk" "dk-latin1" "dvorak" "dvorak-ca-fr" "dvorak-es" "dvorak-fr" "dvorak-l" "dvorak-la" "dvorak-programmer" "dvorak-r" "dvorak-ru" "dvorak-sv-a1" "dvorak-sv-a5" "dvorak-uk" "emacs" "emacs2" "es" "es-cp850" "es-olpc" "et" "et-nodeadkeys" "euro" "euro1" "euro2" "fi" "fr" "fr-bepo" "fr-bepo-latin9" "fr-latin1" "fr-latin9" "fr-pc" "fr_CH" "fr_CH-latin1" "gr" "gr-pc" "hu" "hu101" "il" "il-heb" "il-phonetic" "is-latin1" "is-latin1-us" "it" "it-ibm" "it2" "jp106" "kazakh" "keypad" "ky_alt_sh-UTF-8" "kyrgyz" "la-latin1" "lt" "lt.baltic" "lt.l4" "lv" "lv-tilde" "mac-be" "mac-de-latin1" "mac-de-latin1-nodeadkeys" "mac-de_CH" "mac-dk-latin1" "mac-dvorak" "mac-es" "mac-euro" "mac-euro2" "mac-fi-latin1" "mac-fr" "mac-fr_CH-latin1" "mac-it" "mac-pl" "mac-pt-latin1" "mac-se" "mac-template" "mac-uk" "mac-us" "mk" "mk-cp1251" "mk-utf" "mk0" "nl" "nl2" "no" "no-dvorak" "no-latin1" "pc110" "pl" "pl1" "pl2" "pl3" "pl4" "pt-latin1" "pt-latin9" "pt-olpc" "ro" "ro_std" "ro_win" "ru" "ru-cp1251" "ru-ms" "ru-yawerty" "ru1" "ru2" "ru3" "ru4" "ru_win" "ruwin_alt-CP1251" "ruwin_alt-KOI8-R" "ruwin_alt-UTF-8" "ruwin_alt_sh-UTF-8" "ruwin_cplk-CP1251" "ruwin_cplk-KOI8-R" "ruwin_cplk-UTF-8" "ruwin_ct_sh-CP1251" "ruwin_ct_sh-KOI8-R" "ruwin_ct_sh-UTF-8" "ruwin_ctrl-CP1251" "ruwin_ctrl-KOI8-R" "ruwin_ctrl-UTF-8" "se-fi-ir209" "se-fi-lat6" "se-ir209" "se-lat6" "sg" "sg-latin1" "sg-latin1-lk450" "sk-prog-qwerty" "sk-prog-qwertz" "sk-qwerty" "sk-qwertz" "slovene" "sr-cy" "sun-pl" "sun-pl-altgraph" "sundvorak" "sunkeymap" "sunt4-es" "sunt4-fi-latin1" "sunt4-no-latin1" "sunt5-cz-us" "sunt5-de-latin1" "sunt5-es" "sunt5-fi-latin1" "sunt5-fr-latin1" "sunt5-ru" "sunt5-uk" "sunt5-us-cz" "sunt6-uk" "sv-latin1" "tj_alt-UTF8" "tr_f-latin5" "tr_q-latin5" "tralt" "trf" "trf-fgGIod" "trq" "ttwin_alt-UTF-8" "ttwin_cplk-UTF-8" "ttwin_ct_sh-UTF-8" "ttwin_ctrl-UTF-8" "ua" "ua-cp1251" "ua-utf" "ua-utf-ws" "ua-ws" "uk" "unicode" "us" "us-acentos" "wangbe" "wangbe2" "windowkeys")
  PS3="$prompt1"
  print_info "The KEYMAP variable is specified in the /etc/rc.conf file. It defines what keymap the keyboard is in the virtual consoles. Keytable files are provided by the kbd package."
  echo "keymap list in /usr/share/kbd/keymaps"
  select KEYMAP in "${keymap_list[@]}"; do
    if contains_element "$KEYMAP" "${keymap_list[@]}"; then
      loadkeys "$KEYMAP"
      break
    else
      invalid_option
    fi
  done
}
#}}}
#DEFAULT EDITOR {{{
select_editor() {
  print_title "DEFAULT EDITOR"
  editors_list=("emacs" "nano" "vi" "vim" "neovim" "zile")
  PS3="$prompt1"
  echo -e "Select editor\n"
  select EDITOR in "${editors_list[@]}"; do
    if contains_element "$EDITOR" "${editors_list[@]}"; then
      package_install "$EDITOR"
      break
    else
      invalid_option
    fi
  done
}
#}}}
#MIRRORLIST {{{
configure_mirrorlist() {
  local countries_code=("AU" "AT" "BD" "BY" "BE" "BA" "BR" "BG" "CA" "CL" "CN" "CO" "HR" "CZ" "DK" "EC" "FI" "FR" "GE" "DE" "GR" "HK" "HU" "IS" "IN" "ID" "IR" "IE" "IL" "IT" "JP" "KZ" "KE" "LV" "LT" "LU" "NL" "NC" "NZ" "MK" "NO" "PY" "PH" "PL" "PT" "RO" "RU" "RS" "SG" "SK" "SI" "ZA" "KR" "ES" "SE" "CH" "TW" "TH" "TR" "UA" "GB" "US" "VN")
  local countries_name=("Australia" "Austria" "Bangladesh" "Belarus" "Belgium" "Bosnia and Herzegovina" "Brazil" "Bulgaria" "Canada" "Chile" "China" "Colombia" "Croatia" "Czech Republic" "Denmark" "Ecuador" "Finland" "France" "Georgia" "Germany" "Greece" "Hong Kong" "Hungary" "Iceland" "India" "Indonesia" "Iran" "Ireland" "Israel" "Italy" "Japan" "Kazakhstan" "Kenya" "Latvia" "Lithuania" "Luxembourg" "Netherlands" "New Caledonia" "New Zealand" "North Macedonia" "Norway" "Paraguay" "Philippines" "Poland" "Portugal" "Romania" "Russia" "Serbia" "Singapore" "Slovakia" "Slovenia" "South Africa" "South Korea" "Spain" "Sweden" "Switzerland" "Taiwan" "Thailand" "Turkey" "Ukraine" "United Kingdom" "United States" "Viet Nam")
  country_list() {
    #`reflector --list-countries | sed 's/[0-9]//g' | sed 's/^/"/g' | sed 's/,.*//g' | sed 's/ *$//g'  | sed 's/$/"/g' | sed -e :a -e '$!N; s/\n/ /; ta'`
    PS3="$prompt1"
    echo "Select your country:"
    select country_name in "${countries_name[@]}"; do
      if contains_element "$country_name" "${countries_name[@]}"; then
        country_code=${countries_code[$((REPLY - 1))]}
        break
      else
        invalid_option
      fi
    done
  }
  print_title "MIRRORLIST - https://wiki.archlinux.org/index.php/Mirrors"
  print_info "Usando reflector para obtener los mirrors más rápidos y recientes (reemplaza curl+sed+rankmirrors legacy)."
  OPTION=n
  while [[ $OPTION != y ]]; do
    country_list
    read_input_text "Confirm country: $country_name"
  done

  # reflector ya está en el live ISO de Arch; si no, lo instalamos
  if ! command -v reflector >/dev/null 2>&1; then
    pacman -Sy --noconfirm --needed reflector
  fi

  # Backup del mirrorlist original
  [[ ! -f /etc/pacman.d/mirrorlist.orig ]] && cp /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.orig

  # Genera mirrorlist: HTTPS, recientes (<12h), top 20 por velocidad
  reflector \
    --country "${country_code}" \
    --protocol https \
    --age 12 \
    --latest 20 \
    --sort rate \
    --save /etc/pacman.d/mirrorlist

  chmod +r /etc/pacman.d/mirrorlist
  $EDITOR /etc/pacman.d/mirrorlist
}
#}}}
#UMOUNT PARTITIONS {{{
umount_partitions() {
  mounted_partitions=($(lsblk | grep "${MOUNTPOINT}" | awk '{print $7}' | sort -r))
  swapoff -a
  for i in "${mounted_partitions[@]}"; do
    umount "$i"
  done
  vgchange -an lvm >/dev/null 2>&1 || true
  cryptsetup close crypt >/dev/null 2>&1 || true
}
#}}}
#SELECT DEVICE {{{
select_device() {
  devices_list=($(lsblk -d | awk '{print "/dev/" $1}' | grep 'sd\|hd\|vd\|nvme\|mmcblk'))
  PS3="$prompt1"
  echo -e "Attached Devices:\n"
  lsblk -lnp -I 2,3,8,9,22,34,56,57,58,65,66,67,68,69,70,71,72,91,128,129,130,131,132,133,134,135,259 | awk '{print $1,$4,$6,$7}' | column -t
  echo -e "\n"
  echo -e "Select device to partition:\n"
  select device in "${devices_list[@]}"; do
    if contains_element "${device}" "${devices_list[@]}"; then
      break
    else
      invalid_option
    fi
  done
  BOOT_MOUNTPOINT=$device
}
#}}}
#CREATE PARTITION SCHEME {{{
create_partition_scheme() {
  LUKS=0
  LVM=0
  print_title "https://wiki.archlinux.org/index.php/Partitioning"
  print_info "Partitioning a hard drive allows one to logically divide the available space into sections that can be accessed independently of one another."
  print_info "Default del proyecto: cifrado LUKS desde el particionado inicial."
  print_warning "Sin LUKS no podrás usar luego fido2-unlock/keyfile-usb de fortress para root."
  print_warning "Maintain Current does not create LUKS; úsalo sólo si ya preparaste el cifrado manualmente."
  partition_layouts=("LVM+LUKS (default, recommended)" "Default (NO encryption)" "LVM (NO encryption)" "Maintain Current")
  PS3="$prompt1"
  echo -e "Select partition scheme:"
  select OPT in "${partition_layouts[@]}"; do
    partition_layout=$OPT
    case "$OPT" in
      "LVM+LUKS (default, recommended)")
        create_partition
        setup_luks || continue
        setup_lvm
        ;;
      "Default (NO encryption)")
        print_danger "Seleccionaste instalación SIN cifrado. Fortress no convertirá root/home a LUKS después."
        read_input_text "Confirmar instalación SIN cifrado"
        [[ $OPTION != y ]] && continue
        create_partition
        ;;
      "LVM (NO encryption)")
        print_danger "Seleccionaste LVM SIN cifrado. Fortress no convertirá root/home a LUKS después."
        read_input_text "Confirmar instalación SIN cifrado"
        [[ $OPTION != y ]] && continue
        create_partition
        setup_lvm
        ;;
      "Maintain Current")
        print_warning "Maintain Current asume que ya montaste/abriste cualquier LUKS existente manualmente."
        modprobe dm-mod
        vgscan &>/dev/null
        vgchange -ay &>/dev/null
        ;;
      *)
        invalid_option
        ;;
    esac
    [[ -n $OPT ]] && break
  done
}
#}}}
#SETUP PARTITION{{{
create_partition() {
  umount_partitions
  apps_list=("cfdisk" "cgdisk" "fdisk" "gdisk" "parted")
  PS3="$prompt1"
  echo -e "Select partition program:"
  select OPT in "${apps_list[@]}"; do
    if contains_element "$OPT" "${apps_list[@]}"; then
      select_device
      case $OPT in
      parted)
        parted -a opt "${device}"
        ;;
      *)
        $OPT "${device}"
        ;;
      esac
      break
    else
      invalid_option
    fi
  done
}
#}}}
#SETUP LUKS {{{
setup_luks() {
  print_title "LUKS - https://wiki.archlinux.org/index.php/LUKS"
  print_info "The Linux Unified Key Setup or LUKS is a disk-encryption specification created by Clemens Fruhwirth and originally intended for Linux."
  print_danger "\tDo not use this for boot partitions"
  block_list=($(lsblk | grep 'part' | awk '{print "/dev/" substr($1,3)}'))
  block_list+=("Cancel")
  PS3="$prompt1"
  echo -e "Select partition:"
  select OPT in "${block_list[@]}"; do
    if contains_element "$OPT" "${block_list[@]}"; then
      print_danger "Esto destruirá irreversiblemente los datos y firmas existentes en ${OPT}."
      printf "%s" "Escribe CIFRAR para confirmar LUKS2 en ${OPT}: "
      read -r luks_confirm
      [[ "$luks_confirm" == "CIFRAR" ]] || {
        print_warning "LUKS cancelado; no se continúa sin cifrado."
        return 1
      }
      wipefs -a "$OPT" || error_msg "wipefs falló en ${OPT}; no se continúa sin cifrado."
      cryptsetup --batch-mode --type luks2 --cipher aes-xts-plain64 --key-size 512 --hash sha512 --iter-time 5000 --use-random --verify-passphrase luksFormat "$OPT" || error_msg "luksFormat falló; no se continúa sin cifrado."
      local open_args=(open --type luks)
      [[ $TRIM -eq 1 ]] && open_args+=(--allow-discards)
      cryptsetup "${open_args[@]}" "$OPT" crypt || error_msg "No se pudo abrir el contenedor LUKS; no se continúa sin cifrado."
      LUKS=1
      LUKS_DISK=$(echo "${OPT}" | sed 's/\/dev\///')
      break
    elif [[ $OPT == "Cancel" ]]; then
      print_warning "LUKS cancelado; vuelve a elegir particionado o confirma un modo sin cifrado explícito."
      return 1
    else
      invalid_option
    fi
  done
}
#}}}
#SETUP LVM {{{
setup_lvm() {
  print_title "LVM - https://wiki.archlinux.org/index.php/LVM"
  print_info "LVM is a logical volume manager for the Linux kernel; it manages disk drives and similar mass-storage devices. "
  print_info "Layout recomendado: LV root grande para pacstrap/KDE y LV home con el espacio restante."
  if [[ $LUKS -eq 1 ]]; then
    pvcreate /dev/mapper/crypt || error_msg "pvcreate falló sobre /dev/mapper/crypt"
    vgcreate lvm /dev/mapper/crypt || error_msg "vgcreate lvm falló"
  else
    block_list=($(lsblk | grep 'part' | awk '{print "/dev/" substr($1,3)}'))
    PS3="$prompt1"
    echo -e "Select partition:"
    select OPT in "${block_list[@]}"; do
      if contains_element "$OPT" "${block_list[@]}"; then
        pvcreate "$OPT" || error_msg "pvcreate falló sobre $OPT"
        vgcreate lvm "$OPT" || error_msg "vgcreate lvm falló"
        break
      else
        invalid_option
      fi
    done
  fi
  local lvm_modes=("Guided root+home (recommended)" "Manual")
  PS3="$prompt1"
  print_info "Guiado crea LV root para / y LV home para /home. En el siguiente paso se usará /dev/mapper/lvm-root como root, no la partición física cifrada."
  echo -e "Select LVM layout:\n"
  select LVM_MODE in "${lvm_modes[@]}"; do
    case "$LVM_MODE" in
      "Guided root+home (recommended)")
        local root_size swap_size
        print_info "Tamaño de root (/): Enter usa 30G como mínimo cómodo. Para uso real con KDE/juegos/cache, 60G+ es más recomendable."
        printf "%s" "Root LV size [default: 30G, recommended desktop: 60G+]: "
        read -r root_size
        root_size="${root_size:-30G}"
        lvcreate -L "$root_size" lvm -n root || error_msg "No se pudo crear LV root de $root_size. Usa un disco más grande o menor tamaño."

        read_confirm "Create swap LV?" "n"
        if [[ $OPTION == y ]]; then
          printf "%s" "Swap LV size [default: 4G]: "
          read -r swap_size
          swap_size="${swap_size:-4G}"
          lvcreate -L "$swap_size" lvm -n swap || error_msg "No se pudo crear LV swap de $swap_size."
        fi

        lvcreate -l 100%FREE lvm -n home || print_warning "No quedó espacio libre para LV home; puedes continuar sólo con root."
        LVM=1
        return
        ;;
      "Manual")
        break
        ;;
      *)
        invalid_option
        ;;
    esac
  done

  print_warning "Manual: el último LV toma 100% del espacio restante. Crea primero un LV llamado root."
  printf "%s" "Enter number of LVs [ex: 2 for root+home, 3 for root+swap+home]: "
  read -r number_partitions
  i=1
  while [[ $i -le $number_partitions ]]; do
    printf "%s" "Enter $iª LV name [required first LV: root; ex: root, swap, home]: "
    read -r partition_name
    if [[ $i -eq 1 && "$partition_name" != "root" ]]; then
      error_msg "El primer LV debe llamarse root para evitar instalaciones con / demasiado pequeño o mal montado."
    fi
    if [[ $i -eq $number_partitions ]]; then
      lvcreate -l 100%FREE lvm -n "${partition_name}"
    else
      printf "%s" "Enter $iª partition size [ex: 25G, 200M]: " 
      read -r partition_size
      lvcreate -L "${partition_size}" lvm -n "${partition_name}"
    fi
    i=$((i + 1))
  done
  LVM=1
}
#}}}
#SELECT|FORMAT PARTITIONS {{{
format_partitions() {
  print_title "https://wiki.archlinux.org/index.php/File_Systems"
  print_info "This step will select and format the selected partition where archlinux will be installed"
  print_danger "\tAll data on the ROOT and SWAP partition will be LOST."
  [[ $LVM -eq 1 ]] && print_info "Modo LVM detectado: root/home/swap se eligen desde /dev/mapper/lvm-*. Las particiones físicas sólo se muestran cuando corresponden, como la ESP para /boot."
  i=0

  block_list=($(lsblk | grep 'part\|lvm' | awk '{print substr($1,3)}'))

  # check if there is no partition
  if [[ ${#block_list[@]} -eq 0 ]]; then
    echo "No partition found"
    exit 0
  fi

  partitions_list=()
  for OPT in "${block_list[@]}"; do
    check_lvm=$(echo "$OPT" | grep lvm)
    if [[ -z $check_lvm ]]; then
      partitions_list+=("/dev/$OPT")
    else
      partitions_list+=("/dev/mapper/$OPT")
    fi
  done
  role_partitions=()

  # partitions based on boot system
  if [[ $UEFI -eq 1 ]]; then
    partition_name=("root" "EFI" "swap" "another")
  else
    partition_name=("root" "swap" "another")
  fi

  select_filesystem() {
    filesystems_list=("btrfs" "ext2" "ext3" "ext4" "f2fs" "jfs" "nilfs2" "ntfs" "reiserfs" "vfat" "xfs")
    PS3="$prompt1"
    echo -e "Select filesystem:\n"
    select filesystem in "${filesystems_list[@]}"; do
      if contains_element "${filesystem}" "${filesystems_list[@]}"; then
        break
      else
        invalid_option
      fi
    done
  }

  is_luks_backing_partition() {
    [[ $LUKS -eq 1 && "$1" == "/dev/${LUKS_DISK}" ]]
  }

  has_lsblk_children() {
    [[ "$(lsblk -ln "$1" 2>/dev/null | wc -l)" -gt 1 ]]
  }

  is_lvm_lv() {
    [[ "$1" == /dev/mapper/lvm-* ]]
  }

  is_physical_leaf_partition() {
    [[ "$1" != /dev/mapper/* ]] && ! is_luks_backing_partition "$1" && ! has_lsblk_children "$1"
  }

  build_partition_candidates() {
    local role="$1"
    local partition_candidate
    role_partitions=()
    for partition_candidate in "${partitions_list[@]}"; do
      case "$role" in
        root)
          if [[ $LVM -eq 1 ]]; then
            [[ "$partition_candidate" == "/dev/mapper/lvm-root" ]] && role_partitions+=("$partition_candidate")
          elif ! is_luks_backing_partition "$partition_candidate"; then
            role_partitions+=("$partition_candidate")
          fi
          ;;
        EFI)
          is_physical_leaf_partition "$partition_candidate" && role_partitions+=("$partition_candidate")
          ;;
        swap)
          if [[ $LVM -eq 1 ]]; then
            [[ "$partition_candidate" == "/dev/mapper/lvm-swap" ]] && role_partitions+=("$partition_candidate")
          elif ! is_luks_backing_partition "$partition_candidate"; then
            role_partitions+=("$partition_candidate")
          fi
          ;;
        another)
          if [[ $LVM -eq 1 ]]; then
            is_lvm_lv "$partition_candidate" &&
              [[ "$partition_candidate" != "/dev/mapper/lvm-root" ]] &&
              [[ "$partition_candidate" != "/dev/mapper/lvm-swap" ]] &&
              role_partitions+=("$partition_candidate")
          elif ! is_luks_backing_partition "$partition_candidate"; then
            role_partitions+=("$partition_candidate")
          fi
          ;;
      esac
    done
  }

  print_partition_hint() {
    case "$1" in
      root)
        [[ $LVM -eq 1 ]] && print_info "Root (/): elige /dev/mapper/lvm-root, el LV creado para el sistema base."
        ;;
      EFI)
        print_info "EFI: elige la ESP sin cifrar (normalmente la partición pequeña FAT32). AUI-X la montará en /boot para systemd-boot."
        ;;
      swap)
        print_info "Swap: elige un LV/partición swap dedicado, crea swapfile, o salta swap si usarás ZRAM después."
        ;;
      another)
        [[ $LVM -eq 1 ]] && print_info "Extra: elige /dev/mapper/lvm-home para montarlo como /home."
        ;;
    esac
  }

  disable_partition() {
    local selected_partition="$1"
    local remaining_partitions=()
    local current_partition
    for current_partition in "${partitions_list[@]}"; do
      [[ "$current_partition" != "$selected_partition" ]] && remaining_partitions+=("$current_partition")
    done
    partitions_list=("${remaining_partitions[@]}")
    #increase i
    [[ ${partition_name[i]} != another ]] && i=$((i + 1))
  }

  format_partition() {
    read_input_text "Confirm format $1 partition"
    if [[ $OPTION == y ]]; then
      [[ -z $3 ]] && select_filesystem || filesystem=$3
      mkfs."${filesystem}" "$1" \
        $([[ ${filesystem} == xfs || ${filesystem} == btrfs || ${filesystem} == reiserfs ]] && echo "-f") \
        $([[ ${filesystem} == vfat ]] && echo "-F32") \
        $([[ $TRIM -eq 1 && ${filesystem} == ext4 ]] && echo "-E discard")
      fsck "$1"
      mkdir -p "$2"
      mount -t "${filesystem}" "$1" "$2"
      disable_partition "$1"
    fi
  }

  format_swap_partition() {
    read_input_text "Confirm format $1 partition"
    if [[ $OPTION == y ]]; then
      mkswap "$1"
      swapon "$1"
      disable_partition "$1"
    fi
  }

  create_swap() {
    build_partition_candidates "swap"
    if [[ ${#role_partitions[@]} -gt 0 ]]; then
      swap_options=("partition" "file" "skip")
    else
      print_info "No se detectó LV/partición swap dedicada. Puedes crear swapfile o saltar swap."
      swap_options=("file" "skip")
    fi
    print_partition_hint "swap"
    PS3="$prompt1"
    echo -e "Select ${BYellow}${partition_name[i]}${Reset} filesystem:\n"
    select OPT in "${swap_options[@]}"; do
      case "$OPT" in
      partition)
        select partition in "${role_partitions[@]}"; do
          if contains_element "${partition}" "${partitions_list[@]}"; then
            format_swap_partition "${partition}"
            break
          else
            invalid_option
          fi
        done
        swap_type="partition"
        break
        ;;
      file)
        total_memory=$(grep MemTotal /proc/meminfo | awk '{print $2/1024}' | sed 's/\..*//')
        fallocate -l "${total_memory}"M "${MOUNTPOINT}"/swapfile
        chmod 600 "${MOUNTPOINT}"/swapfile
        mkswap "${MOUNTPOINT}"/swapfile
        swapon "${MOUNTPOINT}"/swapfile
        i=$((i + 1))
        swap_type="file"
        break
        ;;
      skip)
        i=$((i + 1))
        swap_type="none"
        break
        ;;
      *)
        invalid_option
        ;;
      esac
    done
  }

  check_mountpoint() {
    if mount | grep "$2"; then
      echo "Successfully mounted"
      disable_partition "$1"
    else
      echo "WARNING: Not Successfully mounted"
    fi
  }

  set_efi_partition() {
    EFI_MOUNTPOINT="/boot"
    print_info "UEFI estándar: ESP montada en /boot para systemd-boot."
  }

  while true; do
    PS3="$prompt1"
    if [[ ${partition_name[i]} == swap ]]; then
      create_swap
    else
      build_partition_candidates "${partition_name[i]}"
      if [[ ${#role_partitions[@]} -eq 0 ]]; then
        if [[ ${partition_name[i]} == another ]]; then
          print_info "No quedan particiones/LVs seguros para montar como extra."
          break
        fi
        error_msg "No hay candidatos seguros para ${partition_name[i]}. Revisa el particionado/LVM antes de continuar."
      fi
      print_partition_hint "${partition_name[i]}"
      echo -e "Select ${BYellow}${partition_name[i]}${Reset} partition:\n"
      select partition in "${role_partitions[@]}"; do
        if contains_element "${partition}" "${partitions_list[@]}"; then
          case ${partition_name[i]} in
          root)
            ROOT_PART=$(echo "${partition}" | sed 's/\/dev\/mapper\///' | sed 's/\/dev\///')
            ROOT_MOUNTPOINT=${partition}
            format_partition "${partition}" "${MOUNTPOINT}"
            ;;
          EFI)
            set_efi_partition
            read_input_text "Format ${partition} partition"
            if [[ $OPTION == y ]]; then
              format_partition "${partition}" "${MOUNTPOINT}${EFI_MOUNTPOINT}" vfat
            else
              mkdir -p "${MOUNTPOINT}${EFI_MOUNTPOINT}"
              mount -t vfat "${partition}" "${MOUNTPOINT}${EFI_MOUNTPOINT}"
              check_mountpoint "${partition}" "${MOUNTPOINT}${EFI_MOUNTPOINT}"
            fi
            ;;
          another)
            if [[ "$partition" == "/dev/mapper/lvm-home" ]]; then
              printf "%s" "Mountpoint [default: /home]: "
            else
              printf "%s" "Mountpoint [ex: /home]: "
            fi
            read -r directory
            [[ -z "$directory" && "$partition" == "/dev/mapper/lvm-home" ]] && directory="/home"
            [[ $directory == "/boot" ]] && BOOT_MOUNTPOINT=$(echo "${partition}" | sed 's/[0-9]//')
            select_filesystem
            read_input_text "Format ${partition} partition"
            if [[ $OPTION == y ]]; then
              format_partition "${partition}" "${MOUNTPOINT}${directory}" "${filesystem}"
            else
              read_input_text "Confirm fs=""${filesystem}"" part=""${partition}"" dir=""${directory}"""
              if [[ $OPTION == y ]]; then
                mkdir -p "${MOUNTPOINT}${directory}"
                mount -t "${filesystem}" "${partition}" "${MOUNTPOINT}""${directory}"
                check_mountpoint "${partition}" "${MOUNTPOINT}${directory}"
              fi
            fi
            ;;
          esac
          break
        else
          invalid_option
        fi
      done
    fi
    #check if there is no partitions left
    if [[ ${#partitions_list[@]} -eq 0 && ${partition_name[i]} != swap ]]; then
      break
    elif [[ ${partition_name[i]} == another ]]; then
      read_input_text "Configure more partitions"
      [[ $OPTION != y ]] && break
    fi
  done
  pause_function
}
#}}}
#ZEN PERFORMANCE/SECURITY BASELINE {{{
# Escribe configs declarativas en el sistema instalado. Idempotente (sobrescribe).
# Objetivo: aprovechar linux-zen (BBR3, EEVDF/BORE, PREEMPT_DYNAMIC, PSI) sin
# comprometer la postura por defecto del kernel en mitigaciones de CPU.
configure_zen_tuning() {
  print_info "Aplicando baseline de tuning para linux-zen (sysctl, udev, modprobe, zram)."

  mkdir -p "${MOUNTPOINT}/etc/sysctl.d" \
           "${MOUNTPOINT}/etc/udev/rules.d" \
           "${MOUNTPOINT}/etc/modprobe.d" \
           "${MOUNTPOINT}/etc/systemd" \
           "${MOUNTPOINT}/etc/systemd/resolved.conf.d"

  # Red: BBR (zen trae BBR3) + fair queueing → mejor latencia y throughput
  cat > "${MOUNTPOINT}/etc/sysctl.d/99-zen-net.conf" <<'EOF'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_mtu_probing = 1
net.core.netdev_max_backlog = 16384
net.core.somaxconn = 8192
EOF

  # VM/FS: defaults sanos para desktop con zram presente
  cat > "${MOUNTPOINT}/etc/sysctl.d/99-zen-vm.conf" <<'EOF'
vm.swappiness = 100
vm.watermark_boost_factor = 0
vm.watermark_scale_factor = 125
vm.vfs_cache_pressure = 50
vm.dirty_bytes = 268435456
vm.dirty_background_bytes = 67108864
fs.inotify.max_user_watches = 524288
fs.inotify.max_user_instances = 8192
kernel.split_lock_mitigate = 0
EOF

  # I/O schedulers por tipo de dispositivo (multi-queue aware)
  cat > "${MOUNTPOINT}/etc/udev/rules.d/60-ioschedulers.rules" <<'EOF'
# NVMe: dejar al hardware (multi-queue nativo)
ACTION=="add|change", KERNEL=="nvme[0-9]n[0-9]", ATTR{queue/scheduler}="none"
# SSD SATA / MMC: deadline multi-queue
ACTION=="add|change", KERNEL=="sd[a-z]|mmcblk[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline"
# HDD rotacional: BFQ (fairness por proceso)
ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
EOF

  # Module tweaks: silenciar PC speaker, NVMe suspend robusto, audio sin pops
  cat > "${MOUNTPOINT}/etc/modprobe.d/zen-tuning.conf" <<'EOF'
blacklist pcspkr
blacklist snd_pcsp
options nvme_core default_ps_max_latency_us=5500
options snd_hda_intel power_save=1 power_save_controller=Y
EOF

  # ZRAM swap (zstd, mitad de RAM con tope 8G): preferible a swapfile/swap-LV
  # para no exponer claves de sesión a disco. Coexiste con swap físico si el
  # usuario lo configuró (zram con prio 100 se usa primero).
  cat > "${MOUNTPOINT}/etc/systemd/zram-generator.conf" <<'EOF'
[zram0]
zram-size = min(ram / 2, 8192)
compression-algorithm = zstd
swap-priority = 100
fs-type = swap
EOF

  # systemd-resolved: DNSSEC y DoT oportunista, resolvers públicos como fallback
  cat > "${MOUNTPOINT}/etc/systemd/resolved.conf.d/10-aui-x.conf" <<'EOF'
[Resolve]
DNSSEC=allow-downgrade
DNSOverTLS=opportunistic
Cache=yes
FallbackDNS=1.1.1.1 9.9.9.9 2606:4700:4700::1111 2620:fe::fe
EOF
}
#}}}
#INSTALL BASE SYSTEM {{{
# AUI-X pin: linux-zen (primary, BORE+BBR3+PREEMPT_DYNAMIC) + linux-lts (real fallback).
# linux plain queda fuera a propósito: rebasea al mismo ritmo que zen, no protege ante
# regresiones upstream. linux-hardened queda fuera por incompatibilidades recurrentes
# con stacks GPU propietarios y módulos DKMS.
install_base_system() {
  print_title "INSTALL BASE SYSTEM"
  print_info "Refreshing PGP keyring"

  # NTP antes de tocar firmas: evita rechazo de paquetes por reloj desincronizado en VMs/live
  timedatectl set-ntp true 2>/dev/null || true

  pacman -Sy --noconfirm archlinux-keyring

  KERNEL_PRIMARY="linux-zen"
  print_info "Kernels: linux-zen (primario, performance) + linux-lts (fallback recovery)."
  local kernels=("linux-zen" "linux-zen-headers" "linux-lts" "linux-lts-headers")

  # Microcode sólo en x86_64 (no existe para aarch64/otras)
  local ucode_pkgs=()
  [[ "$ARCHI" == "x86_64" ]] && ucode_pkgs=("intel-ucode" "amd-ucode")

  print_info "Installing base con paquetes explícitos (paquete 'base', no grupo legacy)"

  # pacstrap -K usa keyring fresco; estándar moderno
  pacstrap -K "${MOUNTPOINT}" \
    base base-devel \
    "${kernels[@]}" \
    linux-firmware "${ucode_pkgs[@]}" \
    cryptsetup lvm2 \
    networkmanager iwd \
    pipewire pipewire-pulse pipewire-alsa pipewire-jack wireplumber \
    btrfs-progs dosfstools e2fsprogs xfsprogs f2fs-tools \
    vim nano man-db man-pages \
    git sudo \
    reflector pacman-contrib \
    zram-generator \
    iputils inetutils \
    parted efibootmgr

  [[ $? -ne 0 ]] && error_msg "Installing base system to ${MOUNTPOINT} failed. Check error messages above."

  # Servicios base habilitados para primer boot
  arch_chroot "systemctl enable NetworkManager.service"
  arch_chroot "systemctl enable systemd-resolved.service"
  arch_chroot "systemctl enable systemd-timesyncd.service"
  arch_chroot "systemctl enable fstrim.timer"
  arch_chroot "systemctl enable systemd-oomd.service"
  arch_chroot "systemctl enable paccache.timer"
  arch_chroot "systemctl enable reflector.timer" 2>/dev/null || true

  # Zen performance/security baseline (sysctl, udev, modprobe, zram, resolved)
  configure_zen_tuning

  # NetworkManager: backend iwd (WiFi moderno) + DNS via systemd-resolved
  mkdir -p "${MOUNTPOINT}"/etc/NetworkManager/conf.d
  cat > "${MOUNTPOINT}"/etc/NetworkManager/conf.d/dns.conf <<'EOF'
[main]
dns=systemd-resolved
rc-manager=symlink
EOF
  cat > "${MOUNTPOINT}"/etc/NetworkManager/conf.d/wifi-backend.conf <<'EOF'
[device]
wifi.backend=iwd
EOF
  ln -sf /run/systemd/resolve/stub-resolv.conf "${MOUNTPOINT}"/etc/resolv.conf

  # Accesibilidad opcional
  if is_package_installed "espeakup"; then
    pacstrap -K "${MOUNTPOINT}" alsa-utils espeakup brltty
    arch_chroot "systemctl enable espeakup.service"
  fi
}
#}}}
