#!/bin/bash


SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
if [[ -f "$SCRIPT_DIR/lib" ]]; then
  source "$SCRIPT_DIR/lib"
else
  echo "missing file: $SCRIPT_DIR/lib"
  exit 1
fi

#ARCHLINUX INSTALL SCRIPTS MODE {{{
#SELECT KEYMAP {{{
select_keymap() {
  print_title "KEYMAP - https://wiki.archlinux.org/index.php/KEYMAP"
  local keymap
  local keymap_list=("us" "la-latin1" "es" "br-abnt2" "pt-latin1" "uk" "de-latin1" "fr-latin1" "it" "dvorak")
  PS3="$prompt1"
  print_info "Console keymap (editable post-install in /etc/vconsole.conf)."
  select keymap in "${keymap_list[@]}"; do
    if contains_element "$keymap" "${keymap_list[@]}"; then
      loadkeys "$keymap" || { print_error "Could not load keymap: $keymap"; return 1; }
      KEYMAP="$keymap"
      return 0
    else
      invalid_option
    fi
  done
}
#}}}
#LIVE EDITOR {{{
configure_live_editor() {
  EDITOR="nano"
  command -v "$EDITOR" >/dev/null 2>&1 && return 0
  pacman -Sy --noconfirm --needed "$EDITOR" ||
    { print_error "Could not install live editor: $EDITOR"; return 1; }
}
#}}}
#MIRRORLIST {{{
configure_mirrorlist() {
  print_title "MIRRORLIST - https://wiki.archlinux.org/index.php/Mirrors"
  country_code=$(curl -s --max-time 5 https://ifconfig.co/country-iso 2>/dev/null | tr -d '[:space:]')
  if [[ ${#country_code} -ne 2 ]]; then
    print_warning "Country auto-detect failed. Using global mirrors."
    country_code=""
    country_name="Global"
  else
    country_name=$(curl -s --max-time 5 "https://ifconfig.co/country" 2>/dev/null | head -1 | tr -d '\n')
    [[ -z "$country_name" ]] && country_name="$country_code"
    print_info "Detected country: ${country_name} (${country_code})"
  fi

  command -v reflector >/dev/null 2>&1 || pacman -Sy --noconfirm --needed reflector
  [[ ! -f /etc/pacman.d/mirrorlist.orig ]] && cp /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.orig

  local args=(--protocol https --age 12 --latest 20 --sort rate --save /etc/pacman.d/mirrorlist)
  [[ -n "$country_code" ]] && args=(--country "$country_code" "${args[@]}")
  reflector "${args[@]}" || print_warning "reflector failed — using current mirrorlist."

  chmod +r /etc/pacman.d/mirrorlist
  pacman -Syy >/dev/null 2>&1 || true
  print_success "Mirrorlist generated."
}
#}}}
#UMOUNT PARTITIONS {{{
umount_partitions() {
  # findmnt anchored to MOUNTPOINT (avoids /mnt-old/backup false matches). Reverse depth.
  local mp_list mp
  mapfile -t mp_list < <(findmnt -R -n -o TARGET "${MOUNTPOINT}" 2>/dev/null | tac)
  swapoff -a 2>/dev/null || true
  for mp in "${mp_list[@]}"; do
    umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null || true
  done
  vgchange -an lvm >/dev/null 2>&1 || true
  cryptsetup close cryptroot >/dev/null 2>&1 || true
  cryptsetup close crypt >/dev/null 2>&1 || true
}
#}}}
#SELECT DEVICE {{{
select_device() {
  mapfile -t devices_list < <(lsblk -d | awk '{print "/dev/" $1}' | grep -E 'sd|hd|vd|nvme|mmcblk')
  if [[ ${#devices_list[@]} -eq 0 ]]; then
    print_error "No disks detected."
    return 1
  fi
  devices_list+=("Back")
  PS3="$prompt1"
  echo -e "Attached devices:\n"
  lsblk -lnp -I 2,3,8,9,22,34,56,57,58,65,66,67,68,69,70,71,72,91,128,129,130,131,132,133,134,135,259 | awk '{print $1,$4,$6,$7}' | column -t
  echo -e "\nSelect device to partition (or 'Back' to abort):\n"
  select device in "${devices_list[@]}"; do
    if [[ "$device" == "Back" ]]; then
      return 1
    elif contains_element "${device}" "${devices_list[@]}"; then
      break
    else
      invalid_option
    fi
  done
  BOOT_MOUNTPOINT=$device
}
#}}}
#PARTITION HELPERS {{{
is_efi_system_partition() {
  local parttype parttypename
  parttype=$(lsblk -no PARTTYPE "$1" 2>/dev/null | head -1 | tr '[:upper:]' '[:lower:]')
  parttypename=$(lsblk -no PARTTYPENAME "$1" 2>/dev/null | head -1 | tr '[:upper:]' '[:lower:]')
  [[ "$parttype" == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" ]] ||
    [[ "$parttype" == "0xef" ]] ||
    [[ "$parttypename" == *"efi system"* ]]
}
#}}}
#CREATE PARTITION SCHEME {{{
create_partition_scheme() {
  LUKS=0
  LVM=0
  print_title "https://wiki.archlinux.org/index.php/Partitioning"
  print_info "Default: LUKS encryption from initial partitioning."
  print_warning "Without LUKS you cannot use fido2-unlock/keyfile-usb of fortress later."
  print_warning "Maintain Current does not create LUKS; use only if you set up encryption manually."
  partition_layouts=("LVM+LUKS (default, recommended)" "Default (NO encryption)" "LVM (NO encryption)" "Maintain Current" "Back")
  PS3="$prompt1"
  echo -e "Select partition scheme:"
  select OPT in "${partition_layouts[@]}"; do
    partition_layout=$OPT
    case "$OPT" in
      "LVM+LUKS (default, recommended)")
        create_partition && setup_luks && setup_lvm || return 1
        ;;
      "Default (NO encryption)")
        print_danger "NO encryption selected. Fortress cannot convert root/home to LUKS later."
        read_input_text "Confirm install WITHOUT encryption"
        [[ $OPTION != y ]] && continue
        create_partition || return 1
        ;;
      "LVM (NO encryption)")
        print_danger "LVM NO encryption selected. Fortress cannot convert root/home to LUKS later."
        read_input_text "Confirm install WITHOUT encryption"
        [[ $OPTION != y ]] && continue
        create_partition && setup_lvm || return 1
        ;;
      "Maintain Current")
        print_warning "Assumes you opened/mounted any existing LUKS manually."
        modprobe dm-mod
        vgscan &>/dev/null
        vgchange -ay &>/dev/null
        ;;
      "Back") return 1 ;;
      *)
        invalid_option
        continue
        ;;
    esac
    [[ -n $OPT ]] && break
  done
}
#}}}
#SETUP PARTITION{{{
create_partition() {
  umount_partitions
  apps_list=("cfdisk" "cgdisk" "fdisk" "gdisk" "parted" "Back")
  PS3="$prompt1"
  echo -e "Select partition program (or 'Back' to cancel):"
  select OPT in "${apps_list[@]}"; do
    case "$OPT" in
      "Back") return 1 ;;
      cfdisk|cgdisk|fdisk|gdisk|parted) prog="$OPT" ;;
      *) invalid_option; continue ;;
    esac
    select_device || return 1
    if [[ "$prog" == "parted" ]]; then
      parted -a opt "${device}"
    else
      "$prog" "${device}"
    fi
    break
  done
}
#}}}
#SETUP LUKS {{{
setup_luks() {
  print_title "LUKS - https://wiki.archlinux.org/index.php/LUKS"
  print_danger "\tDo not use this for boot partitions"
  mapfile -t block_list < <(lsblk -lnpo NAME,TYPE | awk '$2=="part"{print $1}')
  local luks_candidates=()
  local part
  for part in "${block_list[@]}"; do
    if is_efi_system_partition "$part"; then
      print_info "Skipping EFI System Partition for LUKS: $part"
      continue
    fi
    luks_candidates+=("$part")
  done
  block_list=("${luks_candidates[@]}")
  if [[ ${#block_list[@]} -eq 0 ]]; then
    print_error "No non-ESP physical partitions detected for LUKS."
    print_warning "Back to partitioning: create an ESP plus a separate root/LUKS partition, then 'Write'."
    pause_function
    return 1
  fi

  block_list+=("Cancel")
  PS3="$prompt1"
  echo -e "Select partition:"
  select OPT in "${block_list[@]}"; do
    # IMPORTANT: check Cancel BEFORE contains_element (Cancel is in the array).
    if [[ "$OPT" == "Cancel" ]]; then
      return 1
    elif contains_element "$OPT" "${block_list[@]}"; then
      print_danger "This will irreversibly destroy data and signatures on ${OPT}."
      printf "%s" "Type ENCRYPT to confirm LUKS2 on ${OPT}: "
      read -r luks_confirm
      [[ "$luks_confirm" == "ENCRYPT" ]] || { print_warning "LUKS cancelled."; return 1; }
      wipefs -a "$OPT" || { print_error "wipefs failed on ${OPT}."; return 1; }
      # cryptsetup 2026: argon2id capped at 512MiB to avoid OOM on low-RAM unlock;
      # urandom (not random) to avoid live-ISO entropy hang.
      cryptsetup --batch-mode --type luks2 \
        --cipher aes-xts-plain64 --key-size 512 --hash sha512 \
        --pbkdf argon2id --pbkdf-memory 524288 --pbkdf-parallel 4 --iter-time 5000 \
        --use-urandom --verify-passphrase \
        luksFormat "$OPT" \
        || { print_error "luksFormat failed. ${OPT} may have partial header."; return 1; }
      local open_args=(open --type luks)
      [[ $TRIM -eq 1 ]] && open_args+=(--allow-discards)
      # Canonical mapper name 'cryptroot' — used consistently across setup_lvm, fstab, cmdline.
      cryptsetup "${open_args[@]}" "$OPT" cryptroot \
        || { print_error "Could not open LUKS container."; return 1; }
      LUKS=1
      LUKS_DISK=$(echo "${OPT}" | sed 's/\/dev\///')
      break
    else
      invalid_option
    fi
  done
}
#}}}
#SETUP LVM {{{
setup_lvm() {
  print_title "LVM - https://wiki.archlinux.org/index.php/LVM"
  print_info "Default layout: single root LV using 100% of VG. /home stays as subdir of / (or @home subvol on btrfs)."
  if [[ $LUKS -eq 1 ]]; then
    pvcreate /dev/mapper/cryptroot || { print_error "pvcreate on /dev/mapper/cryptroot failed."; return 1; }
    vgcreate lvm /dev/mapper/cryptroot || { print_error "vgcreate lvm failed."; return 1; }
  else
    mapfile -t block_list < <(lsblk -lnpo NAME,TYPE | awk '$2=="part"{print $1}')
    local pv_candidates=()
    local part
    for part in "${block_list[@]}"; do
      if is_efi_system_partition "$part"; then
        print_info "Skipping EFI System Partition for LVM PV: $part"
        continue
      fi
      pv_candidates+=("$part")
    done
    block_list=("${pv_candidates[@]}")
    if [[ ${#block_list[@]} -eq 0 ]]; then
      print_error "No non-ESP physical partitions detected for LVM PV."
      return 1
    fi
    block_list+=("Back")
    PS3="$prompt1"
    echo -e "Select partition for LVM PV (or 'Back'):"
    select OPT in "${block_list[@]}"; do
      if [[ "$OPT" == "Back" ]]; then
        return 1
      elif contains_element "$OPT" "${block_list[@]}"; then
        pvcreate "$OPT" || { print_error "pvcreate on $OPT failed."; return 1; }
        vgcreate lvm "$OPT" || { print_error "vgcreate lvm failed."; return 1; }
        break
      else
        invalid_option
      fi
    done
  fi

  local lvm_modes=("Guided root (recommended)" "Manual" "Back")
  PS3="$prompt1"
  echo -e "Select LVM layout (or 'Back'):\n"
  select LVM_MODE in "${lvm_modes[@]}"; do
    case "$LVM_MODE" in
      "Guided root (recommended)")
        lvcreate -l 100%FREE lvm -n root \
          || { print_error "lvcreate root on VG 'lvm' failed."; return 1; }
        LVM=1
        return 0
        ;;
      "Back") return 1 ;;
      "Manual") break ;;
      *) invalid_option ;;
    esac
  done

  print_warning "Manual: last LV takes 100% free. First LV must be named 'root'."
  printf "%s" "Number of LVs [ex: 2 for root+home]: "
  read -r number_partitions
  i=1
  while [[ $i -le $number_partitions ]]; do
    printf "%s" "Enter $iª LV name (first must be 'root'; e.g. root, home, data): "
    read -r partition_name
    if [[ $i -eq 1 && "$partition_name" != "root" ]]; then
      print_error "First LV must be named 'root'."
      return 1
    fi
    if [[ $i -eq $number_partitions ]]; then
      lvcreate -l 100%FREE lvm -n "${partition_name}"
    else
      local lv_min=1
      [[ "$partition_name" == "root" ]] && lv_min=30
      read_size "Size of ${i}º LV (${partition_name})" "30G" "$lv_min" partition_size
      lvcreate -L "${partition_size}" lvm -n "${partition_name}"
    fi
    i=$((i + 1))
  done
  LVM=1
}
#}}}
#SELECT|FORMAT PARTITIONS {{{
format_partitions() {
  print_title "https://wiki.archlinux.org/index.php/File_Systems"
  print_danger "\tAll data on the ROOT partition will be LOST."
  [[ $LVM -eq 1 ]] && print_info "LVM mode: root/home picked from /dev/mapper/lvm-*. Physical parts only shown where relevant (ESP)."
  i=0

  # TYPE=part → /dev/sda1; TYPE=lvm → /dev/mapper/lvm-root. Excludes disk/crypt backing.
  mapfile -t partitions_list < <(lsblk -lnpo NAME,TYPE | awk '$2=="part" || $2=="lvm" {print $1}')

  if [[ ${#partitions_list[@]} -eq 0 ]]; then
    print_error "No partitions or LVs detected. Back to partitioning."
    return 1
  fi

  role_partitions=()

  # NOTE: swap removed on purpose. ZRAM covers it (see configure_zen_tuning).
  # Hibernation-to-disk not supported by this installer; add post-install if needed.
  if [[ $UEFI -eq 1 ]]; then
    partition_name=("root" "EFI" "another")
  else
    partition_name=("root" "another")
  fi

  select_filesystem() {
    # btrfs/ext4 only. Other FSes (xfs/zfs/bcachefs) excluded as too niche or unstable for an installer.
    filesystems_list=("btrfs" "ext4" "Back")
    PS3="$prompt1"
    print_info "btrfs (recommended): snapshots, zstd compress, subvols @/@home/@var_log/@snapshots."
    print_info "ext4: conservative, max compatibility. No snapshots/compression."
    echo -e "Select filesystem (or 'Back'):\n"
    select filesystem in "${filesystems_list[@]}"; do
      if [[ "$filesystem" == "Back" ]]; then
        filesystem=""
        return 1
      elif contains_element "${filesystem}" "${filesystems_list[@]}"; then
        return 0
      else
        invalid_option
      fi
    done
  }

  is_luks_backing_partition() {
    [[ $LUKS -eq 1 && "$1" == "/dev/${LUKS_DISK}" ]]
  }

  has_lsblk_children() {
    [[ "$(lsblk -ln "$1" 2>/dev/null | wc -l)" -gt 1 ]]
  }

  is_lvm_lv() {
    [[ "$1" == /dev/mapper/lvm-* ]]
  }

  is_physical_leaf_partition() {
    [[ "$1" != /dev/mapper/* ]] && ! is_luks_backing_partition "$1" && ! has_lsblk_children "$1"
  }

  is_installable_root_partition() {
    ! is_luks_backing_partition "$1" && ! is_efi_system_partition "$1"
  }

  build_partition_candidates() {
    local role="$1"
    local partition_candidate
    role_partitions=()
    for partition_candidate in "${partitions_list[@]}"; do
      case "$role" in
        root)
          if [[ $LVM -eq 1 ]]; then
            [[ "$partition_candidate" == "/dev/mapper/lvm-root" ]] && role_partitions+=("$partition_candidate")
          elif is_installable_root_partition "$partition_candidate"; then
            role_partitions+=("$partition_candidate")
          fi
          ;;
        EFI)
          is_physical_leaf_partition "$partition_candidate" && role_partitions+=("$partition_candidate")
          ;;
        another)
          if [[ $LVM -eq 1 ]]; then
            is_lvm_lv "$partition_candidate" &&
              [[ "$partition_candidate" != "/dev/mapper/lvm-root" ]] &&
              role_partitions+=("$partition_candidate")
          elif is_installable_root_partition "$partition_candidate"; then
            role_partitions+=("$partition_candidate")
          fi
          ;;
      esac
    done
  }

  print_partition_hint() {
    case "$1" in
      root)
        [[ $LVM -eq 1 ]] && print_info "Root (/): pick /dev/mapper/lvm-root."
        ;;
      EFI)
        print_info "EFI: pick the unencrypted ESP (small FAT32). Will mount at /boot for systemd-boot."
        ;;
      another)
        [[ $LVM -eq 1 ]] && print_info "Extra: pick /dev/mapper/lvm-home to mount as /home."
        ;;
    esac
  }

  disable_partition() {
    local selected_partition="$1"
    local remaining_partitions=()
    local current_partition
    for current_partition in "${partitions_list[@]}"; do
      [[ "$current_partition" != "$selected_partition" ]] && remaining_partitions+=("$current_partition")
    done
    partitions_list=("${remaining_partitions[@]}")
      [[ ${partition_name[i]} != another ]] && i=$((i + 1))
  }

  # Btrfs subvol layout for root: @ (/), @home, @var_log, @snapshots.
  # Enables snapper rollback and isolates /var/log from root snapshots.
  # mount opts: compress=zstd transparent (~30-50% savings on logs/configs).
  _btrfs_setup_root() {
    local dev="$1" mnt="$2"
    local mount_opts="noatime,compress=zstd,space_cache=v2"
    [[ $TRIM -eq 1 ]] && mount_opts+=",discard=async"

    print_info "Btrfs root: creating subvols @, @home, @var_log, @snapshots."
    mount -t btrfs "$dev" "$mnt" || { print_error "Initial btrfs mount on $dev failed."; return 1; }
    btrfs subvolume create "$mnt/@"          || { print_error "subvol @ failed.";          umount "$mnt"; return 1; }
    btrfs subvolume create "$mnt/@home"      || { print_error "subvol @home failed.";      umount "$mnt"; return 1; }
    btrfs subvolume create "$mnt/@var_log"   || { print_error "subvol @var_log failed.";   umount "$mnt"; return 1; }
    btrfs subvolume create "$mnt/@snapshots" || { print_error "subvol @snapshots failed."; umount "$mnt"; return 1; }
    umount "$mnt"

    mount -t btrfs -o "subvol=@,${mount_opts}" "$dev" "$mnt" \
      || { print_error "Remount subvol=@ failed."; return 1; }
    mkdir -p "$mnt/home" "$mnt/var/log" "$mnt/.snapshots"
    mount -t btrfs -o "subvol=@home,${mount_opts}" "$dev" "$mnt/home" ||
      { print_error "Mount subvol=@home failed."; umount -R "$mnt" 2>/dev/null || true; return 1; }
    mount -t btrfs -o "subvol=@var_log,${mount_opts}" "$dev" "$mnt/var/log" ||
      { print_error "Mount subvol=@var_log failed."; umount -R "$mnt" 2>/dev/null || true; return 1; }
    mount -t btrfs -o "subvol=@snapshots,${mount_opts}" "$dev" "$mnt/.snapshots" ||
      { print_error "Mount subvol=@snapshots failed."; umount -R "$mnt" 2>/dev/null || true; return 1; }

    print_success "Btrfs subvols mounted: @=/  @home=/home  @var_log=/var/log  @snapshots=/.snapshots"
  }

  format_partition() {
    local dev="$1"
    local target="$2"
    local requested_fs="${3:-}"
    local selected_fs
    read_input_text "Confirm format $1 partition"
    if [[ $OPTION == y ]]; then
      if [[ -n "$requested_fs" ]]; then
        selected_fs="$requested_fs"
      else
        select_filesystem || return 1
        selected_fs="$filesystem"
      fi
      filesystem="$selected_fs"
      mkfs."${filesystem}" "$dev" \
        $([[ ${filesystem} == btrfs ]] && echo "-f") \
        $([[ ${filesystem} == vfat ]] && echo "-F32") \
        $([[ $TRIM -eq 1 && ${filesystem} == ext4 ]] && echo "-E discard") ||
        { print_error "mkfs.${filesystem} failed on ${dev}."; return 1; }
      [[ "${filesystem}" != "btrfs" ]] && fsck "$dev" || true
      mkdir -p "$target" || { print_error "Could not create mountpoint ${target}."; return 1; }
      if [[ "${filesystem}" == "btrfs" && "$target" == "${MOUNTPOINT}" ]]; then
        _btrfs_setup_root "$dev" "$target" || return 1
      else
        mount -t "${filesystem}" "$dev" "$target" ||
          { print_error "Mount ${dev} on ${target} failed."; return 1; }
      fi
      disable_partition "$dev"
      return 0
    fi
    print_warning "Format cancelled for ${dev}."
    return 1
  }

  check_mountpoint() {
    if findmnt -rn --mountpoint "$2" >/dev/null 2>&1; then
      echo "Successfully mounted"
      disable_partition "$1"
      return 0
    else
      echo "WARNING: Not Successfully mounted"
      return 1
    fi
  }

  set_efi_partition() {
    EFI_MOUNTPOINT="/boot"
    print_info "UEFI: ESP mounted at /boot for systemd-boot."
  }

  while true; do
    PS3="$prompt1"
    build_partition_candidates "${partition_name[i]}"
    if [[ ${#role_partitions[@]} -eq 0 ]]; then
      if [[ ${partition_name[i]} == another ]]; then
        print_info "No remaining safe partitions/LVs to mount as extra."
        break
      fi
      print_error "No safe candidates for '${partition_name[i]}'. Check partitioning/LVM."
      return 1
    fi
    print_partition_hint "${partition_name[i]}"
    echo -e "Select ${BYellow}${partition_name[i]}${Reset} partition:\n"
    select partition in "${role_partitions[@]}"; do
      if contains_element "${partition}" "${partitions_list[@]}"; then
        case ${partition_name[i]} in
        root)
          ROOT_PART=$(echo "${partition}" | sed 's/\/dev\/mapper\///' | sed 's/\/dev\///')
          ROOT_MOUNTPOINT=${partition}
          format_partition "${partition}" "${MOUNTPOINT}" || continue
          ;;
        EFI)
          set_efi_partition
          read_input_text "Format ${partition} partition"
          if [[ $OPTION == y ]]; then
            format_partition "${partition}" "${MOUNTPOINT}${EFI_MOUNTPOINT}" vfat || continue
          else
            mkdir -p "${MOUNTPOINT}${EFI_MOUNTPOINT}"
            mount -t vfat "${partition}" "${MOUNTPOINT}${EFI_MOUNTPOINT}" ||
              { print_error "Mount ${partition} on ${MOUNTPOINT}${EFI_MOUNTPOINT} failed."; continue; }
            check_mountpoint "${partition}" "${MOUNTPOINT}${EFI_MOUNTPOINT}" || continue
          fi
          ;;
        another)
          if [[ "$partition" == "/dev/mapper/lvm-home" ]]; then
            printf "%s" "Mountpoint [default: /home]: "
          else
            printf "%s" "Mountpoint [e.g. /home]: "
          fi
          read -r directory
          [[ -z "$directory" && "$partition" == "/dev/mapper/lvm-home" ]] && directory="/home"
          if [[ ! "$directory" =~ ^/[^[:space:]]*$ || "$directory" == "/" || "$directory" == "$EFI_MOUNTPOINT" ]]; then
            print_warning "Invalid mountpoint '${directory}'. Use an absolute path like /home or /data."
            continue
          fi
          select_filesystem || continue
          read_input_text "Format ${partition} partition"
          if [[ $OPTION == y ]]; then
            format_partition "${partition}" "${MOUNTPOINT}${directory}" "${filesystem}" || continue
          else
            read_input_text "Confirm fs=""${filesystem}"" part=""${partition}"" dir=""${directory}"""
            if [[ $OPTION == y ]]; then
              mkdir -p "${MOUNTPOINT}${directory}"
              mount -t "${filesystem}" "${partition}" "${MOUNTPOINT}""${directory}" ||
                { print_error "Mount ${partition} on ${MOUNTPOINT}${directory} failed."; continue; }
              check_mountpoint "${partition}" "${MOUNTPOINT}${directory}" || continue
            fi
          fi
          ;;
        esac
        break
      else
        invalid_option
      fi
    done
    if [[ ${#partitions_list[@]} -eq 0 ]]; then
      break
    elif [[ ${partition_name[i]} == another ]]; then
      read_input_text "Configure more partitions"
      [[ $OPTION != y ]] && break
    fi
  done
  pause_function
}
#}}}
#ZEN PERFORMANCE/SECURITY BASELINE {{{
# Idempotent declarative configs. Leverages linux-zen (BBR3, BORE, PSI) without
# weakening kernel CPU-mitigation defaults.
configure_zen_tuning() {
  print_info "Applying linux-zen baseline (sysctl, udev, modprobe, zram, nftables)."

  mkdir -p "${MOUNTPOINT}/etc/sysctl.d" \
           "${MOUNTPOINT}/etc/udev/rules.d" \
           "${MOUNTPOINT}/etc/modprobe.d" \
           "${MOUNTPOINT}/etc/systemd" \
           "${MOUNTPOINT}/etc/systemd/resolved.conf.d"

  # Net: BBR + fq + hardening + IPv6 privacy (RFC4941).
  cat > "${MOUNTPOINT}/etc/sysctl.d/99-zen-net.conf" <<'EOF'
# --- Performance ---
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_mtu_probing = 1
net.core.netdev_max_backlog = 16384
net.core.somaxconn = 8192

# --- IPv4 hardening ---
net.ipv4.tcp_rfc1337 = 1
net.ipv4.tcp_syncookies = 1
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv4.conf.all.log_martians = 1

# --- IPv6 privacy + hardening (use_tempaddr=2 = RFC4941 temp addresses) ---
net.ipv6.conf.all.use_tempaddr = 2
net.ipv6.conf.default.use_tempaddr = 2
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0
net.ipv6.conf.all.accept_source_route = 0
net.ipv6.conf.default.accept_source_route = 0
EOF

  # VM/FS: zram-only tuning. swappiness=180 + page-cluster=0 are Fedora defaults for zram.
  cat > "${MOUNTPOINT}/etc/sysctl.d/99-zen-vm.conf" <<'EOF'
vm.swappiness = 180
vm.page-cluster = 0
vm.watermark_boost_factor = 0
vm.watermark_scale_factor = 125
vm.vfs_cache_pressure = 50
vm.dirty_bytes = 268435456
vm.dirty_background_bytes = 67108864
fs.inotify.max_user_watches = 524288
fs.inotify.max_user_instances = 8192
kernel.split_lock_mitigate = 0
EOF

  # I/O schedulers per device class (multi-queue aware).
  cat > "${MOUNTPOINT}/etc/udev/rules.d/60-ioschedulers.rules" <<'EOF'
ACTION=="add|change", KERNEL=="nvme[0-9]n[0-9]", ATTR{queue/scheduler}="none"
ACTION=="add|change", KERNEL=="sd[a-z]|mmcblk[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline"
ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
EOF

  # Module tweaks. Note: nvme_core latency lives in cmdline (built-in module, modprobe.d ignored).
  cat > "${MOUNTPOINT}/etc/modprobe.d/zen-tuning.conf" <<'EOF'
blacklist pcspkr
blacklist snd_pcsp
options snd_hda_intel power_save=1 power_save_controller=Y
EOF

  # ZRAM swap (zstd, ½ RAM capped at 8G). Avoids writing memory contents to disk.
  cat > "${MOUNTPOINT}/etc/systemd/zram-generator.conf" <<'EOF'
[zram0]
zram-size = min(ram / 2, 8192)
compression-algorithm = zstd
swap-priority = 100
fs-type = swap
EOF

  # systemd-resolved: DNSSEC + opportunistic DoT + public fallback resolvers.
  cat > "${MOUNTPOINT}/etc/systemd/resolved.conf.d/10-aui-x.conf" <<'EOF'
[Resolve]
DNSSEC=allow-downgrade
DNSOverTLS=opportunistic
Cache=yes
FallbackDNS=1.1.1.1 9.9.9.9 2606:4700:4700::1111 2620:fe::fe
EOF

  # nftables baseline: default-drop input, allow loopback/established/ICMP/DHCPv6.
  # Open ports by editing /etc/nftables.conf then: systemctl reload nftables
  cat > "${MOUNTPOINT}/etc/nftables.conf" <<'EOF'
#!/usr/bin/nft -f
# aui-x baseline firewall: default-drop input, allow output.
# https://wiki.archlinux.org/title/Nftables

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        # loopback
        iif lo accept
        iif != lo ip daddr 127.0.0.0/8 drop
        iif != lo ip6 daddr ::1 drop

        # conntrack: accept replies to outbound traffic
        ct state established,related accept
        ct state invalid drop

        # Essential ICMP (PMTUD and basic diagnostics)
        ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } accept
        ip6 nexthdr icmpv6 icmpv6 type {
            destination-unreachable, packet-too-big, time-exceeded, parameter-problem,
            echo-request, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert,
            mld-listener-query, mld-listener-report, mld-listener-reduction
        } accept

        # DHCPv6 client (needed for IPv6 over DHCP)
        udp dport 546 ct state new accept

        # SSH: COMENTADO por defecto. Descomenta si necesitas SSH inbound:
        # tcp dport 22 ct state new limit rate 5/minute accept

        # log + drop por defecto (descomenta para debug)
        # log prefix "[nft drop] " counter drop

        counter drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
EOF
  chmod 0644 "${MOUNTPOINT}/etc/nftables.conf"
}
#}}}
#INSTALL BASE SYSTEM {{{
# Pin: linux-zen (BORE+BBR3+PREEMPT_DYNAMIC) + linux-lts (real fallback).
# Excluded: linux plain (no fallback value vs zen), linux-hardened (GPU/DKMS issues).
install_base_system() {
  print_title "INSTALL BASE SYSTEM"
  print_info "Refreshing PGP keyring"

  # NTP first to avoid signature rejection from clock skew (VMs/live ISO).
  timedatectl set-ntp true 2>/dev/null || true
  pacman -Sy --noconfirm archlinux-keyring

  KERNEL_PRIMARY="linux-zen"
  print_info "Kernels: linux-zen (primary) + linux-lts (fallback)."
  local kernels=("linux-zen" "linux-zen-headers" "linux-lts" "linux-lts-headers")

  # Microcode is x86_64 only.
  local ucode_pkgs=()
  [[ "$ARCHI" == "x86_64" ]] && ucode_pkgs=("intel-ucode" "amd-ucode")

  print_info "Running pacstrap (base package, not legacy group)."

  pacstrap -K "${MOUNTPOINT}" \
    base base-devel \
    "${kernels[@]}" \
    linux-firmware "${ucode_pkgs[@]}" \
    cryptsetup lvm2 \
    networkmanager iwd \
    pipewire pipewire-pulse pipewire-alsa pipewire-jack wireplumber \
    btrfs-progs dosfstools e2fsprogs \
    vim nano man-db man-pages \
    git sudo \
    reflector pacman-contrib \
    zram-generator \
    nftables \
    iputils inetutils \
    parted efibootmgr

  if [[ $? -ne 0 ]]; then
    print_error "pacstrap failed. Common causes: network down, slow/corrupt mirror, no space on /."
    print_warning "Partitions remain mounted — retry Initial Setup (mirrors) then this step."
    return 1
  fi

  arch_chroot "systemctl enable NetworkManager.service"
  arch_chroot "systemctl enable systemd-resolved.service"
  arch_chroot "systemctl enable systemd-timesyncd.service"
  arch_chroot "systemctl enable fstrim.timer"
  arch_chroot "systemctl enable systemd-oomd.service"
  arch_chroot "systemctl enable paccache.timer"
  arch_chroot "systemctl enable reflector.timer" 2>/dev/null || true
  arch_chroot "systemctl enable nftables.service"

  configure_zen_tuning

  # NetworkManager: iwd backend + systemd-resolved DNS.
  mkdir -p "${MOUNTPOINT}"/etc/NetworkManager/conf.d
  cat > "${MOUNTPOINT}"/etc/NetworkManager/conf.d/dns.conf <<'EOF'
[main]
dns=systemd-resolved
rc-manager=symlink
EOF
  cat > "${MOUNTPOINT}"/etc/NetworkManager/conf.d/wifi-backend.conf <<'EOF'
[device]
wifi.backend=iwd
EOF
  ln -sf /run/systemd/resolve/stub-resolv.conf "${MOUNTPOINT}"/etc/resolv.conf

  if is_package_installed "espeakup"; then
    pacstrap -K "${MOUNTPOINT}" alsa-utils espeakup brltty
    arch_chroot "systemctl enable espeakup.service"
  fi
}
#}}}
#CONFIGURE KEYMAP {{{
configure_keymap() {
  echo "KEYMAP=$KEYMAP" >"${MOUNTPOINT}"/etc/vconsole.conf
}
#}}}
#REQUIRE_BASE_INSTALLED {{{
# Guard for steps that touch /mnt/etc. Fails clearly when run out of order.
require_base_installed() {
  local step_name="${1:-This step}"
  if [[ ! -d "${MOUNTPOINT}/etc" ]] || [[ ! -f "${MOUNTPOINT}/etc/pacman.conf" ]]; then
    print_error "${step_name} requires base system installed at ${MOUNTPOINT}."
    print_warning "Run step 3 (Install Base System) first."
    return 1
  fi
  return 0
}
#}}}
#CONFIGURE FSTAB {{{
configure_fstab() {
  print_title "FSTAB - https://wiki.archlinux.org/index.php/Fstab"
  require_base_installed "Configure Fstab" || return 1
  # Auto: PARTUUID on UEFI / UUID on BIOS. Both survive reformats and disk reordering;
  # DEV (/dev/sdaN) is fragile against USB hotplug.
  if [[ ! -f ${MOUNTPOINT}/etc/fstab.aui ]]; then
    cp "${MOUNTPOINT}"/etc/fstab "${MOUNTPOINT}"/etc/fstab.aui
  else
    cp "${MOUNTPOINT}"/etc/fstab.aui "${MOUNTPOINT}"/etc/fstab
  fi

  if [[ $UEFI -eq 1 ]]; then
    print_info "UEFI → fstab using PARTUUID."
    genfstab -t PARTUUID -p "${MOUNTPOINT}" >>"${MOUNTPOINT}"/etc/fstab \
      || { print_error "genfstab -t PARTUUID failed. Is / mounted at ${MOUNTPOINT}?"; return 1; }
    fstab="PARTUUID"
  else
    print_info "BIOS → fstab using UUID."
    genfstab -U -p "${MOUNTPOINT}" >>"${MOUNTPOINT}"/etc/fstab \
      || { print_error "genfstab -U failed. Is / mounted at ${MOUNTPOINT}?"; return 1; }
    fstab="UUID"
  fi

  print_success "/etc/fstab generated. Review: nano ${MOUNTPOINT}/etc/fstab"
}
#}}}
#CONFIGURE HOSTNAME {{{
configure_hostname() {
  print_title "HOSTNAME - https://wiki.archlinux.org/index.php/HOSTNAME"
  require_base_installed "Configure Hostname" || return 1
  print_info "RFC1123 hostname: lowercase/digits/hyphen, no leading/trailing hyphen, max 63 chars."
  while true; do
    printf "%s" "Hostname [e.g. arch-laptop]: "
    read -r host_name
    if [[ "$host_name" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
      break
    fi
    print_warning "Invalid hostname: '$host_name'."
  done

  echo "$host_name" >"${MOUNTPOINT}"/etc/hostname
  if [[ ! -f ${MOUNTPOINT}/etc/hosts.aui ]]; then
    cp "${MOUNTPOINT}"/etc/hosts "${MOUNTPOINT}"/etc/hosts.aui
  else
    cp "${MOUNTPOINT}"/etc/hosts.aui "${MOUNTPOINT}"/etc/hosts
  fi
  # host_name validated: only [a-z0-9-] → safe in sed without escaping.
  arch_chroot "sed -i '/127.0.0.1/s/\$/ ${host_name}/' /etc/hosts"
  arch_chroot "sed -i '/::1/s/\$/ ${host_name}/' /etc/hosts"
}
#}}}
#CONFIGURE TIMEZONE {{{
configure_timezone() {
  print_title "TIMEZONE - https://wiki.archlinux.org/index.php/Timezone"
  require_base_installed "Configure Timezone" || return 1
  print_info "Time is determined by Time value, Time standard, Time Zone, and DST."
  OPTION=n
  while [[ $OPTION != y ]]; do
    settimezone
    read_input_text "Confirm timezone (${ZONE}/${SUBZONE})"
  done
  arch_chroot "ln -sf /usr/share/zoneinfo/${ZONE}/${SUBZONE} /etc/localtime"
  arch_chroot "sed -i '/#NTP=/d' /etc/systemd/timesyncd.conf"
  arch_chroot "sed -i 's/#Fallback//' /etc/systemd/timesyncd.conf"
  arch_chroot "echo \"FallbackNTP=0.pool.ntp.org 1.pool.ntp.org 0.fr.pool.ntp.org\" >> /etc/systemd/timesyncd.conf"
  arch_chroot "systemctl enable systemd-timesyncd.service"
}
#}}}
#CONFIGURE HARDWARECLOCK {{{
configure_hardwareclock() {
  print_title "HARDWARE CLOCK TIME - https://wiki.archlinux.org/index.php/Internationalization"
  require_base_installed "Configure Hardware Clock" || return 1
  print_info "Set the hardware clock mode uniformly across OSes on this machine. Stored in /etc/adjtime."
  hwclock_list=('UTC' 'Localtime')
  PS3="$prompt1"
  select OPT in "${hwclock_list[@]}"; do
    case "$REPLY" in
    1)
      arch_chroot "hwclock --systohc --utc"
      ;;
    2)
      arch_chroot "hwclock --systohc --localtime"
      ;;
    *) invalid_option ;;
    esac
    [[ -n $OPT ]] && break
  done
  hwclock=$OPT
}
