#!/bin/bash

if [[ -n "${AUI_LIB_LOADED:-}" ]]; then
  return 0
fi
AUI_LIB_LOADED=1

AUI_LIB_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AUI_LIB_DIR="$AUI_LIB_ROOT/libs"

if [[ ! -d "$AUI_LIB_DIR" ]]; then
  echo "ERROR: missing $AUI_LIB_DIR" >&2
  return 1
fi

# shellcheck source=libs/ui.sh
source "$AUI_LIB_DIR/ui.sh"
# shellcheck source=libs/system.sh
source "$AUI_LIB_DIR/system.sh"
# shellcheck source=libs/storage.sh
source "$AUI_LIB_DIR/storage.sh"
# shellcheck source=libs/install.sh
source "$AUI_LIB_DIR/install.sh"
# shellcheck source=libs/setup.sh
source "$AUI_LIB_DIR/setup.sh"
